---
import type { ArtProductType } from '../../utils/artLibrary';

interface Props {
  product: ArtProductType;
}

const { product } = Astro.props;
---

<div data-art-picker-root data-product={product} class="space-y-3">
  <div role="tablist" aria-label="Origem da arte" class="grid grid-cols-2 gap-2 rounded-xl border border-line bg-canvas p-1">
    <button
      type="button"
      role="tab"
      aria-selected="true"
      data-art-mode="upload"
      class="min-h-10 rounded-lg bg-surface px-3 text-xs font-semibold text-ink shadow-sm transition-colors"
    >
      Enviar minha imagem
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-art-mode="library"
      class="min-h-10 rounded-lg px-3 text-xs font-semibold text-ink-secondary hover:text-ink transition-colors"
    >
      Escolher da Biblioteca
    </button>
  </div>

  <div data-art-panel="upload">
    <slot name="upload" />
  </div>

  <div data-art-panel="library" hidden class="space-y-3 rounded-xl border border-line bg-canvas/70 p-3">
    <div class="space-y-2">
      <input
        type="search"
        data-art-search
        aria-label="Pesquisar artes na biblioteca"
        placeholder="Buscar por código ou título..."
        class="w-full rounded-lg border border-control bg-canvas px-3 py-2 text-xs text-ink focus:border-accent focus:outline-none"
      />
      <div data-art-categories class="flex flex-wrap gap-1.5"></div>
    </div>

    <div data-art-grid class="grid max-h-72 grid-cols-2 gap-2 overflow-y-auto pr-0.5 sm:grid-cols-3"></div>

    <p data-art-picker-status role="status" class="text-xs text-ink-secondary"></p>

    <button
      type="button"
      data-art-load-more
      hidden
      class="w-full min-h-10 rounded-lg border border-control bg-surface text-xs font-semibold text-ink-secondary hover:border-accent hover:text-accent [&[hidden]]:hidden"
    >
      Carregar mais artes
    </button>
  </div>
</div>

