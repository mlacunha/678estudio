---
import { DEFAULT_MOBILE_STEPS, type MobileStepMeta } from '../../scripts/customizerMobileSteps';

interface Props {
  mode: 'tabs' | 'bar';
  steps?: MobileStepMeta[];
}

const { mode, steps = DEFAULT_MOBILE_STEPS } = Astro.props;
---

{mode === 'tabs' ? (
  <div
    role="tablist"
    aria-label="Etapas da personalização"
    class="grid grid-cols-3 gap-1.5 rounded-xl border border-line bg-canvas p-1 lg:hidden"
  >
    {steps.map((step, index) => (
      <button
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        data-mobile-step-tab={step.id}
        class:list={[
          'min-h-11 rounded-lg border px-2 text-xs font-semibold transition-colors',
          index === 0
            ? 'border-accent bg-surface text-ink shadow-sm'
            : 'border-transparent text-ink-secondary hover:text-ink',
        ]}
      >
        {step.label}
      </button>
    ))}
  </div>
) : (
  <div
    data-mobile-bottom-bar
    class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 pt-2.5 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-lg backdrop-blur-md lg:hidden"
  >
    <div class="mx-auto flex max-w-xl items-center gap-2.5">
      <button
        type="button"
        data-mobile-prev
        hidden
        class="min-h-11 shrink-0 rounded-lg border border-control bg-canvas px-4 text-xs font-semibold text-ink-secondary hover:border-accent [&[hidden]]:hidden"
      >
        ← Arte
      </button>
      <div class="min-w-0 flex-1 text-xs text-ink-secondary truncate" data-mobile-bar-status>
        Personalização livre
      </div>
      <button
        type="button"
        data-mobile-next
        class="min-h-11 shrink-0 rounded-lg bg-action px-4 text-xs font-semibold text-on-action hover:bg-action-hover"
      >
        Ajustes →
      </button>
    </div>
  </div>
)}

<style is:global>
  @media (max-width: 1023px) {
    [data-customizer-mobile-root] input[type='range'] {
      min-height: 44px;
    }

    [data-customizer-mobile-root][data-keyboard-open='true'] .customizer-preview {
      position: static;
    }
  }

  @media (max-width: 1023px) and (max-height: 500px) {
    [data-customizer-mobile-root] .customizer-preview {
      position: static;
    }

    [data-customizer-mobile-root] [data-mobile-bottom-bar] {
      position: static;
      margin-top: 1rem;
      border-radius: 0.75rem;
      border: 1px solid var(--color-line, #e5e0d8);
    }
  }
</style>
