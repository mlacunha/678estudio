---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MUG_PRINT_DIMENSIONS, MUG_PRINT_WIDTHS } from '../../utils/customizer';
import type { Product } from '../../types/catalog';
import ArtLibraryPicker from './ArtLibraryPicker.astro';
import StudioPublication from './StudioPublication.astro';

interface Props { studioProducts?: Product[] }
const { studioProducts } = Astro.props;
const defaultMeasure = `${MUG_PRINT_DIMENSIONS.widthCm} × ${MUG_PRINT_DIMENSIONS.heightCm} cm`;
---

<BaseLayout
  title={studioProducts ? 'Mockup de Caneca | Estúdio de Imagens' : 'Personalizador 3D de Canecas | 678 Estudio'}
  description="Personalize sua caneca de cerâmica branca em 3D. Escolha a área de impressão, gire em 360° e solicite orçamento pelo WhatsApp."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">

    <!-- Breadcrumb e Título -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div>
        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-accent font-semibold mb-1">
          <span>Simulador Interativo</span>
          <span>•</span>
          <span>Cerâmica Premium 325ml</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-light text-ink">
          {studioProducts ? 'Estúdio de Imagens · Mockup de Caneca' : <>Personalizador <span class="font-normal text-accent">3D de Caneca</span></>}
        </h1>
        <p class="mt-1 text-xs sm:text-sm text-ink-muted">
          Arraste para girar em 360°. Escolha a área de impressão, carregue sua arte e ajuste o enquadramento.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={studioProducts ? '/admin/estudio' : '/#canecas'}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-control hover:border-ink-muted bg-surface text-ink-secondary text-xs font-medium motion-safe:transition-colors"
        >
          <span>{studioProducts ? 'Voltar ao Estúdio' : 'Voltar ao Catálogo'}</span>
        </a>
      </div>
    </div>

    <!-- Layout Grid: 3D Canvas + Controles -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-x-8 items-start">

      <!-- Coluna da Esquerda: Visualizador 3D Three.js -->
      <div class="customizer-preview min-w-0 lg:col-span-7 lg:row-start-1">
        <div class="relative w-full aspect-[16/11] bg-surface rounded-2xl border border-line overflow-hidden">
          <canvas id="mug-3d-canvas" tabindex="0" aria-label="Prévia da caneca. Use as setas do teclado para girar." class="w-full h-full touch-pan-y cursor-grab active:cursor-grabbing block focus-visible:outline-offset-[-3px]"></canvas>
          <p id="mug-webgl-status" hidden role="status" class="absolute inset-0 grid place-items-center bg-surface p-5 text-center text-sm text-ink-secondary [&[hidden]]:hidden">
            A visualização 3D está indisponível neste navegador. Confira a estampa no mapa plano abaixo.
          </p>

          <!-- Indicador de Interação 360 -->
          <div class="absolute top-4 left-4 pointer-events-none flex items-center gap-2 px-3 py-1.5 rounded-full bg-media-badge/95 backdrop-blur-md text-[11px] font-medium text-on-media">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Arraste para girar 360°</span>
          </div>

          <!-- Badge Modelo Base -->
          <div class="absolute top-4 right-4 pointer-events-none px-2.5 py-1 rounded text-[10px] uppercase tracking-wider font-semibold bg-media-badge/95 text-on-media">
            Área <span data-mug-measure>{defaultMeasure}</span>
          </div>
        </div>

      </div>

        <!-- Miniatura da área plana selecionada -->
        <div class="min-w-0 order-last lg:order-none lg:col-span-7 lg:col-start-1 lg:row-start-2 p-4 rounded-xl bg-surface/60 border border-line">
          <div class="flex flex-wrap items-center justify-between gap-1 mb-2">
            <span class="text-xs font-semibold text-ink-secondary uppercase tracking-wider">
              Mapa Planificado da Estampa (<span data-mug-measure>{defaultMeasure}</span>)
            </span>
          </div>
          <div class="w-full bg-canvas rounded-lg overflow-hidden border border-line">
            <canvas id="mug-texture-canvas" width={MUG_PRINT_DIMENSIONS.widthCm * 100} height={MUG_PRINT_DIMENSIONS.heightCm * 100} class="block w-full h-auto"></canvas>
          </div>
        </div>

      <!-- Coluna da Direita: Controles de Personalização -->
      <div class="min-w-0 lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:row-span-2 flex flex-col gap-4">
        <div class="p-4 sm:p-6 rounded-2xl bg-surface border border-line space-y-4 sm:space-y-5">
          <h2 class="text-base font-semibold text-ink pb-3 border-b border-line">
            Ajustes de Personalização
          </h2>

          <fieldset>
            <legend class="mb-2 text-xs font-medium uppercase tracking-wider text-ink-muted">1. Área de impressão</legend>
            <div class="grid grid-cols-3 gap-2">
              {MUG_PRINT_WIDTHS.map(width => (
                <label class="relative min-w-0 cursor-pointer">
                  <input type="radio" name="mug-print-width" value={width} checked={width === MUG_PRINT_DIMENSIONS.widthCm} class="peer sr-only" />
                  <span class="flex min-h-11 items-center justify-center whitespace-nowrap rounded-md border border-control px-1 text-xs font-semibold text-ink-secondary hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    {width} × {MUG_PRINT_DIMENSIONS.heightCm} cm
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Upload de Imagem ou Biblioteca de Artes -->
          <div>
            <span class="block text-xs uppercase tracking-wider text-ink-muted font-medium mb-2">
              2. Arte da Caneca
            </span>
            {studioProducts ? (
              <div class="flex items-center gap-3">
                <label class="cursor-pointer flex-1 min-h-11 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-surface-raised hover:bg-surface-hover border border-control text-ink-secondary text-xs font-semibold focus-within:outline focus-within:outline-2 focus-within:outline-accent">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                  </svg>
                  <span>Selecionar Arquivo (PNG ou JPG)</span>
                  <input type="file" id="input-upload-art" accept="image/*" class="sr-only" />
                </label>
              </div>
            ) : (
              <ArtLibraryPicker product="caneca">
                <div slot="upload" class="space-y-1.5">
                  <div class="flex items-center gap-3">
                    <label class="cursor-pointer flex-1 min-h-11 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-surface-raised hover:bg-surface-hover border border-control text-ink-secondary text-xs font-semibold focus-within:outline focus-within:outline-2 focus-within:outline-accent">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                      </svg>
                      <span>Selecionar Arquivo (PNG ou JPG)</span>
                      <input type="file" id="input-upload-art" accept="image/*" class="sr-only" />
                    </label>
                  </div>
                  <p class="text-[11px] text-ink-muted">
                    Para preencher a faixa, use uma imagem nítida na proporção da área selecionada.
                  </p>
                </div>
              </ArtLibraryPicker>
            )}
            <p id="canvas-status" data-art-status role="status" class="mt-2 text-xs text-accent break-all">Arte padrão do estúdio</p>
          </div>

          <!-- Slider de Escala / Zoom -->
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <label for="slider-scale" class="text-ink-secondary font-medium">3. Escala da estampa</label>
              <span id="label-scale" class="text-accent font-semibold">100%</span>
            </div>
            <input
              type="range"
              id="slider-scale"
              min="30"
              max="250"
              value="100"
              class="w-full accent-accent h-7 cursor-pointer"
            />
          </div>

          <!-- Slider de Deslocamento Horizontal -->
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <label for="slider-pos-x" class="text-ink-secondary font-medium">4. Posição horizontal</label>
              <span id="label-pos-x" class="text-ink-secondary font-medium">Centro</span>
            </div>
            <input
              type="range"
              id="slider-pos-x"
              min="-800"
              max="800"
              value="0"
              class="w-full accent-accent h-7 cursor-pointer"
            />
          </div>

          <!-- Slider de Deslocamento Vertical -->
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <label for="slider-pos-y" class="text-ink-secondary font-medium">5. Posição vertical</label>
              <span id="label-pos-y" class="text-ink-secondary font-medium">Centro</span>
            </div>
            <input
              type="range"
              id="slider-pos-y"
              min="-350"
              max="350"
              value="0"
              class="w-full accent-accent h-7 cursor-pointer"
            />
          </div>

          <!-- Botões de Ação -->
          <div class="pt-4 border-t border-line space-y-3">
            {!studioProducts && <button
              id="btn-export-quote"
              type="button"
              class="w-full min-h-11 flex items-center justify-center gap-2 px-3 py-3 rounded-md bg-action hover:bg-action-hover text-on-action font-semibold text-sm disabled:opacity-50"
            >
              <span>Gerar prévia para orçamento</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>}

            <button
              id="btn-reset-art"
              type="button"
              class="w-full min-h-11 rounded-md border border-line text-ink-secondary hover:border-accent text-xs font-medium"
            >
              Restaurar Estampa Padrão
            </button>

            {studioProducts ? <StudioPublication products={studioProducts} /> : <>
              <p id="export-status" role="status" class="text-center text-xs text-accent"></p>
              <a id="mug-whatsapp" data-whatsapp-quote hidden target="_blank" rel="noopener noreferrer" class="min-h-11 flex items-center justify-center rounded-md border border-accent px-3 text-sm font-semibold text-accent hover:bg-accent/10 [&[hidden]]:hidden">Abrir WhatsApp com a prévia ↗</a>
            </>}
          </div>
        </div>

        <!-- Especificações Rápidas -->
        <div class="p-4 rounded-xl bg-canvas/60 border border-line text-xs text-ink-muted space-y-1.5">
          <p><span class="text-ink-secondary font-semibold">• Material:</span> Cerâmica branca pura de alta densidade</p>
          <p><span class="text-ink-secondary font-semibold">• Capacidade:</span> 325 ml (11 oz)</p>
          <p><span class="text-ink-secondary font-semibold">• Processo:</span> Sublimação térmica digital de alta resolução</p>
          {!studioProducts && <p><span class="text-ink-secondary font-semibold">• Envio do Mockup:</span> O link da prévia 3D será anexado à sua mensagem no WhatsApp.</p>}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { clampValue, getMugPrintBand, MUG_PRINT_DIMENSIONS, MUG_PRINT_WIDTHS, type MugPrintWidth } from '../../utils/customizer';
  import { loadArtwork, loadImageFromUrl, setupMockupQuote } from '../../utils/customizerClient';
  import { connectArtLibraryPicker, type SelectedLibraryArt } from '../../utils/artLibraryClient';
  import { loadStudioArtwork, setupStudioPublication } from '../../utils/imageStudioClient';

  function initMugCustomizer() {
    const canvas3D = document.getElementById('mug-3d-canvas') as HTMLCanvasElement | null;
    const canvasTex = document.getElementById('mug-texture-canvas') as HTMLCanvasElement | null;
    const inputUpload = document.getElementById('input-upload-art') as HTMLInputElement | null;
    const sliderScale = document.getElementById('slider-scale') as HTMLInputElement | null;
    const sliderPosX = document.getElementById('slider-pos-x') as HTMLInputElement | null;
    const sliderPosY = document.getElementById('slider-pos-y') as HTMLInputElement | null;
    const labelScale = document.getElementById('label-scale');
    const labelPosX = document.getElementById('label-pos-x');
    const labelPosY = document.getElementById('label-pos-y');
    const btnExport = document.querySelector<HTMLButtonElement>('#btn-export-quote');
    const btnReset = document.getElementById('btn-reset-art');
    const exportStatus = document.getElementById('export-status');
    const canvasStatus = document.getElementById('canvas-status');
    const quoteLink = document.querySelector<HTMLAnchorElement>('#mug-whatsapp');
    const studio = document.querySelector<HTMLFormElement>('[data-studio-publication]');
    const widthOptions = document.querySelectorAll<HTMLInputElement>('input[name="mug-print-width"]');
    const measureLabels = document.querySelectorAll<HTMLElement>('[data-mug-measure]');

    if (!canvas3D || !canvasTex) return;

    const ctx = canvasTex.getContext('2d');
    if (!ctx) return;

    let userImage: HTMLImageElement | null = null;
    let selectedLibraryArt: SelectedLibraryArt | null = null;
    let libraryLoadSeq = 0;
    let scaleVal = 1;
    let offsetX = 0;
    let offsetY = 0;
    let printWidth: MugPrintWidth = MUG_PRINT_DIMENSIONS.widthCm;
    const measure = () => `${printWidth} × ${MUG_PRINT_DIMENSIONS.heightCm} cm`;

    function drawTexture() {
      if (!ctx || !canvasTex) return;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvasTex.width, canvasTex.height);

      if (userImage) {
        ctx.save();
        ctx.translate(canvasTex.width / 2 + offsetX, canvasTex.height / 2 + offsetY);
        const w = userImage.width * scaleVal;
        const h = userImage.height * scaleVal;
        ctx.drawImage(userImage, -w / 2, -h / 2, w, h);
        ctx.restore();
      } else {
        ctx.save();
        ctx.translate(canvasTex.width / 2 + offsetX, canvasTex.height / 2 + offsetY);
        ctx.scale(scaleVal, scaleVal);
        ctx.translate(-1000, -450);
        // Estampa padrão do estúdio
        ctx.fillStyle = '#0c0d0e';
        ctx.fillRect(400, 150, 1200, 600);
        ctx.strokeStyle = '#cca032';
        ctx.lineWidth = 12;
        ctx.strokeRect(430, 180, 1140, 540);

        ctx.fillStyle = '#cca032';
        ctx.font = 'bold 100px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('678 Estudio', 1000, 420);

        ctx.fillStyle = '#f1f3f5';
        ctx.font = '500 45px system-ui, sans-serif';
        ctx.fillText('DESIGN & PERSONALIZAÇÃO', 1000, 510);
        ctx.restore();
      }
    }

    drawTexture();

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x262422);
    const camera = new THREE.PerspectiveCamera(32, 16 / 11, 0.1, 30);
    camera.position.set(0, 1.75, 6.6);
    camera.lookAt(0.15, 0.02, 0);

    let renderer: THREE.WebGLRenderer | undefined;
    try {
      renderer = new THREE.WebGLRenderer({ canvas: canvas3D, antialias: true, preserveDrawingBuffer: true });
    } catch {
      const fallback = document.getElementById('mug-webgl-status');
      if (fallback) fallback.hidden = false;
      canvas3D.removeAttribute('tabindex');
      if (btnExport) btnExport.disabled = true;
    }

    scene.add(new THREE.HemisphereLight(0xfffaf4, 0xb3bbc8, 1.45));
    const keyLight = new THREE.DirectionalLight(0xfff7ed, 2.1);
    keyLight.position.set(-4, 6, 4);
    scene.add(keyLight);
    const rimLight = new THREE.DirectionalLight(0xeaf1ff, 1.25);
    rimLight.position.set(3, 4, -5);
    scene.add(rimLight);

    const shadowCanvas = document.createElement('canvas');
    shadowCanvas.width = shadowCanvas.height = 128;
    const shadowContext = shadowCanvas.getContext('2d')!;
    const shadowGradient = shadowContext.createRadialGradient(64, 64, 8, 64, 64, 64);
    shadowGradient.addColorStop(0, 'rgba(0, 0, 0, .72)');
    shadowGradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
    shadowContext.fillStyle = shadowGradient;
    shadowContext.fillRect(0, 0, 128, 128);
    const shadow = new THREE.Mesh(
      new THREE.PlaneGeometry(4.1, 3.4),
      new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(shadowCanvas), transparent: true, depthWrite: false }),
    );
    shadow.rotation.x = -Math.PI / 2;
    shadow.position.set(0.1, -1.18, 0.05);
    scene.add(shadow);

    const createTexture = () => {
      const texture = new THREE.CanvasTexture(canvasTex);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.anisotropy = Math.min(8, renderer?.capabilities.getMaxAnisotropy() ?? 1);
      return texture;
    };
    let texture = createTexture();

    const mug = new THREE.Group();
    mug.rotation.y = studio ? 0.78 : 0.62;
    const ceramic = new THREE.MeshStandardMaterial({ color: 0xf8f8f8, roughness: 0.28 });
    const liner = ceramic.clone();
    liner.side = THREE.BackSide;

    const addPart = (geometry: THREE.BufferGeometry, material = ceramic, y = 0) => {
      const mesh = new THREE.Mesh(geometry, material);
      mesh.position.y = y;
      mug.add(mesh);
      return mesh;
    };

    addPart(new THREE.CylinderGeometry(1, 0.94, 2.2, 96, 1, true));
    addPart(new THREE.CylinderGeometry(0.91, 0.86, 2.1, 96, 1, true), liner, 0.05);
    addPart(new THREE.CylinderGeometry(0.93, 0.94, 0.13, 96), ceramic, -1.035);
    const rim = addPart(new THREE.TorusGeometry(0.955, 0.045, 20, 96), ceramic, 1.1);
    rim.rotation.x = Math.PI / 2;

    const handle = addPart(new THREE.TorusGeometry(0.65, 0.13, 24, 64, Math.PI));
    handle.rotation.z = -Math.PI / 2;
    handle.position.x = 0.93;

    const createPrintGeometry = () => {
      const { height, thetaStart, thetaLength } = getMugPrintBand(printWidth);
      return new THREE.CylinderGeometry(1, 0.946, height, 96, 1, true, thetaStart, thetaLength);
    };
    const printMaterial = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.28 });
    const printBand = addPart(createPrintGeometry(), printMaterial);
    scene.add(mug);

    const render = () => renderer?.render(scene, camera);
    let quote: ReturnType<typeof setupMockupQuote> | undefined;
    if (renderer) {
      const previewRenderer = renderer;
      const resizePreview = () => {
        previewRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        previewRenderer.setSize(canvas3D.clientWidth, canvas3D.clientHeight, false);
        render();
      };
      new ResizeObserver(resizePreview).observe(canvas3D);
      resizePreview();

      const capture = (annotate: boolean) => {
        try {
          previewRenderer.setPixelRatio(1);
          previewRenderer.setSize(1600, 1100, false);
          render();
          const exportCanvas = document.createElement('canvas');
          exportCanvas.width = canvas3D.width;
          exportCanvas.height = canvas3D.height;
          const exportContext = exportCanvas.getContext('2d');
          if (!exportContext) throw new Error('Canvas de exportação indisponível.');
          exportContext.drawImage(canvas3D, 0, 0);
          if (annotate) {
            exportContext.font = '600 26px system-ui, sans-serif';
            exportContext.fillStyle = '#ffffff';
            exportContext.textAlign = 'center';
            exportContext.fillText(`Área de impressão · ${measure()}`, exportCanvas.width / 2, exportCanvas.height - 46);
          }
          return exportCanvas;
        } finally {
          resizePreview();
        }
      };
      if (studio) {
        quote = setupStudioPublication(studio, () => capture(false), () => Boolean(userImage));
      } else if (btnExport && exportStatus && quoteLink) {
        quote = setupMockupQuote(btnExport, exportStatus, quoteLink, () => {
          const zoom = Number(sliderScale?.value ?? 100);
          return {
            imageBase64: capture(true).toDataURL('image/png'),
            productName: 'Caneca Branca Signature 325 ml',
            details: [
              `• Área da estampa: ${measure()}`,
              `• Ajuste da estampa: escala ${zoom}%, posição X ${offsetX}, Y ${offsetY}`,
            ].join('\n'),
            ...(selectedLibraryArt ? {
              artReference: {
                arteId: selectedLibraryArt.id,
                version: selectedLibraryArt.version,
                product: 'caneca' as const,
                scale: zoom,
                posX: offsetX,
                posY: offsetY,
                printWidthCm: printWidth,
              },
            } : {}),
          };
        });
      }

      const rotate = (x: number, y: number) => {
        if (!x && !y) return;
        mug.rotation.y += x;
        mug.rotation.x = clampValue(mug.rotation.x + y, -0.3, 0.3);
        quote?.invalidate();
        render();
      };

      let drag: { id: number; x: number; y: number } | undefined;
      canvas3D.addEventListener('pointerdown', event => {
        if (drag || !event.isPrimary || event.button !== 0) return;
        drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
        canvas3D.setPointerCapture(event.pointerId);
      });
      canvas3D.addEventListener('pointermove', event => {
        if (!drag || drag.id !== event.pointerId) return;
        rotate((event.clientX - drag.x) * 0.012, event.pointerType === 'touch' ? 0 : (event.clientY - drag.y) * 0.006);
        drag.x = event.clientX;
        drag.y = event.clientY;
      });
      canvas3D.addEventListener('lostpointercapture', () => { drag = undefined; });

      const steps = new Map([
        ['ArrowLeft', [-0.18, 0]],
        ['ArrowRight', [0.18, 0]],
        ['ArrowUp', [0, -0.08]],
        ['ArrowDown', [0, 0.08]],
      ]);
      canvas3D.addEventListener('keydown', event => {
        const step = steps.get(event.key);
        if (!step) return;
        event.preventDefault();
        rotate(step[0], step[1]);
      });
    }

    const updateArtwork = () => {
      const zoom = Number(sliderScale?.value ?? 100);
      const baseScale = userImage
        ? Math.min(canvasTex.width / userImage.naturalWidth, canvasTex.height / userImage.naturalHeight)
        : 1;
      scaleVal = baseScale * zoom / 100;
      offsetX = Number(sliderPosX?.value ?? 0);
      offsetY = Number(sliderPosY?.value ?? 0);
      if (labelScale) labelScale.textContent = zoom + '%';
      if (labelPosX) labelPosX.textContent = offsetX ? (offsetX / 100).toLocaleString('pt-BR') + ' cm' : 'Centro';
      if (labelPosY) labelPosY.textContent = offsetY ? (offsetY / 100).toLocaleString('pt-BR') + ' cm' : 'Centro';
      drawTexture();
      texture.needsUpdate = true;
      quote?.invalidate();
      render();
    };

    const updatePrintWidth = () => {
      const selected = Array.from(widthOptions).find(option => option.checked);
      const width = MUG_PRINT_WIDTHS.find(value => String(value) === selected?.value);
      if (!width || width === printWidth) return;

      printWidth = width;
      canvasTex.width = width * 100;
      // A textura já enviada ao WebGL precisa ser recriada ao mudar de dimensão.
      texture.dispose();
      texture = createTexture();
      printMaterial.map = texture;
      printBand.geometry.dispose();
      printBand.geometry = createPrintGeometry();
      for (const label of measureLabels) label.textContent = measure();
      updateArtwork();
    };
    for (const option of widthOptions) option.addEventListener('change', updatePrintWidth);
    updatePrintWidth();

    const resetControls = () => {
      if (sliderScale) sliderScale.value = '100';
      if (sliderPosX) sliderPosX.value = '0';
      if (sliderPosY) sliderPosY.value = '0';
    };

    const artPicker = studio
      ? null
      : connectArtLibraryPicker(document.querySelector<HTMLElement>('[data-art-picker-root]'), {
          onSelect: async art => {
            const seq = ++libraryLoadSeq;
            quote?.invalidate();
            quote?.setArtworkPending(true);
            if (canvasStatus) canvasStatus.textContent = `Carregando ${art.code}…`;
            try {
              const image = await loadImageFromUrl(art.previewUrl);
              if (seq !== libraryLoadSeq) return;
              userImage = image;
              selectedLibraryArt = art;
              resetControls();
              if (canvasStatus) canvasStatus.textContent = `[${art.code}] ${art.title} (v${art.version})`;
              updateArtwork();
            } catch {
              if (seq === libraryLoadSeq && canvasStatus) {
                canvasStatus.textContent = 'Não foi possível carregar a arte da biblioteca. A arte anterior foi mantida.';
              }
            } finally {
              if (seq === libraryLoadSeq) quote?.setArtworkPending(false);
            }
          },
        });

    inputUpload?.addEventListener('change', async () => {
      const file = inputUpload.files?.[0];
      if (!file) return;
      libraryLoadSeq++;
      quote?.invalidate();
      quote?.setArtworkPending(true);
      if (canvasStatus) canvasStatus.textContent = 'Carregando imagem…';
      try {
        const image = await (studio ? loadStudioArtwork(file) : loadArtwork(file));
        if (inputUpload.files?.[0] !== file) return;
        userImage = image;
        selectedLibraryArt = null;
        artPicker?.clearSelection();
        resetControls();
        if (canvasStatus) canvasStatus.textContent = file.name;
        updateArtwork();
      } catch {
        if (inputUpload.files?.[0] === file && canvasStatus) {
          canvasStatus.textContent = 'Não foi possível abrir a imagem. A arte anterior foi mantida.';
        }
      } finally {
        if (inputUpload.files?.[0] === file) {
          inputUpload.value = '';
          quote?.setArtworkPending(false);
        }
      }
    });

    for (const slider of [sliderScale, sliderPosX, sliderPosY]) {
      slider?.addEventListener('input', updateArtwork);
    }

    btnReset?.addEventListener('click', () => {
      libraryLoadSeq++;
      userImage = null;
      selectedLibraryArt = null;
      artPicker?.clearSelection();
      if (inputUpload) inputUpload.value = '';
      quote?.setArtworkPending(false);
      resetControls();
      if (canvasStatus) canvasStatus.textContent = 'Arte padrão do estúdio';
      updateArtwork();
    });

  }

  // Inicializa quando a página carregar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMugCustomizer);
  } else {
    initMugCustomizer();
  }
</script>
