---
interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const links = [
  { href: '/personalizar/caneca', label: 'Personalize sua caneca', description: 'Veja sua arte aplicada em 3D' },
  { href: '/personalizar/quadro', label: 'Crie seu quadro', description: 'Escolha a moldura e visualize no ambiente' },
  { href: '/personalizar/agenda', label: 'Personalize sua agenda', description: 'Escolha o miolo e veja páginas reais' },
  { href: '/personalizar/planner', label: 'Crie seu planner', description: 'Monte seu planner com capa e miolo personalizados' },
  { href: '/personalizar/caderno', label: 'Personalize seu caderno', description: 'Escolha entre Receitas, Diário Pessoal e Livro de Memórias' },
];
---

<details data-customizer-nav class:list={['group relative', mobile && 'border-b border-line/60']}>
  <summary class:list={[
    'flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md text-sm font-semibold text-accent hover:text-accent-strong',
    mobile ? 'justify-between py-2' : 'px-2.5 hover:bg-surface-muted group-open:bg-surface-muted',
  ]}>
    Crie o seu
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
      <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul class:list={[
    'space-y-1 rounded-lg border border-line bg-surface p-1.5',
    mobile ? 'mb-2' : 'absolute left-0 top-full z-10 mt-1 w-72 whitespace-normal shadow-lg',
  ]}>
    {links.map(({ href, label, description }) => (
      <li>
        <a href={href} class="block rounded-md px-3 py-2.5 hover:bg-surface-muted focus-visible:-outline-offset-2">
          <span class="block text-sm font-semibold text-ink">{label}</span>
          <span class="mt-0.5 block text-xs text-ink-secondary">{description}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
