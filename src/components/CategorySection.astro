---
import type { ProductCategory } from '../types/catalog';
import { getActiveProductsByCategory, getHomeFeaturedProducts } from '../db/catalogRepository';
import ProductCard from './ProductCard.astro';
import { getRequestStudioSettings } from '../db/studioSettings';
import { buildWhatsAppQuotePath } from '../utils/whatsapp';

interface Props {
  category: ProductCategory;
}

const { category } = Astro.props;
const isShowcaseLine = category.slug === 'canecas' || category.slug === 'quadros';
const isStationery = category.slug === 'papelaria';
const products = isShowcaseLine
  ? await getHomeFeaturedProducts(category.slug, 4)
  : isStationery
    ? []
    : await getActiveProductsByCategory(category.slug);

const stationeryCards = [
  {
    title: 'Agendas',
    description: 'Miolo datado ou permanente com capa exclusiva.',
    href: '/personalizar/agenda',
    image: '/images/demo/planner-executivo.webp',
    cta: 'Personalizar agenda',
  },
  {
    title: 'Planners',
    description: 'Organização semanal, hábitos e controle financeiro.',
    href: '/personalizar/planner',
    image: '/images/demo/planner-executivo.jpg',
    cta: 'Criar planner',
  },
  {
    title: 'Cadernos',
    description: 'Receitas, diário pessoal ou livro de memórias.',
    href: '/personalizar/caderno',
    image: '/images/demo/caderno-pautado.jpg',
    cta: 'Personalizar caderno',
  },
  {
    title: 'Calendários',
    description: 'Anual, mensal de parede ou de mesa Wire-O.',
    href: '/personalizar/calendario',
    image: '/images/demo/quadro-geometria.webp',
    cta: 'Criar calendário',
  },
];

const { whatsapp } = await getRequestStudioSettings(Astro.locals);
const categoryQuoteLink = whatsapp && buildWhatsAppQuotePath({
  categoryTitle: category.title,
  customMessage: `Olá! Tenho interesse na linha de ${category.title} do 678 Estudio e gostaria de solicitar um orçamento.`
});
const customizer = category.slug === 'quadros'
  ? { href: '/personalizar/quadro', label: 'Crie seu quadro' }
  : category.slug === 'canecas'
    ? { href: '/personalizar/caneca', label: 'Personalize sua caneca' }
    : undefined;
const collectionLink = category.slug === 'quadros'
  ? { href: '/quadros', label: 'Ver todos os quadros' }
  : category.slug === 'canecas'
    ? { href: '/canecas', label: 'Ver todas as canecas' }
    : undefined;
---

<section id={category.slug} aria-labelledby={`${category.slug}-title`} class="py-10 md:py-14 lg:py-16 border-b border-line" data-carousel>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 md:gap-8 mb-5">
      <div>
        <p class="editorial-kicker">{category.subtitle}</p>
        <h2 id={`${category.slug}-title`} class="editorial-heading mt-2 text-4xl sm:text-5xl leading-tight">
          {category.title}
        </h2>
        <p class="mt-2 text-sm text-ink-secondary max-w-2xl leading-relaxed">
          {category.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
        {collectionLink && (
          <a href={collectionLink.href} class="inline-flex min-h-11 items-center gap-2 rounded-md border border-accent px-4 text-sm font-semibold text-accent hover:bg-accent/10">
            {collectionLink.label} <span aria-hidden="true">→</span>
          </a>
        )}
        {customizer && (
          <a href={customizer.href} class="inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover">
            {customizer.label} <span aria-hidden="true">→</span>
          </a>
        )}
        {categoryQuoteLink && <a href={categoryQuoteLink} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-accent hover:text-accent-strong">
          Orçar esta linha <span aria-hidden="true">↗</span>
        </a>}
        {!isStationery && (
          <div hidden data-carousel-controls>
            <div class="flex gap-2">
              <button type="button" class="carousel-button" data-carousel-prev aria-controls={`${category.slug}-produtos`} aria-label={`Produtos anteriores em ${category.title}`}>←</button>
              <button type="button" class="carousel-button" data-carousel-next aria-controls={`${category.slug}-produtos`} aria-label={`Próximos produtos em ${category.title}`}>→</button>
            </div>
          </div>
        )}
      </div>
    </div>

    {isStationery ? (
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {stationeryCards.map((item) => (
          <article class="min-w-0 flex flex-col rounded-lg bg-surface border border-line hover:border-accent/40 motion-safe:transition-colors">
            <a href={item.href} class="block aspect-[5/4] bg-canvas rounded-t-lg overflow-hidden">
              <img src={item.image} alt={item.title} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </a>
            <div class="p-3.5 sm:p-5 flex-1 flex flex-col justify-between gap-3">
              <div>
                <h3 class="text-base sm:text-lg font-semibold text-ink">
                  <a href={item.href} class="hover:underline">{item.title}</a>
                </h3>
                <p class="mt-1.5 text-xs sm:text-sm text-ink-secondary leading-relaxed">{item.description}</p>
              </div>
              <a href={item.href} class="min-h-11 inline-flex items-center text-xs sm:text-sm font-semibold text-accent hover:underline">
                {item.cta} <span aria-hidden="true" class="ml-1">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : products.length > 0 ? (
      <div id={`${category.slug}-produtos`} data-carousel-track role="group" aria-label={`Produtos de ${category.title}`} class="carousel-track">
        {products.map((product) => (
          <ProductCard product={product} categoryTitle={category.title} />
        ))}
      </div>
    ) : (
      <p class="rounded-lg border border-line p-5 text-sm text-ink-secondary">
        {categoryQuoteLink ? 'Consulte os modelos disponíveis pelo WhatsApp.' : 'Nenhum modelo disponível nesta linha no momento.'}
      </p>
    )}
  </div>
</section>

<style>
  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 23rem);
    gap: 1rem;
    overflow-x: auto;
    padding: 4px 4px 0.75rem;
    margin-inline: -4px;
    scroll-padding-inline: 4px;
    scroll-snap-type: x mandatory;
    scrollbar-color: rgb(var(--color-control)) rgb(var(--color-surface-muted));
    scrollbar-width: thin;
  }

  .carousel-track > :global(article) {
    scroll-snap-align: start;
  }

  .carousel-button {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(var(--color-control));
    border-radius: 0.375rem;
    color: rgb(var(--color-accent));
    font-size: 1.25rem;
  }

  .carousel-button:hover:enabled {
    border-color: rgb(var(--color-accent));
    background: rgb(var(--color-surface-muted));
  }

  .carousel-button:disabled {
    opacity: 0.45;
  }

  @media (min-width: 640px) {
    .carousel-track {
      grid-auto-columns: 40%;
    }
  }

  @media (min-width: 1024px) {
    .carousel-track {
      grid-auto-columns: calc((100% - 2rem) / 3);
    }
  }
</style>

<script>
  for (const section of document.querySelectorAll('[data-carousel]')) {
    const track = section.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = section.querySelector<HTMLElement>('[data-carousel-controls]');
    const previous = section.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const firstCard = track?.firstElementChild;
    const secondCard = firstCard?.nextElementSibling;
    if (!track || !controls || !previous || !next || !firstCard) continue;

    const updateControls = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      controls.hidden = maxScroll <= 1;
      track.tabIndex = controls.hidden ? -1 : 0;
      previous.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
    };

    const move = (direction: number) => {
      const step = secondCard
        ? secondCard.getBoundingClientRect().left - firstCard.getBoundingClientRect().left
        : firstCard.getBoundingClientRect().width;
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: direction * step, behavior: reducedMotion ? 'instant' : 'smooth' });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(track);
    updateControls();
  }
</script>
