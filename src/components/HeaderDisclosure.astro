---
interface Props {
  label: string;
  mobile?: boolean;
}

const { label, mobile = false } = Astro.props;
---

<details data-header-disclosure class:list={['group relative', mobile && 'border-b border-line/60']}>
  <summary class:list={[
    'flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md text-sm font-semibold text-accent hover:text-accent-strong',
    mobile ? 'justify-between py-2' : 'px-2.5 hover:bg-surface-muted group-open:bg-surface-muted',
  ]}>
    {label}
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4 shrink-0 group-open:rotate-180 motion-safe:transition-transform">
      <path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul class:list={[
    'space-y-1 overflow-y-auto whitespace-normal rounded-lg border border-line bg-surface p-1.5',
    mobile
      ? 'mb-2 max-h-[min(22rem,45dvh)]'
      : 'absolute left-0 top-full z-10 mt-1 max-h-[min(24rem,calc(100dvh-4.75rem))] w-72 shadow-lg',
  ]}>
    <slot />
  </ul>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
