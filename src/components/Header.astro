---
import { buildWhatsAppLink } from '../utils/whatsapp';
import BrandMark from './BrandMark.astro';

const directContactLink = buildWhatsAppLink({
  customMessage: 'Olá! Vim pelo site do 678 Estudio e gostaria de conversar sobre um projeto personalizado.'
});
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-canvas/95 border-b border-line/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[4.25rem] flex items-center justify-between gap-3">
    <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-3 group">
      <BrandMark class="size-11 sm:size-12" />
      <div class="flex flex-col">
        <span class="whitespace-nowrap text-base font-semibold text-ink group-hover:text-accent motion-safe:transition-colors">
          678 Estudio
        </span>
        <span class="hidden min-[375px]:block text-[10px] text-ink-muted tracking-wide uppercase">
          Design & Personalização
        </span>
      </div>
    </a>

    <!-- Navegação Desktop -->
    <nav aria-label="Menu principal" class="hidden xl:flex items-center gap-5 whitespace-nowrap text-sm font-medium text-ink-secondary">
      <a href="/#quadros" class="hover:text-accent motion-safe:transition-colors">Quadros</a>
      <a href="/#canecas" class="hover:text-accent motion-safe:transition-colors">Canecas</a>
      <a href="/#papelaria" class="hover:text-accent motion-safe:transition-colors">Agendas & Planners</a>
      <a href="/#artesanato" class="hover:text-accent motion-safe:transition-colors">Madeira & Especiais</a>
      <a href="/personalizar/caneca" class="text-accent hover:text-accent-strong font-semibold motion-safe:transition-colors flex items-center gap-1">
        <span>Caneca 3D</span>
      </a>
      <a href="/personalizar/quadro" class="text-accent hover:text-accent-strong font-semibold motion-safe:transition-colors flex items-center gap-1">
        <span>Quadro no Ambiente</span>
      </a>
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-3">
      <a
        href={directContactLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex min-h-11 items-center px-4 rounded-md text-sm font-semibold whitespace-nowrap bg-action hover:bg-action-hover text-on-action motion-safe:transition-colors"
      >
        <span>Solicitar Orçamento</span>
      </a>

      <button id="theme-toggle" type="button" hidden aria-label="Tema escuro" aria-pressed="false" class="inline-flex size-11 shrink-0 items-center justify-center rounded-md border border-control text-ink-secondary hover:bg-surface-muted hover:text-accent [&[hidden]]:hidden">
        <svg data-theme-icon="dark" aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.9 13.4A9 9 0 0 1 10.6 3.1 9 9 0 1 0 20.9 13.4Z" />
        </svg>
        <svg data-theme-icon="light" aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
      </button>

      <!-- Botão Hambúrguer Mobile -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="xl:hidden inline-flex size-11 items-center justify-center rounded-md text-ink-secondary hover:text-accent hover:bg-surface-muted"
        aria-label="Menu principal"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-bars" aria-hidden="true" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" aria-hidden="true" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu Mobile Desdobrável -->
  <nav id="mobile-menu" aria-label="Menu principal" class="hidden xl:hidden max-h-[calc(100dvh-4.25rem)] overflow-y-auto border-t border-line bg-canvas px-4 pt-3 pb-6 space-y-2">
    <a href="/#quadros" class="min-h-11 flex items-center py-2 text-sm font-medium text-ink-secondary hover:text-accent border-b border-line/60">
      Quadros Decorativos
    </a>
    <a href="/#canecas" class="min-h-11 flex items-center py-2 text-sm font-medium text-ink-secondary hover:text-accent border-b border-line/60">
      Canecas Personalizadas
    </a>
    <a href="/#papelaria" class="min-h-11 flex items-center py-2 text-sm font-medium text-ink-secondary hover:text-accent border-b border-line/60">
      Agendas & Planners
    </a>
    <a href="/#artesanato" class="min-h-11 flex items-center py-2 text-sm font-medium text-ink-secondary hover:text-accent border-b border-line/60">
      Artesanato em Madeira
    </a>
    <div class="pt-2 pb-1 grid grid-cols-2 gap-2">
      <a href="/personalizar/caneca" class="min-h-11 grid place-items-center p-2.5 rounded-md border border-accent/30 bg-accent/10 text-accent text-xs font-semibold text-center">
        Simular Caneca 3D
      </a>
      <a href="/personalizar/quadro" class="min-h-11 grid place-items-center p-2.5 rounded-md border border-accent/30 bg-accent/10 text-accent text-xs font-semibold text-center">
        Simular Quadro
      </a>
    </div>
    <a
      href={directContactLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex items-center justify-center w-full min-h-11 rounded-md text-sm font-semibold bg-action text-on-action"
    >
      <span>Solicitar Orçamento via WhatsApp</span>
    </a>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const barsIcon = document.getElementById('menu-icon-bars');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!toggleButton || !mobileMenu) return;

    const btn = toggleButton;
    const menu = mobileMenu;

    function setExpanded(expanded: boolean) {
      btn.setAttribute('aria-expanded', String(expanded));
      menu.classList.toggle('hidden', !expanded);
      barsIcon?.classList.toggle('hidden', expanded);
      closeIcon?.classList.toggle('hidden', !expanded);
    }

    btn.addEventListener('click', () => setExpanded(menu.classList.contains('hidden')));
    menu.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('a')) return;
      setExpanded(false);
      btn.focus({ preventScroll: true });
    });
    btn.closest('header')?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menu.classList.contains('hidden')) return;
      setExpanded(false);
      btn.focus();
    });
    matchMedia('(min-width: 1280px)').addEventListener('change', ({ matches }) => {
      if (matches) setExpanded(false);
    });
  }

  setupMobileMenu();
</script>
