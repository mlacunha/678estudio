---
import { getActiveCategories } from '../db/catalogRepository';
import { resolveCategoryDestination } from '../data/internalDestinations';
import { getRequestStudioSettings } from '../db/studioSettings';
import { buildWhatsAppQuotePath } from '../utils/whatsapp';
import BrandMark from './BrandMark.astro';
import CustomizerNav from './CustomizerNav.astro';
import ProductsNav from './ProductsNav.astro';

const [{ whatsapp }, activeCategories] = await Promise.all([
  getRequestStudioSettings(Astro.locals),
  getActiveCategories(),
]);

const navCategories = activeCategories.map((category) => ({
  title: category.title,
  href: resolveCategoryDestination(category).collectionHref,
}));

const directContactLink = whatsapp && buildWhatsAppQuotePath({
  customMessage: 'Olá! Vim pelo site do 678 Estudio e gostaria de conversar sobre um projeto personalizado.'
});
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-canvas/95 border-b border-line/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[4.25rem] flex items-center justify-between gap-3">
    <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-3 group">
      <BrandMark class="size-11 sm:size-12" />
      <div class="flex flex-col">
        <span class="whitespace-nowrap text-base font-semibold text-ink group-hover:text-accent motion-safe:transition-colors">
          678 Estudio
        </span>
        <span class="hidden min-[375px]:block text-[10px] text-ink-muted tracking-wide uppercase">
          Design & Personalização
        </span>
      </div>
    </a>

    <!-- Navegação Desktop -->
    <nav id="desktop-menu" aria-label="Menu principal" class="hidden lg:flex items-center gap-5 whitespace-nowrap text-sm font-medium text-ink-secondary">
      <ProductsNav categories={navCategories} />
      <a href="/trabalhos" class="hover:text-accent motion-safe:transition-colors">Trabalhos</a>
      <CustomizerNav />
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-3">
      {directContactLink && <a
        href={directContactLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex min-h-11 items-center px-4 rounded-md text-sm font-semibold whitespace-nowrap bg-action hover:bg-action-hover text-on-action motion-safe:transition-colors"
      >
        <span>Solicitar Orçamento</span>
      </a>}

      <button id="theme-toggle" type="button" hidden aria-label="Tema escuro" aria-pressed="false" class="inline-flex size-11 shrink-0 items-center justify-center rounded-md border border-control text-ink-secondary hover:bg-surface-muted hover:text-accent [&[hidden]]:hidden">
        <svg data-theme-icon="dark" aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.9 13.4A9 9 0 0 1 10.6 3.1 9 9 0 1 0 20.9 13.4Z" />
        </svg>
        <svg data-theme-icon="light" aria-hidden="true" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
      </button>

      <!-- Botão Hambúrguer Mobile -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden inline-flex size-11 items-center justify-center rounded-md text-ink-secondary hover:text-accent hover:bg-surface-muted"
        aria-label="Menu principal"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-bars" aria-hidden="true" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" aria-hidden="true" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu Mobile Desdobrável -->
  <nav id="mobile-menu" aria-label="Menu principal" class="hidden lg:hidden max-h-[calc(100dvh-4.25rem)] overflow-y-auto border-t border-line bg-canvas px-4 pt-3 pb-6 space-y-2">
    <ProductsNav categories={navCategories} mobile />
    <a href="/trabalhos" class="min-h-11 flex items-center py-2 text-sm font-medium text-ink-secondary hover:text-accent border-b border-line/60">
      Nossos Trabalhos
    </a>
    <CustomizerNav mobile />
    {directContactLink && <a
      href={directContactLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex items-center justify-center w-full min-h-11 rounded-md text-sm font-semibold bg-action text-on-action"
    >
      <span>Solicitar Orçamento via WhatsApp</span>
    </a>}
  </nav>
</header>

<script>
  function setupNavigation() {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const barsIcon = document.getElementById('menu-icon-bars');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!toggleButton || !mobileMenu) return;

    const btn = toggleButton;
    const menu = mobileMenu;
    const header = btn.closest('header');
    const mobileDisclosures = menu.querySelectorAll<HTMLDetailsElement>('[data-header-disclosure]');
    const desktopDisclosures = header?.querySelectorAll<HTMLDetailsElement>('#desktop-menu [data-header-disclosure]');

    function setExpanded(expanded: boolean) {
      btn.setAttribute('aria-expanded', String(expanded));
      menu.classList.toggle('hidden', !expanded);
      barsIcon?.classList.toggle('hidden', expanded);
      closeIcon?.classList.toggle('hidden', !expanded);
      if (!expanded) mobileDisclosures.forEach(disclosure => { disclosure.open = false; });
    }

    btn.addEventListener('click', () => setExpanded(menu.classList.contains('hidden')));
    menu.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('a')) return;
      setExpanded(false);
      btn.focus({ preventScroll: true });
    });
    header?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const submenu = event.target instanceof Element
        ? event.target.closest<HTMLDetailsElement>('[data-header-disclosure][open]')
        : null;
      if (submenu) {
        event.preventDefault();
        submenu.open = false;
        submenu.querySelector('summary')?.focus();
        return;
      }
      if (menu.classList.contains('hidden')) return;
      event.preventDefault();
      setExpanded(false);
      btn.focus();
    });
    document.addEventListener('click', ({ target }) => {
      if (!(target instanceof Node)) return;
      desktopDisclosures?.forEach(disclosure => {
        if (!disclosure.contains(target)) disclosure.open = false;
      });
    });
    desktopDisclosures?.forEach(disclosure => {
      disclosure.addEventListener('focusout', ({ relatedTarget }) => {
        if (relatedTarget instanceof Node && !disclosure.contains(relatedTarget)) disclosure.open = false;
      });
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', ({ matches }) => {
      if (matches) setExpanded(false);
      else desktopDisclosures?.forEach(disclosure => { disclosure.open = false; });
    });
  }

  setupNavigation();
</script>
