---
import { getRequestStudioSettings } from '../db/studioSettings';
import { buildWhatsAppQuotePath, WHATSAPP_UNAVAILABLE } from '../utils/whatsapp';

const { whatsapp } = await getRequestStudioSettings(Astro.locals);
const directContactLink = whatsapp && buildWhatsAppQuotePath({
  customMessage: 'Olá! Gostaria de um atendimento personalizado para criar uma peça exclusiva com o 678 Estudio.'
});
---

<section class="py-12 md:py-20 bg-surface-muted border-b border-line" aria-labelledby="contact-title">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="editorial-kicker mb-4">Atendimento sob medida</p>

    <h2 id="contact-title" class="editorial-heading text-4xl sm:text-5xl leading-tight">
      Vamos conversar sobre sua ideia?
    </h2>

    <p class="mt-4 text-sm sm:text-base text-ink-secondary max-w-xl mx-auto leading-relaxed">
      {directContactLink
        ? 'Envie sua proposta ou referências pelo WhatsApp. A equipe do estúdio orienta você sobre materiais, personalização e prazos.'
        : WHATSAPP_UNAVAILABLE}
    </p>

    {directContactLink && <div class="mt-6">
      <a
        href={directContactLink}
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-11 inline-flex items-center justify-center px-5 rounded-md bg-action hover:bg-action-hover text-on-action font-semibold text-sm motion-safe:transition-colors"
      >
        Falar pelo WhatsApp
      </a>
    </div>}

  </div>
</section>

