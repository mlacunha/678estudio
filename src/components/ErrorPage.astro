---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  status: 404 | 500;
  title: string;
  description: string;
}

const { status, title, description } = Astro.props;
---

<BaseLayout title={`${title} | 678 Estudio`} description={description}>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <p class="editorial-kicker mb-3">Erro {status}</p>
    <h1 class="editorial-heading text-4xl sm:text-6xl">{title}</h1>
    <p class="mt-4 max-w-lg text-ink-secondary">{description}</p>
    <a href="/" class="mt-7 inline-flex min-h-11 items-center rounded-md bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover">
      Voltar para o início
    </a>
  </section>
</BaseLayout>
