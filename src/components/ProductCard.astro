---
import type { Product, ProductCategory } from '../types/catalog';
import {
  resolveProductDestination,
  type CategoryDestinationInput,
} from '../data/internalDestinations';
import { resolveValidLinkedArteId } from '../db/catalogRepository';
import { getRequestStudioSettings } from '../db/studioSettings';
import { buildWhatsAppQuotePath } from '../utils/whatsapp';
import { getCatalogLargeImage } from '../utils/catalogImages';

interface Props {
  product: Product;
  category?: ProductCategory;
  categoryTitle?: string;
}

const { product, category, categoryTitle } = Astro.props;
const displayCategoryTitle = category?.title ?? categoryTitle ?? product.categoryTitle ?? '';
const effectiveCategory: CategoryDestinationInput = category ?? {
  slug: product.categorySlug,
  title: displayCategoryTitle,
};

const effectiveAction = product.actionType ?? category?.defaultProductAction ?? 'quote';
const candidateCustomizerHref = product.actionType
  ? product.actionHref
  : (product.actionHref ?? category?.defaultProductHref);

const validLinkedArteId =
  effectiveAction === 'customizer' && product.linkedArteId
    ? await resolveValidLinkedArteId(
        product.linkedArteId,
        product.categoryId ?? product.categorySlug,
        undefined,
        candidateCustomizerHref,
      )
    : undefined;

const demoImage = new Map([
  ['quadro-geometria', 'quadro-geometria'],
  ['quadro-botanica', 'quadro-geometria'],
  ['quadro-arquitetura', 'quadro-geometria'],
  ['caneca-branca', 'caneca-branca'],
  ['caneca-matte', 'caneca-branca'],
  ['planner-executivo', 'planner-executivo'],
  ['caderno-pautado', 'planner-executivo'],
  ['madeira-organizador', 'madeira-organizador'],
  ['madeira-suporte', 'madeira-organizador'],
]).get(product.imageUrl.match(/^\/images\/demo\/([\w-]+)\.jpg$/)?.[1] ?? '');

const isIllustrative = product.isProvisional || Boolean(demoImage);
const displayImageSrc = demoImage ? `/images/demo/${demoImage}.webp` : product.imageUrl;
const largeImage = getCatalogLargeImage(product.imageUrl);

const { whatsapp } = await getRequestStudioSettings(Astro.locals);
const whatsappQuoteHref =
  whatsapp &&
  buildWhatsAppQuotePath({
    productName: product.name,
    categoryTitle: displayCategoryTitle,
  });

const destination = resolveProductDestination(product, effectiveCategory, {
  validLinkedArteId,
  whatsappQuoteHref: whatsappQuoteHref || undefined,
});
const hasInternalPrimaryLink =
  (destination.kind === 'customizer' || destination.kind === 'details') && Boolean(destination.href);
---

<article class="min-w-0 flex flex-col rounded-lg bg-surface border border-line hover:border-accent/40 focus-within:border-accent/40 motion-safe:transition-colors">
  <div class="relative aspect-[5/4] bg-canvas rounded-t-lg overflow-hidden">
    {hasInternalPrimaryLink ? (
      <a href={destination.href} aria-label={`${destination.label}: ${product.name}`} class="block h-full">
        <img
          src={displayImageSrc}
          alt={isIllustrative ? `Referência visual: ${product.name}` : product.name}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : largeImage ? (
      <a
        href={largeImage}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Ampliar imagem: ${product.name}`}
        class="block h-full bg-[#262422] focus-visible:outline focus-visible:outline-offset-[-3px] focus-visible:outline-accent"
      >
        <img
          src={product.imageUrl}
          alt={product.name}
          width="480"
          height="480"
          class="h-full w-full object-contain"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <img
        src={displayImageSrc}
        alt={isIllustrative ? `Referência visual da linha de ${displayCategoryTitle.toLocaleLowerCase('pt-BR')}` : product.name}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    )}

    {isIllustrative && (
      <span class="pointer-events-none absolute bottom-3 left-3 px-2.5 py-1 rounded text-xs font-medium bg-media-badge/95 text-on-media">
        Imagem ilustrativa
      </span>
    )}
  </div>

  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-lg leading-snug font-semibold text-ink break-words">
        {hasInternalPrimaryLink ? (
          <a href={destination.href} class="hover:underline">{product.name}</a>
        ) : (
          product.name
        )}
      </h3>
      <p class="mt-2 text-sm text-ink-secondary leading-relaxed break-words">
        {product.description}
      </p>
      {product.featuredBadge && (
        <p class="mt-3 text-xs text-accent break-words">{product.featuredBadge}</p>
      )}
    </div>

    <div class="mt-4 pt-3 border-t border-line flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
      {hasInternalPrimaryLink ? (
        <a
          href={destination.href}
          class="min-h-11 inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
        >
          {destination.label} <span aria-hidden="true">→</span>
        </a>
      ) : destination.kind === 'quote' && destination.href ? (
        <a
          href={destination.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${destination.label}: ${product.name}`}
          class="min-h-11 inline-flex items-center gap-1.5 px-3 rounded-md text-xs font-semibold bg-surface-raised hover:bg-action hover:text-on-action text-ink motion-safe:transition-colors"
        >
          {destination.label} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="text-xs text-ink-muted font-medium">{destination.label}</span>
      )}

      {destination.allowSecondaryQuote && whatsappQuoteHref && (
        <a
          href={whatsappQuoteHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Orçar peça: ${product.name}`}
          class="min-h-11 inline-flex items-center gap-1.5 px-3 rounded-md text-xs font-semibold bg-surface-raised hover:bg-action hover:text-on-action text-ink motion-safe:transition-colors"
        >
          Orçar peça <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
