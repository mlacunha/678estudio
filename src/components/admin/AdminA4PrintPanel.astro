---
interface Props {
  pdfEndpoint: string;
  baseParams?: Record<string, string>;
  productLabel: string;
}

const { pdfEndpoint, baseParams = {}, productLabel } = Astro.props;
const selectClass =
  'mt-1 w-full rounded-md border border-control bg-canvas px-3 py-2 text-xs font-medium text-ink focus:border-accent focus:outline-none';
const labelClass = 'block text-[11px] font-semibold uppercase tracking-wider text-ink-muted';
---

<div class="mt-6 rounded-xl border border-line bg-canvas/60 p-4 sm:p-5" data-a4-print-panel>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h3 class="text-base font-semibold text-ink">
        Preparação para Impressão A4 Manual (Corte Central → 2 Folhas A5)
      </h3>
      <p class="mt-1 text-xs text-ink-secondary">
        Gera folhas A4 paisagem (297 × 210 mm) com 2 páginas A5 lado a lado para corte reto em 148,5 mm (Cut &amp; Stack).
        O PDF A5 original permanece separado acima.
      </p>
    </div>
    <span class="rounded-full border border-line bg-surface px-2.5 py-1 font-mono text-[11px] text-ink-muted">
      100% Vetorial · {productLabel}
    </span>
  </div>

  <form method="get" action={pdfEndpoint} class="mt-4">
    {Object.entries(baseParams).map(([key, value]) => (
      <input type="hidden" name={key} value={value} />
    ))}

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class={labelClass}>Empilhamento pós-corte</span>
        <select name="empilhamento" class={selectClass} data-a4-param="empilhamento">
          <option value="cut-stack" selected>Cortar e Empilhar (Cut &amp; Stack)</option>
          <option value="sequential">Pares Sequenciais (Folha a Folha)</option>
        </select>
      </label>

      <label class="block">
        <span class={labelClass}>Virada manual do verso</span>
        <select name="virada" class={selectClass} data-a4-param="virada">
          <option value="short-edge" selected>Borda curta (Esq ↔ Dir, topo 0°)</option>
          <option value="long-edge">Borda longa (Rotacionar 180°)</option>
        </select>
      </label>

      <label class="block">
        <span class={labelClass}>Ordem das folhas do verso</span>
        <select name="ordem" class={selectClass} data-a4-param="ordem">
          <option value="normal" selected>Normal (1ª folha → Última)</option>
          <option value="reverse">Invertida (Última → 1ª folha)</option>
        </select>
      </label>

      <label class="block">
        <span class={labelClass}>Área imprimível A4</span>
        <select name="escala" class={selectClass} data-a4-param="escala">
          <option value="full" selected>Escala real 100% (Sem redução)</option>
          <option value="safe">Margem segura 96% (Impressoras comuns)</option>
        </select>
      </label>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-line pt-4">
      <button
        type="submit"
        name="modo"
        value="a4-frentes"
        class="inline-flex min-h-10 items-center justify-center rounded-md bg-action px-4 text-xs font-semibold text-on-action hover:bg-action-hover"
      >
        1. Baixar PDF A4 — Frentes
      </button>

      <button
        type="submit"
        name="modo"
        value="a4-versos"
        class="inline-flex min-h-10 items-center justify-center rounded-md border border-control bg-surface px-4 text-xs font-semibold text-ink hover:border-accent hover:text-accent"
      >
        2. Baixar PDF A4 — Versos
      </button>

      <a
        href="/admin/impressao-a4/calibracao.pdf?virada=short-edge&escala=full"
        data-a4-calibration-link
        class="inline-flex min-h-10 items-center justify-center rounded-md border border-line px-3.5 text-xs font-semibold text-accent hover:underline"
      >
        Baixar Folha de Calibração A4 (Teste Físico)
      </a>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-a4-print-panel]').forEach((panel) => {
    const link = panel.querySelector<HTMLAnchorElement>('[data-a4-calibration-link]');
    const virada = panel.querySelector<HTMLSelectElement>('[data-a4-param="virada"]');
    const escala = panel.querySelector<HTMLSelectElement>('[data-a4-param="escala"]');
    if (!link || !virada || !escala) return;

    const updateCalibrationHref = () => {
      const params = new URLSearchParams({
        virada: virada.value,
        escala: escala.value,
      });
      link.href = `/admin/impressao-a4/calibracao.pdf?${params.toString()}`;
    };

    virada.addEventListener('change', updateCalibrationHref);
    escala.addEventListener('change', updateCalibrationHref);
  });
</script>

