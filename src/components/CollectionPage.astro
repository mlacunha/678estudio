---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from './ProductCard.astro';
import './carousel.css';
import WhatsAppCTA from './WhatsAppCTA.astro';
import { getActiveProductsByCategory } from '../db/catalogRepository';
import { resolveCategoryDestination } from '../data/internalDestinations';
import type { ProductCategory } from '../types/catalog';

interface Props {
  category: ProductCategory;
  metaDescription?: string;
}

const { category, metaDescription } = Astro.props;
const products = await getActiveProductsByCategory(category.id || category.slug);
const categoryDest = resolveCategoryDestination(category);
const pageDescription =
  metaDescription ||
  category.description ||
  `Explore os modelos de ${category.title} do 678 Estudio.`;
---

<BaseLayout title={`${category.title} | 678 Estudio`} description={pageDescription}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 space-y-8">
    {category.coverImageUrl && (
      <div class="overflow-hidden rounded-2xl border border-line bg-surface-muted max-h-72 sm:max-h-80">
        <img
          src={category.coverImageUrl}
          alt={category.title}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-line">
      <div>
        <p class="editorial-kicker">{category.subtitle || 'Coleção exclusiva'}</p>
        <h1 class="editorial-heading mt-2 text-4xl sm:text-5xl">{category.title}</h1>
        {category.description && (
          <p class="mt-2 text-sm text-ink-secondary max-w-2xl leading-relaxed">
            {category.description}
          </p>
        )}
      </div>
      <div class="flex flex-wrap gap-3">
        {categoryDest.customizerHref && (
          <a
            href={categoryDest.customizerHref}
            class="inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-5 text-sm font-semibold text-on-action hover:bg-action-hover"
          >
            {categoryDest.customizerLabel} <span aria-hidden="true">→</span>
          </a>
        )}
        <a
          href="/"
          class="inline-flex min-h-11 items-center rounded-md border border-control px-4 text-xs font-medium text-ink-secondary hover:border-ink-muted"
        >
          Voltar ao Início
        </a>
      </div>
    </header>

    {products.length > 0 ? (
      <div class:list={[
        'grid gap-6 sm:grid-cols-2 lg:grid-cols-3',
        category.slug === 'papelaria' ? 'carousel-track carousel-track--mobile' : 'grid-cols-1',
      ]}>
        {products.map((product) => (
          <ProductCard product={product} category={category} />
        ))}
      </div>
    ) : (
      <p class="rounded-xl border border-line bg-surface p-6 text-sm text-ink-secondary">
        Nenhum modelo ativo nesta coleção no momento. Entre em contato pelo WhatsApp para projetos sob medida.
      </p>
    )}
  </section>
  <WhatsAppCTA />
</BaseLayout>
