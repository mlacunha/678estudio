---
import CollectionPage from '../components/CollectionPage.astro';
import { getCategoryBySlug } from '../db/catalogRepository';
import type { ProductCategory } from '../types/catalog';

export const prerender = false;

const dbCategory = await getCategoryBySlug('quadros');
if (dbCategory && dbCategory.isActive === false) {
  Astro.response.status = 404;
}

const category: ProductCategory = dbCategory ?? {
  id: 'cat-quadros',
  slug: 'quadros',
  title: 'Quadros Personalizados',
  subtitle: 'Galeria exclusiva',
  description: 'Escolha um modelo ou obra e personalize moldura, orientação e margens no simulador.',
  badge: '',
  defaultProductAction: 'customizer',
  defaultProductHref: '/personalizar/quadro',
};
---

<CollectionPage
  category={category}
  metaDescription="Explore a galeria de quadros decorativos do 678 Estudio ou crie seu quadro personalizado simulando moldura e ambiente."
/>
