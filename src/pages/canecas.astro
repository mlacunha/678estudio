---
import CollectionPage from '../components/CollectionPage.astro';
import { getCategoryBySlug } from '../db/catalogRepository';
import type { ProductCategory } from '../types/catalog';

export const prerender = false;

const dbCategory = await getCategoryBySlug('canecas');
if (dbCategory && dbCategory.isActive === false) {
  Astro.response.status = 404;
}

const category: ProductCategory = dbCategory ?? {
  id: 'cat-canecas',
  slug: 'canecas',
  title: 'Canecas Personalizadas',
  subtitle: 'Coleção exclusiva',
  description: 'Escolha um modelo pronto ou abra o personalizador 3D para enviar sua própria arte.',
  badge: '',
  defaultProductAction: 'customizer',
  defaultProductHref: '/personalizar/caneca',
};
---

<CollectionPage
  category={category}
  metaDescription="Explore todos os modelos de canecas personalizadas do 678 Estudio ou crie sua caneca com arte própria em 3D."
/>
