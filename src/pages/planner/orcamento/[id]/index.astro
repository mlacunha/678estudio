---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getPlannerQuote } from '../../../../db/plannerQuotes';
import {
  formatPlannerQuoteDate,
  plannerQuoteLabels,
  plannerQuotePath,
} from '../../../../server/planner/quoteConfig';
import { plannerSections } from '../../../../server/planner/options.mjs';

export const prerender = false;

const quote = await getPlannerQuote(Astro.params.id ?? '');
if (!quote) {
  return new Response('Referência de planner não encontrada.', {
    status: 404,
    headers: { 'Cache-Control': 'no-store' },
  });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const { config } = quote;
const basePath = plannerQuotePath(quote.id);
---

<BaseLayout title="Referência do Planner Essencial | 678 Estudio">
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[.2em] text-accent">Solicitação registrada</p>
    <h1 class="editorial-heading text-4xl">{quote.product}</h1>
    <p class="mt-3 text-ink-secondary">{plannerQuoteLabels(config).join(' · ')}</p>
    <p class="mt-1 text-sm text-ink-secondary">
      Cores {config.customColors ? 'personalizadas' : 'do estilo'}: {config.colors.primary} / {config.colors.secondary}
      {config.personalizationName ? ` · Identificação: ${config.personalizationName}` : ''}
      {config.logo ? ` · Logo (${config.watermark ? 'com marca-d’água' : 'sem marca-d’água'})` : ''}
    </p>
    <p class="mt-2 text-sm text-ink-muted">Registrada em {formatPlannerQuoteDate(quote.createdAt)}.</p>
    <p class="mt-4 break-all text-sm text-ink-secondary">
      Referência <strong class="font-mono text-ink">{quote.id}</strong>
    </p>

    <h2 class="mt-8 text-xl font-semibold">Prévias da solicitação</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-4">
      {plannerSections.map((section) => {
        const href = `${basePath}/previa/${section.id}`;
        return (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="block min-w-0 rounded-xl border border-line bg-surface p-2 hover:border-accent"
          >
            <img
              src={href}
              alt={`${section.label} · ${section.detail}`}
              width="839"
              height="1191"
              class="block h-auto w-full rounded bg-white object-contain"
            />
            <span class="mt-2 block px-1 text-sm font-semibold text-ink">{section.label}</span>
            <span class="block px-1 text-xs text-ink-secondary">{section.detail} · Ampliar</span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

