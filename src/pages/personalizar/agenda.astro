---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverCustomizerTab from '../../components/customizer/CoverCustomizerTab.astro';
import { agendaFormats, agendaLayouts, agendaStyles, agendaYears } from '../../server/agenda/options.mjs';

const fieldClass = 'w-full min-h-11 rounded-lg border border-control bg-canvas px-3 text-sm text-ink';
---

<BaseLayout title="Personalize sua Agenda Clássica | 678 Estudio"
  description="Escolha o miolo, o estilo e as cores da sua Agenda Clássica e visualize páginas reais da sua edição.">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <header class="mb-7 border-b border-line pb-7 lg:mb-9">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[.2em] text-accent">Papelaria personalizada</p>
      <h1 class="text-4xl font-light leading-tight text-ink sm:text-5xl">Agenda <span class="font-normal text-accent">Clássica</span></h1>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-secondary sm:text-base">
        Escolha como organizar seus dias e dê ao miolo a sua identidade. Veja páginas reais da agenda antes de decidir.
      </p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(18rem,23rem)_minmax(0,1fr)] lg:gap-8">
      <form id="agenda-form" action="/api/agenda/preview" method="post" enctype="multipart/form-data"
        class="rounded-2xl border border-line bg-surface p-4 sm:p-6">
        <div class="mb-5 flex rounded-lg border border-line bg-surface-muted p-1">
          <button type="button" id="tab-btn-cover" class="flex-1 rounded-md bg-surface px-3 py-2 text-xs font-semibold text-accent shadow-sm transition">
            1. Capa &amp; Contracapa
          </button>
          <button type="button" id="tab-btn-inner" class="flex-1 rounded-md px-3 py-2 text-xs font-medium text-ink-muted hover:text-ink transition">
            2. Miolo &amp; Conteúdo
          </button>
        </div>
        <div id="tab-pane-cover">
          <CoverCustomizerTab defaultTitle="Agenda Clássica" />
        </div>
        <div id="tab-pane-inner" hidden>
        <fieldset id="agenda-fields" class="min-w-0 space-y-5">
          <legend class="mb-5 text-lg font-semibold text-ink">Personalize seu miolo</legend>
          <div class="grid grid-cols-2 gap-3">
            <label class="space-y-2 text-sm font-medium">Ano
              <select name="year" class={fieldClass}>
                {agendaYears.map(year => <option value={year}>{year}</option>)}
              </select>
            </label>
            <label class="space-y-2 text-sm font-medium">Formato
              <select name="format" class={fieldClass}>
                {Object.entries(agendaFormats).map(([id, format]) => <option value={id}>{format.label}</option>)}
              </select>
              <small class="block text-xs font-normal text-ink-muted">{agendaFormats.a5.detail}</small>
            </label>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-2 text-sm font-medium">Layout</legend>
            {Object.entries(agendaLayouts).map(([id, layout], index) => (
              <label class="agenda-choice">
                <input type="radio" name="layout" value={id} checked={index === 0} />
                <span><strong>{layout.label}</strong><small>{layout.detail}</small></span>
              </label>
            ))}
          </fieldset>

          <fieldset>
            <legend class="mb-2 text-sm font-medium">Estilo visual</legend>
            <div class="grid grid-cols-3 gap-2">
              {Object.entries(agendaStyles).map(([id, style], index) => (
                <label class="cursor-pointer">
                  <input type="radio" name="style" value={id} checked={index === 0} class="peer sr-only" />
                  <span class="block rounded-lg border border-control px-1 py-2.5 text-center text-xs font-semibold text-ink-secondary peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    {style.label}
                  </span>
                </label>
              ))}
            </div>
            <p id="agenda-style-detail" class="mt-2 text-xs text-ink-muted">{agendaStyles.classic.detail}</p>
          </fieldset>

          <div class="space-y-3 border-t border-line pt-4">
            <h2 class="text-sm font-semibold">Sua identidade <span class="font-normal text-ink-muted">· Opcional</span></h2>
            <label class="block space-y-2 text-sm" for="agenda-logo">
              <span>Logomarca</span>
              <input type="file" id="agenda-logo" name="logo" accept="image/png,image/jpeg" aria-describedby="agenda-logo-help"
                class="block w-full min-w-0 text-xs text-ink-secondary file:mr-2 file:rounded-md file:border-0 file:bg-surface-muted file:px-2 file:py-2 file:font-semibold file:text-ink" />
            </label>
            <p id="agenda-logo-help" class="text-xs text-ink-muted">PNG ou JPEG de até 2 MB e 4 megapixels. A logo aparece no rodapé.</p>
            <button id="agenda-remove-logo" type="button" class="min-h-10 rounded-md px-2 text-xs font-semibold text-accent hover:bg-surface-muted" hidden>
              Remover logomarca
            </button>
            <label class="flex items-center gap-2 text-sm has-[:disabled]:opacity-60">
              <input id="agenda-watermark" type="checkbox" name="watermark" value="true" disabled class="size-4 accent-accent" />
              Usar a logo como marca-d’água
            </label>
            <label class="flex items-center gap-2 text-sm">
              <input id="agenda-custom-colors" type="checkbox" class="size-4 accent-accent" />
              Usar minhas cores
            </label>
            <fieldset id="agenda-colors" disabled hidden class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-2 text-xs">
                <input type="color" name="primary" value={agendaStyles.classic.primary} class="h-10 w-10 cursor-pointer rounded border border-control bg-canvas" /> Principal
              </label>
              <label class="flex items-center gap-2 text-xs">
                <input type="color" name="secondary" value={agendaStyles.classic.secondary} class="h-10 w-10 cursor-pointer rounded border border-control bg-canvas" /> Destaque
              </label>
              <p class="col-span-2 text-xs text-ink-muted">Prefira tons escuros para manter o contraste no papel.</p>
            </fieldset>
          </div>
          <button id="agenda-submit" type="submit"
            class="min-h-12 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:cursor-wait disabled:opacity-70">
            Visualizar minha agenda
          </button>
        </fieldset>
        </div>
        <p id="agenda-error" role="alert" class="mt-3 text-sm font-medium text-danger" hidden></p>
        <noscript><p class="mt-3 text-sm text-ink-secondary">Ative o JavaScript para abrir a galeria de prévias.</p></noscript>
      </form>

      <section id="agenda-results" aria-labelledby="agenda-preview-title" class="min-w-0 scroll-mt-24 rounded-2xl border border-line bg-surface p-4 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4">
          <h2 id="agenda-preview-title" class="text-lg font-semibold">Prévia visual do produto</h2>
          <div class="flex items-center gap-2">
            <button type="button" id="toggle-view-cover" class="rounded border border-control px-2.5 py-1 text-xs font-semibold text-accent hover:border-accent">Ver Capa</button>
            <button type="button" id="toggle-view-inner" class="rounded border border-control px-2.5 py-1 text-xs font-medium text-ink-muted hover:text-ink">Ver Miolo</button>
          </div>
          <p id="agenda-status" role="status" class="w-full text-xs text-ink-secondary"></p>
        </div>
        <div id="cover-preview-container" class="mt-4 flex flex-col items-center justify-center rounded-xl bg-surface-muted p-6">
          <div class="mb-3 flex items-center gap-2">
            <button type="button" id="cover-side-front" class="rounded border border-accent bg-surface px-2.5 py-1 text-xs font-semibold text-accent">Capa frontal</button>
            <button type="button" id="cover-side-back" class="rounded border border-control bg-surface px-2.5 py-1 text-xs font-medium text-ink-muted hover:text-ink">Contracapa</button>
          </div>
          <p id="cover-preview-error" role="alert" class="mb-3 w-full max-w-md rounded-lg border border-danger/40 bg-danger/10 px-3 py-2 text-center text-xs font-medium text-danger" hidden></p>
          <div id="cover-preview-placeholder" class="flex min-h-[18rem] w-full max-w-[14rem] flex-col items-center justify-center rounded-lg border border-dashed border-control bg-canvas px-4 text-center">
            <span class="text-xs font-medium text-ink-secondary">Gerando prévia da capa…</span>
          </div>
          <img id="cover-preview-img" alt="Prévia da Capa Personalizada" class="max-h-[22rem] rounded-lg shadow-md object-contain" hidden />
          <p id="cover-preview-status" role="status" class="mt-3 text-xs text-ink-muted">Prévia em escala real com margem de segurança e refile A5.</p>
        </div>
        <p id="agenda-summary" class="mt-4 text-sm text-ink-secondary" hidden></p>
        <div class="my-4 rounded-xl border border-line bg-surface-muted p-3 sm:p-4">
          <p id="agenda-quote-status" role="status" class="text-sm text-ink-secondary">Gere as prévias para solicitar seu orçamento.</p>
          <button id="agenda-quote" type="button" disabled aria-describedby="agenda-quote-status"
            class="mt-3 min-h-12 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:opacity-50 sm:w-auto">
            Solicitar orçamento pelo WhatsApp
          </button>
          <a id="agenda-quote-reference" target="_blank" rel="noopener noreferrer"
            class="mt-3 block text-sm font-semibold text-accent underline" hidden>Consultar última referência salva</a>
        </div>
        <div id="agenda-placeholder" hidden class="flex min-h-64 flex-col items-center justify-center rounded-xl bg-surface-muted px-5 py-10 text-center sm:min-h-96">
          <svg aria-hidden="true" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-5 size-16 text-accent">
            <rect x="14" y="8" width="37" height="48" rx="4" /><path d="M22 8v48m-12-36h9m-9 12h9m-9 12h9m10-19h14m-14 7h14m-14 7h10" stroke-linecap="round" />
          </svg>
          <p class="text-base font-semibold">Seu miolo começa aqui</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-secondary">Escolha suas opções e selecione “Visualizar minha agenda” para conhecer cada seção do miolo.</p>
        </div>
        <div id="agenda-gallery" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3"></div>
      </section>
    </div>
  </div>

  <dialog id="agenda-dialog" aria-labelledby="agenda-dialog-title"
    class="m-auto max-h-[94dvh] w-[min(96vw,48rem)] max-w-none rounded-2xl border border-line bg-surface p-3 text-ink backdrop:bg-scrim/80 sm:p-4">
    <div class="flex items-center justify-between gap-4 pb-2">
      <h2 id="agenda-dialog-title" class="text-sm font-semibold">Página da agenda</h2>
      <form method="dialog"><button type="submit" autofocus class="min-h-11 rounded-md border border-control px-3 text-sm">Fechar</button></form>
    </div>
    <div id="agenda-image-viewport" class="max-h-[70dvh] overflow-auto rounded bg-surface-muted" tabindex="0"
      role="region" aria-label="Visualização da página">
      <img id="agenda-enlarged" class="mx-auto block max-h-[70dvh] max-w-full object-contain" alt="" />
    </div>
    <div class="mt-3 flex justify-between gap-2">
      <button id="agenda-prev" type="button" class="min-h-11 rounded-md border border-control px-3 text-sm disabled:opacity-40">Anterior</button>
      <button id="agenda-zoom" type="button" aria-pressed="false" class="min-h-11 rounded-md border border-control px-3 text-sm">Zoom 150%</button>
      <button id="agenda-next" type="button" class="min-h-11 rounded-md border border-control px-3 text-sm disabled:opacity-40">Próxima</button>
    </div>
  </dialog>
</BaseLayout>

<style>
  .agenda-choice {
    @apply flex min-h-12 cursor-pointer items-center gap-3 rounded-lg border border-control px-3 py-2;
  }
  .agenda-choice:has(:checked) {
    @apply border-accent bg-accent/10;
  }
  .agenda-choice:focus-within {
    @apply outline outline-2 outline-offset-2 outline-accent;
  }
  .agenda-choice input { @apply size-4 shrink-0 accent-accent; }
  .agenda-choice strong { @apply block text-sm font-medium text-ink; }
  .agenda-choice small { @apply block text-xs text-ink-muted; }
  #agenda-enlarged[data-zoom] { width: 150%; max-width: none; max-height: none; }
  [hidden] { display: none; }
</style>

<script>
  import { initAgendaCustomizer } from '../../scripts/agendaCustomizer';
  import { setupCoverCustomizer, setupCustomizerTabs } from '../../scripts/coverCustomizer';
  initAgendaCustomizer();
  setupCoverCustomizer({ formId: 'agenda-form', coverPreviewId: 'cover-preview-img' });
  setupCustomizerTabs({ formId: 'agenda-form', placeholderId: 'agenda-placeholder', galleryId: 'agenda-gallery' });
</script>
