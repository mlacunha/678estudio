---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  plannerFormats,
  plannerModels,
  plannerModes,
  plannerStyles,
  plannerTypographies,
  plannerYears,
} from '../../server/planner/options.mjs';

const fieldClass = 'w-full min-h-11 rounded-lg border border-control bg-canvas px-3 text-sm text-ink';
---

<BaseLayout
  title="Personalize seu Planner Essencial | 678 Estudio"
  description="Personalize o miolo do seu Planner Essencial A5 com organização pessoal, profissional e financeira. Veja páginas reais antes de decidir."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:py-12 lg:px-8">
    <header class="mb-7 border-b border-line pb-7 lg:mb-9">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[.2em] text-accent">Papelaria personalizada</p>
      <h1 class="text-4xl font-light leading-tight text-ink sm:text-5xl">
        Planner <span class="font-normal text-accent">Essencial</span>
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
        Organização pessoal, profissional e financeira completa em formato A5 com calha de encadernação. Escolha entre
        a edição datada ou atemporal, selecione o estilo visual e confira páginas reais do seu miolo.
      </p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(18rem,23rem)_minmax(0,1fr)] lg:gap-8">
      <form
        id="planner-form"
        action="/api/planner/preview"
        method="post"
        enctype="multipart/form-data"
        class="rounded-2xl border border-line bg-surface p-4 sm:p-6"
      >
        <fieldset id="planner-fields" class="min-w-0 space-y-5">
          <legend class="mb-5 text-lg font-semibold text-ink">Personalize seu miolo</legend>

          <div>
            <label class="space-y-1 text-sm font-medium">
              <span>Modelo do Planner</span>
              <select name="model" class={fieldClass}>
                {Object.entries(plannerModels).map(([id, model]) => (
                  <option value={id}>{model.label}</option>
                ))}
              </select>
            </label>
            <p class="mt-1 text-xs text-ink-muted">{plannerModels['planner-essencial'].detail}</p>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-2 text-sm font-medium">Modalidade</legend>
            <div class="grid grid-cols-2 gap-2">
              {Object.entries(plannerModes).map(([id, mode], index) => (
                <label class="planner-choice cursor-pointer">
                  <input type="radio" name="mode" value={id} checked={index === 0} class="peer sr-only" />
                  <span class="block w-full rounded-lg border border-control px-2 py-2.5 text-center text-xs font-semibold text-ink-secondary peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent">
                    {mode.label}
                  </span>
                </label>
              ))}
            </div>
            <p id="planner-mode-detail" class="mt-1 text-xs text-ink-muted">{plannerModes.dated.detail}</p>
          </fieldset>

          <div class="grid grid-cols-2 gap-3">
            <div id="planner-year-container">
              <label class="space-y-1 text-sm font-medium">
                <span>Ano</span>
                <select id="planner-year" name="year" class={fieldClass}>
                  {plannerYears.map((year) => (
                    <option value={year}>{year}</option>
                  ))}
                </select>
              </label>
              <small class="block text-xs font-normal text-ink-muted">Calendário oficial</small>
            </div>

            <div>
              <label class="space-y-1 text-sm font-medium">
                <span>Formato</span>
                <select name="format" class={fieldClass}>
                  {Object.entries(plannerFormats).map(([id, format]) => (
                    <option value={id}>{format.label}</option>
                  ))}
                </select>
              </label>
              <small class="block text-xs font-normal text-ink-muted">{plannerFormats.a5.detail}</small>
            </div>
          </div>

          <fieldset>
            <legend class="mb-2 text-sm font-medium">Estilo visual</legend>
            <div class="grid grid-cols-3 gap-2">
              {Object.entries(plannerStyles).map(([id, style], index) => (
                <label class="cursor-pointer">
                  <input type="radio" name="style" value={id} checked={index === 0} class="peer sr-only" />
                  <span class="block rounded-lg border border-control px-1 py-2.5 text-center text-xs font-semibold text-ink-secondary peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    {style.label}
                  </span>
                </label>
              ))}
            </div>
            <p id="planner-style-detail" class="mt-2 text-xs text-ink-muted">{plannerStyles.classic.detail}</p>
          </fieldset>

          <fieldset>
            <legend class="mb-2 text-sm font-medium">Tipografia</legend>
            <div class="grid grid-cols-3 gap-2">
              {Object.entries(plannerTypographies).map(([id, typo], index) => (
                <label class="cursor-pointer">
                  <input type="radio" name="typography" value={id} checked={index === 0} class="peer sr-only" />
                  <span class="block rounded-lg border border-control px-1 py-2.5 text-center text-xs font-semibold text-ink-secondary peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    {typo.label}
                  </span>
                </label>
              ))}
            </div>
            <p id="planner-typography-detail" class="mt-2 text-xs text-ink-muted">{plannerTypographies.modern.detail}</p>
          </fieldset>

          <div class="space-y-3 border-t border-line pt-4">
            <h2 class="text-sm font-semibold">Identificação e acabamento <span class="font-normal text-ink-muted">· Opcional</span></h2>

            <label class="block space-y-1 text-sm">
              <span>Nome ou título personalizado</span>
              <input
                type="text"
                name="personalizationName"
                maxlength="60"
                placeholder="Ex.: Mariana Rocha ou Studio 678"
                class={fieldClass}
              />
            </label>
            <p class="text-xs text-ink-muted">Aparece na página de abertura e rosto do miolo.</p>

            <label class="block space-y-1 text-sm" for="planner-logo">
              <span>Logomarca</span>
              <input
                type="file"
                id="planner-logo"
                name="logo"
                accept="image/png,image/jpeg"
                aria-describedby="planner-logo-help"
                class="block w-full min-w-0 text-xs text-ink-secondary file:mr-2 file:rounded-md file:border-0 file:bg-surface-muted file:px-2 file:py-2 file:font-semibold file:text-ink"
              />
            </label>
            <p id="planner-logo-help" class="text-xs text-ink-muted">PNG ou JPEG de até 2 MB. Aparece nos rodapés e na abertura.</p>
            <button
              id="planner-remove-logo"
              type="button"
              class="min-h-10 rounded-md px-2 text-xs font-semibold text-accent hover:bg-surface-muted"
              hidden
            >
              Remover logomarca
            </button>

            <label class="flex items-center gap-2 text-sm has-[:disabled]:opacity-60">
              <input id="planner-watermark" type="checkbox" name="watermark" value="true" disabled class="size-4 accent-accent" />
              Usar a logo como marca-d’água
            </label>

            <label class="flex items-center gap-2 text-sm">
              <input id="planner-custom-colors" type="checkbox" class="size-4 accent-accent" />
              Usar minhas cores
            </label>
            <fieldset id="planner-colors" disabled hidden class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-2 text-xs">
                <input
                  type="color"
                  name="primary"
                  value={plannerStyles.classic.primary}
                  class="h-10 w-10 cursor-pointer rounded border border-control bg-canvas"
                />
                Principal
              </label>
              <label class="flex items-center gap-2 text-xs">
                <input
                  type="color"
                  name="secondary"
                  value={plannerStyles.classic.secondary}
                  class="h-10 w-10 cursor-pointer rounded border border-control bg-canvas"
                />
                Destaque
              </label>
              <p class="col-span-2 text-xs text-ink-muted">Prefira tons escuros para manter o contraste no papel.</p>
            </fieldset>
          </div>

          <button
            id="planner-submit"
            type="submit"
            class="min-h-12 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:cursor-wait disabled:opacity-70"
          >
            Visualizar meu planner
          </button>
        </fieldset>

        <p id="planner-error" role="alert" class="mt-3 text-sm font-medium text-danger" hidden></p>
        <noscript><p class="mt-3 text-sm text-ink-secondary">Ative o JavaScript para abrir a galeria de prévias.</p></noscript>
      </form>

      <section
        id="planner-results"
        aria-labelledby="planner-preview-title"
        class="min-w-0 scroll-mt-24 rounded-2xl border border-line bg-surface p-4 sm:p-6"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4">
          <h2 id="planner-preview-title" class="text-lg font-semibold">Prévias reais do miolo</h2>
          <p id="planner-status" role="status" class="text-xs text-ink-secondary"></p>
        </div>

        <p id="planner-summary" class="mt-4 text-sm text-ink-secondary" hidden></p>

        <div class="my-4 rounded-xl border border-line bg-surface-muted p-3 sm:p-4">
          <p id="planner-quote-status" role="status" class="text-sm text-ink-secondary">
            Gere as prévias para solicitar seu orçamento.
          </p>
          <button
            id="planner-quote"
            type="button"
            disabled
            aria-describedby="planner-quote-status"
            class="mt-3 min-h-12 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:opacity-50 sm:w-auto"
          >
            Solicitar orçamento pelo WhatsApp
          </button>
          <a
            id="planner-quote-reference"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 block text-sm font-semibold text-accent underline"
            hidden
          >
            Consultar última referência salva
          </a>
        </div>

        <div
          id="planner-placeholder"
          class="flex min-h-64 flex-col items-center justify-center rounded-xl bg-surface-muted px-5 py-10 text-center sm:min-h-96"
        >
          <svg aria-hidden="true" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-5 size-16 text-accent">
            <rect x="12" y="8" width="40" height="48" rx="4" />
            <path d="M20 8v48M28 18h20M28 26h20M28 34h14M28 42h16" stroke-linecap="round" />
            <circle cx="16" cy="18" r="1.5" fill="currentColor" />
            <circle cx="16" cy="30" r="1.5" fill="currentColor" />
            <circle cx="16" cy="42" r="1.5" fill="currentColor" />
          </svg>
          <p class="text-base font-semibold">Seu Planner Essencial começa aqui</p>
          <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-secondary">
            Escolha as opções à esquerda e clique em “Visualizar meu planner” para renderizar páginas reais das 8 seções
            (abertura, anual, mensal, semanal em duas páginas, hábitos, financeiro, revisão e anotações).
          </p>
        </div>

        <div id="planner-gallery" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
      </section>
    </div>
  </div>

  <dialog
    id="planner-dialog"
    aria-labelledby="planner-dialog-title"
    class="m-auto max-h-[94dvh] w-[min(96vw,52rem)] max-w-none rounded-2xl border border-line bg-surface p-3 text-ink backdrop:bg-scrim/80 sm:p-4"
  >
    <div class="flex items-center justify-between gap-4 pb-2">
      <h2 id="planner-dialog-title" class="text-sm font-semibold">Página do Planner</h2>
      <form method="dialog">
        <button type="submit" autofocus class="min-h-11 rounded-md border border-control px-3 text-sm">Fechar</button>
      </form>
    </div>
    <div
      id="planner-image-viewport"
      class="max-h-[70dvh] overflow-auto rounded bg-surface-muted"
      tabindex="0"
      role="region"
      aria-label="Visualização da página"
    >
      <img id="planner-enlarged" class="mx-auto block max-h-[70dvh] max-w-full object-contain" alt="" />
    </div>
    <div class="mt-3 flex justify-between gap-2">
      <button id="planner-prev" type="button" class="min-h-11 rounded-md border border-control px-3 text-sm disabled:opacity-40">Anterior</button>
      <button id="planner-zoom" type="button" aria-pressed="false" class="min-h-11 rounded-md border border-control px-3 text-sm">Zoom 150%</button>
      <button id="planner-next" type="button" class="min-h-11 rounded-md border border-control px-3 text-sm disabled:opacity-40">Próxima</button>
    </div>
  </dialog>
</BaseLayout>

<style>
  #planner-enlarged[data-zoom] {
    width: 150%;
    max-width: none;
    max-height: none;
  }
  [hidden] {
    display: none;
  }
</style>

<script>
  import { initPlannerCustomizer } from '../../scripts/plannerCustomizer';
  initPlannerCustomizer();
</script>

