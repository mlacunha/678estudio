---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FRAME_COLORS, FRAME_MARGINS, FRAME_ORIENTATIONS } from '../../utils/frameLayout';

export const prerender = false;
---

<BaseLayout
  title="Personalizador de Quadros em Ambientes | 678 Estudio"
  description="Simule a sublimação da sua arte em madeira clara em dois ambientes. Escolha a orientação, as margens e a cor da moldura."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Header da Página -->
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div>
        <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-accent font-semibold mb-1">
          <span>Simulação em ambiente</span>
          <span>•</span>
          <span class="whitespace-nowrap" data-frame-measure>30 × 40 cm</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-light text-ink">
          Personalizador de <span class="font-normal text-accent">Quadros no Ambiente</span>
        </h1>
        <p class="mt-1 text-xs sm:text-sm text-ink-muted">
          Veja sua arte sublimada em madeira clara. Ajuste a orientação, as margens e a cor da moldura.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/#quadros"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-control hover:border-ink-muted bg-surface text-ink-secondary text-xs font-medium motion-safe:transition-colors"
        >
          <span>Voltar ao Catálogo</span>
        </a>
      </div>
    </div>

    <!-- Grid do Simulador -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 items-start">
      
      <!-- Visualizador do Ambiente (Canvas / Preview) -->
      <div class="customizer-preview min-w-0 lg:col-span-7">
        <div class="relative w-full aspect-[16/11] bg-canvas rounded-2xl border border-line overflow-hidden">
          
          <!-- Elemento Canvas Principal que gera a composição -->
          <canvas id="frame-stage-canvas" width="1600" height="1100" role="img" aria-label="Prévia do quadro de 30 × 40 cm no ambiente selecionado" class="w-full h-full block"></canvas>

          <!-- Selo de Ambiente Atual -->
          <div class="absolute top-4 left-4 pointer-events-none flex items-center gap-2 px-3 py-1.5 rounded-full bg-media-badge/95 backdrop-blur-md text-[11px] font-medium text-on-media">
            <span class="w-2 h-2 rounded-full bg-on-media"></span>
            <span id="badge-environment-name">Sala Contemporânea</span>
          </div>

          <div class="absolute top-4 right-4 pointer-events-none px-2.5 py-1 rounded text-[10px] uppercase tracking-wider font-semibold bg-media-badge/95 text-on-media">
            <span data-frame-measure>30 × 40 cm</span>
          </div>
        </div>

      </div>

      <!-- Painel de Controles -->
      <div class="min-w-0 lg:col-span-5 flex flex-col gap-4">
        <div class="p-4 sm:p-6 rounded-2xl bg-surface border border-line space-y-4 sm:space-y-5">
          <h2 class="text-base font-semibold text-ink pb-3 border-b border-line">
            Personalizar Quadro
          </h2>

          <!-- Escolha do Ambiente -->
          <div>
            <label class="block text-xs uppercase tracking-wider text-ink-muted font-medium mb-2">
              1. Selecionar Ambiente
            </label>
            <div class="grid grid-cols-2 gap-3">
              <button
                type="button"
                id="btn-env-living"
                aria-pressed="true"
                class="btn-env-select px-4 py-3 rounded-xl border border-accent bg-accent/10 text-accent text-xs font-semibold text-center motion-safe:transition-all"
                data-env="living"
              >
                Sala Contemporânea
              </button>
              <button
                type="button"
                id="btn-env-office"
                aria-pressed="false"
                class="btn-env-select px-4 py-3 rounded-xl border border-line bg-canvas text-ink-secondary hover:border-control text-xs font-semibold text-center motion-safe:transition-all"
                data-env="office"
              >
                Escritório Elegante
              </button>
            </div>
          </div>

          <!-- Upload de Arte -->
          <div>
            <label class="block text-xs uppercase tracking-wider text-ink-muted font-medium mb-2">
              2. Enviar Fotografia ou Arte
            </label>
            <label class="cursor-pointer min-h-11 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-surface-raised hover:bg-surface-hover border border-control text-ink-secondary text-xs font-semibold focus-within:outline focus-within:outline-2 focus-within:outline-accent">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span>Carregar Imagem (JPG ou PNG)</span>
              <input type="file" id="input-frame-art" accept="image/*" class="sr-only" />
            </label>
            <p id="art-filename" data-art-status role="status" class="text-xs text-accent mt-1 break-all"></p>
          </div>

          <fieldset>
            <legend class="mb-2 text-xs font-medium uppercase tracking-wider text-ink-muted">3. Orientação</legend>
            <div class="grid grid-cols-2 gap-2">
              {Object.entries(FRAME_ORIENTATIONS).map(([value, { label, widthCm, heightCm }]) => (
                <label class="relative cursor-pointer">
                  <input type="radio" name="frame-orientation" value={value} checked={value === 'portrait'} class="peer sr-only" />
                  <span class="flex min-h-11 flex-col items-center justify-center rounded-md border border-control px-1 py-1.5 text-xs font-semibold text-ink-secondary hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    {label}
                    <span class="text-[11px] font-normal">{widthCm} × {heightCm} cm</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-xs font-medium uppercase tracking-wider text-ink-muted">4. Margens de madeira</legend>
            <p class="mt-1 text-xs text-ink-muted">Medidas por lado, a partir da borda interna da moldura.</p>
            <div class="mt-2 grid grid-cols-2 gap-4">
              <div>
                <div class="flex flex-wrap justify-between gap-x-1 text-xs">
                  <label for="frame-margin-horizontal" class="font-medium text-ink-secondary">Horizontal</label>
                  <output id="frame-margin-horizontal-value" for="frame-margin-horizontal" class="text-accent">{FRAME_MARGINS.horizontal} cm</output>
                </div>
                <input type="range" id="frame-margin-horizontal" min={FRAME_MARGINS.min} max={FRAME_MARGINS.max} step={FRAME_MARGINS.step} value={FRAME_MARGINS.horizontal} class="h-8 w-full cursor-pointer accent-accent" />
              </div>
              <div>
                <div class="flex flex-wrap justify-between gap-x-1 text-xs">
                  <label for="frame-margin-vertical" class="font-medium text-ink-secondary">Vertical</label>
                  <output id="frame-margin-vertical-value" for="frame-margin-vertical" class="text-accent">{FRAME_MARGINS.vertical} cm</output>
                </div>
                <input type="range" id="frame-margin-vertical" min={FRAME_MARGINS.min} max={FRAME_MARGINS.max} step={FRAME_MARGINS.step} value={FRAME_MARGINS.vertical} class="h-8 w-full cursor-pointer accent-accent" />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend class="mb-2 text-xs font-medium uppercase tracking-wider text-ink-muted">5. Cor da moldura</legend>
            <div class="grid grid-cols-3 gap-2">
              {Object.entries(FRAME_COLORS).map(([value, { label, fill }]) => (
                <label class="relative cursor-pointer">
                  <input type="radio" name="frame-color" value={value} checked={value === 'black'} class="peer sr-only" />
                  <span class="flex min-h-11 flex-wrap items-center justify-center gap-x-1.5 rounded-md border border-control px-1 py-1 text-xs font-semibold text-ink-secondary hover:border-accent peer-checked:border-accent peer-checked:bg-accent/10 peer-checked:text-accent peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
                    <span aria-hidden="true" class="size-3.5 rounded-full border border-control" style={{ backgroundColor: fill }}></span>
                    {label}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Zoom da Arte -->
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <label for="slider-frame-scale" class="text-ink-secondary font-medium">6. Zoom da imagem</label>
              <span id="label-frame-scale" class="text-accent font-semibold">100%</span>
            </div>
            <input
              type="range"
              id="slider-frame-scale"
              min="50"
              max="250"
              value="100"
              disabled
              class="w-full accent-accent h-7 cursor-pointer disabled:opacity-50"
            />
          </div>

          <!-- Deslocamento Horizontal e Vertical -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="flex justify-between text-xs mb-1">
                <label for="slider-frame-x" class="text-ink-secondary">Recorte horizontal</label>
              </div>
              <input
                type="range"
                id="slider-frame-x"
                min="-300"
                max="300"
                value="0"
                disabled
                class="w-full accent-accent h-7 cursor-pointer disabled:opacity-50"
              />
            </div>
            <div>
              <div class="flex justify-between text-xs mb-1">
                <label for="slider-frame-y" class="text-ink-secondary">Recorte vertical</label>
              </div>
              <input
                type="range"
                id="slider-frame-y"
                min="-300"
                max="300"
                value="0"
                disabled
                class="w-full accent-accent h-7 cursor-pointer disabled:opacity-50"
              />
            </div>
          </div>

          <!-- Botão de Orçamento -->
          <div class="pt-4 border-t border-line space-y-3">
            <button
              id="btn-export-frame"
              type="button"
              class="w-full min-h-11 flex items-center justify-center gap-2 px-3 py-3 rounded-md bg-action hover:bg-action-hover text-on-action font-semibold text-sm disabled:opacity-50"
            >
              <span>Gerar prévia para orçamento</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>

            <p id="frame-export-status" role="status" class="text-center text-xs text-accent"></p>
            <a id="frame-whatsapp" data-whatsapp-quote hidden target="_blank" rel="noopener noreferrer" class="min-h-11 flex items-center justify-center rounded-md border border-accent px-3 text-sm font-semibold text-accent hover:bg-accent/10 [&[hidden]]:hidden">Abrir WhatsApp com a prévia ↗</a>
          </div>
        </div>

        <!-- Ficha Técnica do Quadro -->
        <div class="p-4 rounded-xl bg-canvas/60 border border-line text-xs text-ink-muted space-y-1.5">
          <p><span class="text-ink-secondary font-semibold">• Tamanho único:</span> 30 × 40 cm, em retrato ou paisagem</p>
          <p><span class="text-ink-secondary font-semibold">• Moldura:</span> Preta, branca ou marrom, com acabamento artesanal</p>
          <p><span class="text-ink-secondary font-semibold">• Impressão:</span> Sublimação direta sobre madeira clara, com veios visíveis</p>
          <p><span class="text-ink-secondary font-semibold">• Mockup:</span> O link da prévia será incluído na mensagem do WhatsApp.</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { FRAME_COLORS, FRAME_ORIENTATIONS, getFrameLayout } from '../../utils/frameLayout';
  import { loadArtwork, setupMockupQuote } from '../../utils/customizerClient';
  import { createWoodSurface, sublimateArtwork, WOOD_PROFILES } from '../../utils/woodSublimation';
  function initFrameCustomizer() {
    const stageCanvas = document.getElementById('frame-stage-canvas') as HTMLCanvasElement | null;
    const inputArt = document.getElementById('input-frame-art') as HTMLInputElement | null;
    const sliderScale = document.getElementById('slider-frame-scale') as HTMLInputElement | null;
    const sliderX = document.getElementById('slider-frame-x') as HTMLInputElement | null;
    const sliderY = document.getElementById('slider-frame-y') as HTMLInputElement | null;
    const labelScale = document.getElementById('label-frame-scale');
    const badgeEnv = document.getElementById('badge-environment-name');
    const artFilename = document.getElementById('art-filename');
    const btnExport = document.querySelector<HTMLButtonElement>('#btn-export-frame');
    const exportStatus = document.getElementById('frame-export-status');
    const quoteLink = document.querySelector<HTMLAnchorElement>('#frame-whatsapp');
    const marginHorizontal = document.querySelector<HTMLInputElement>('#frame-margin-horizontal');
    const marginVertical = document.querySelector<HTMLInputElement>('#frame-margin-vertical');
    const horizontalValue = document.getElementById('frame-margin-horizontal-value');
    const verticalValue = document.getElementById('frame-margin-vertical-value');
    const orientationOptions = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="frame-orientation"]'));
    const colorOptions = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="frame-color"]'));
    const measures = document.querySelectorAll('[data-frame-measure]');

    if (!stageCanvas || !marginHorizontal || !marginVertical) return;
    const ctx = stageCanvas.getContext('2d');
    if (!ctx) return;

    let currentEnv: 'living' | 'office' = 'living';
    let userArtImage: HTMLImageElement | null = null;
    let artScale = 1;
    const orientation = () => orientationOptions.find(option => option.checked)?.value === 'landscape' ? 'landscape' : 'portrait';
    const frameColor = () => FRAME_COLORS[colorOptions.find(option => option.checked)?.value as keyof typeof FRAME_COLORS] ?? FRAME_COLORS.black;
    const measure = () => {
      const { widthCm, heightCm } = FRAME_ORIENTATIONS[orientation()];
      return `${widthCm} × ${heightCm} cm`;
    };
    const marginText = (value: number) => `${value.toLocaleString('pt-BR')} cm`;
    const readLayout = () => getFrameLayout(orientation(), marginHorizontal.valueAsNumber, marginVertical.valueAsNumber);
    let layout = readLayout();
    let wood = createWoodSurface(layout.boardW, layout.boardH);
    let substrate: Uint8ClampedArray;
    const printCanvas = document.createElement('canvas');
    const printBuffer = printCanvas.getContext('2d', { willReadFrequently: true });
    if (!printBuffer) return;
    const printContext = printBuffer;
    const calibration = import.meta.env.DEV ? new URLSearchParams(location.search).get('textura') : null;
    const profile = calibration === 'suave' ? WOOD_PROFILES.suave
      : calibration === 'intensa' ? WOOD_PROFILES.intensa
      : WOOD_PROFILES.intermediaria;
    const environmentName = () => currentEnv === 'living' ? 'Sala Contemporânea' : 'Escritório Elegante';

    const preparePrint = () => {
      const { boardW, artW, artH, artLeft, artTop } = layout;
      printCanvas.width = artW;
      printCanvas.height = artH;
      substrate = new Uint8ClampedArray(artW * artH * 4);
      for (let row = 0; row < artH; row++) {
        const start = ((artTop + row) * boardW + artLeft) * 4;
        substrate.set(wood.data.subarray(start, start + artW * 4), row * artW * 4);
      }
      for (const label of measures) label.textContent = measure();
      stageCanvas.setAttribute('aria-label', `Prévia do quadro de ${measure()} no ambiente selecionado`);
      if (horizontalValue) horizontalValue.textContent = marginText(marginHorizontal.valueAsNumber);
      if (verticalValue) verticalValue.textContent = marginText(marginVertical.valueAsNumber);
    };

    function adjustPan(slider: HTMLInputElement | null, overflow: number) {
      if (!slider) return 0;
      const limit = Math.max(0, Math.floor(overflow / 2));
      slider.min = String(-limit);
      slider.max = String(limit);
      slider.disabled = limit === 0;
      return Number(slider.value);
    }

    // Renderiza a cena completa contextualizada
    function renderScene() {
      if (!ctx || !stageCanvas) return;
      const W = stageCanvas.width;
      const H = stageCanvas.height;

      // 1. Desenha o Ambiente de Fundo
      if (currentEnv === 'living') {
        // Sala Contemporânea
        // Parede grafite suave com iluminação pontual quente
        const grad = ctx.createRadialGradient(W * 0.5, H * 0.35, 100, W * 0.5, H * 0.5, W * 0.7);
        grad.addColorStop(0, '#b6a592');
        grad.addColorStop(0.5, '#857767');
        grad.addColorStop(1, '#5c5147');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        // Sofá e almofadas abaixo do quadro, com luz mais quente.
        ctx.save();
        ctx.shadowColor = '#352c2688';
        ctx.shadowBlur = 38;
        ctx.shadowOffsetY = -8;
        const upholstery = ctx.createLinearGradient(0, 866, 0, H);
        upholstery.addColorStop(0, '#d0bda6');
        upholstery.addColorStop(1, '#a99078');
        ctx.fillStyle = upholstery;
        ctx.beginPath();
        ctx.roundRect(200, 883, 1200, 287, 72);
        ctx.fill();
        ctx.restore();

        ctx.strokeStyle = '#8b7562';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(800, 907);
        ctx.lineTo(800, H);
        ctx.stroke();

        for (const [x, angle, color] of [[335, -0.12, '#6d7464'], [1195, 0.14, '#94674e']] as const) {
          ctx.save();
          ctx.translate(x, 970);
          ctx.rotate(angle);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.roundRect(-95, -76, 190, 175, 30);
          ctx.fill();
          ctx.restore();
        }
      } else {
        // Escritório Elegante
        // Parede sóbria com feixe de luz lateral
        const grad = ctx.createLinearGradient(0, 0, W, H);
        grad.addColorStop(0, '#677078');
        grad.addColorStop(0.6, '#3d454d');
        grad.addColorStop(1, '#282f36');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H);

        ctx.fillStyle = '#ffffff08';
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(360, 0);
        ctx.lineTo(755, 935);
        ctx.lineTo(320, 935);
        ctx.closePath();
        ctx.fill();

        // Mesa, luminária e livros como referências de ambiente.
        ctx.fillStyle = '#584232';
        ctx.fillRect(110, 942, 1380, 42);
        ctx.fillStyle = '#3d2c23';
        ctx.fillRect(155, 984, 1290, H - 984);
        ctx.fillStyle = '#9c8768';
        ctx.fillRect(110, 942, 1380, 4);

        ctx.fillStyle = '#2a2828';
        ctx.fillRect(280, 931, 143, 11);
        ctx.fillRect(344, 750, 10, 181);
        ctx.beginPath();
        ctx.moveTo(302, 710);
        ctx.lineTo(389, 710);
        ctx.lineTo(429, 778);
        ctx.lineTo(266, 778);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = '#687768';
        ctx.fillRect(1170, 910, 186, 32);
        ctx.fillStyle = '#d1bb9c';
        ctx.fillRect(1154, 884, 190, 26);
      }

      const { frameW, frameH, inset, boardW, boardH, artW, artH, artLeft, artTop } = layout;
      const frameX = (W - frameW) / 2;
      const frameY = Math.round(H * 0.18 + (Math.max(frameW, frameH) - frameH) / 2);
      const color = frameColor();

      // Sombra projetada realista na parede
      ctx.save();
      ctx.shadowColor = 'rgba(0, 0, 0, 0.65)';
      ctx.shadowBlur = 45;
      ctx.shadowOffsetX = 18;
      ctx.shadowOffsetY = 24;

      // Moldura Externa
      ctx.fillStyle = color.fill;
      ctx.fillRect(frameX, frameY, frameW, frameH);
      ctx.restore();

      // Borda da Moldura
      ctx.strokeStyle = color.edge;
      ctx.lineWidth = 4;
      ctx.strokeRect(frameX, frameY, frameW, frameH);

      const boardX = frameX + inset;
      const boardY = frameY + inset;
      ctx.putImageData(wood, boardX, boardY);
      ctx.strokeStyle = '#18161088';
      ctx.lineWidth = 3;
      ctx.strokeRect(boardX, boardY, boardW, boardH);

      printContext.clearRect(0, 0, artW, artH);
      if (userArtImage) {
        const baseScale = Math.max(artW / userArtImage.naturalWidth, artH / userArtImage.naturalHeight);
        const drawW = userArtImage.naturalWidth * baseScale * artScale;
        const drawH = userArtImage.naturalHeight * baseScale * artScale;
        const x = (artW - drawW) / 2 + adjustPan(sliderX, drawW - artW);
        const y = (artH - drawH) / 2 + adjustPan(sliderY, drawH - artH);
        printContext.drawImage(userArtImage, x, y, drawW, drawH);
      } else {
        printContext.fillStyle = '#24262b';
        printContext.fillRect(0, 0, artW, artH);

        printContext.strokeStyle = '#d3a64c';
        printContext.lineWidth = 3;
        printContext.beginPath();
        printContext.arc(artW / 2, artH * 0.42, artW * 0.22, 0, Math.PI * 2);
        printContext.stroke();

        printContext.fillStyle = '#e5c05d';
        printContext.beginPath();
        printContext.moveTo(artW * 0.27, artH * 0.67);
        printContext.lineTo(artW * 0.73, artH * 0.67);
        printContext.lineTo(artW * 0.5, artH * 0.48);
        printContext.closePath();
        printContext.fill();

        printContext.fillStyle = '#d5d0c5';
        printContext.font = '600 12px system-ui, sans-serif';
        printContext.textAlign = 'center';
        printContext.fillText('678 Estudio · ARTE DE EXEMPLO', artW / 2, artH * 0.85);
      }

      const print = printContext.getImageData(0, 0, artW, artH);
      sublimateArtwork(print.data, substrate, profile);
      ctx.putImageData(print, boardX + artLeft, boardY + artTop);
    }

    preparePrint();
    renderScene();

    const quote = btnExport && exportStatus && quoteLink
      ? setupMockupQuote(btnExport, exportStatus, quoteLink, () => ({
          imageBase64: stageCanvas.toDataURL('image/png'),
          productName: `Quadro Decorativo ${measure()}`,
          details: [
            `• Ambiente: *${environmentName()}*`,
            `• Orientação: ${FRAME_ORIENTATIONS[orientation()].label}`,
            `• Moldura: ${frameColor().label}`,
            `• Margem horizontal: ${marginText(marginHorizontal.valueAsNumber)} por lado`,
            `• Margem vertical: ${marginText(marginVertical.valueAsNumber)} por lado`,
            '• Sublimação em madeira clara',
          ].join('\n'),
        }))
      : undefined;

    const updateScene = () => {
      quote?.invalidate();
      renderScene();
    };

    const updateLayout = () => {
      const next = readLayout();
      if (next.boardW !== layout.boardW || next.boardH !== layout.boardH) {
        wood = createWoodSurface(next.boardW, next.boardH);
      }
      layout = next;
      preparePrint();
      if (sliderX) sliderX.value = '0';
      if (sliderY) sliderY.value = '0';
      updateScene();
    };
    for (const option of orientationOptions) option.addEventListener('change', updateLayout);
    for (const option of colorOptions) option.addEventListener('change', updateScene);
    marginHorizontal.addEventListener('input', updateLayout);
    marginVertical.addEventListener('input', updateLayout);

    function selectOption(selector: string, selected: HTMLButtonElement) {
      for (const button of document.querySelectorAll<HTMLButtonElement>(selector)) {
        const active = button === selected;
        button.setAttribute('aria-pressed', String(active));
        for (const style of ['border-accent', 'bg-accent/10', 'text-accent']) {
          button.classList.toggle(style, active);
        }
        for (const style of ['border-line', 'bg-canvas', 'text-ink-secondary']) {
          button.classList.toggle(style, !active);
        }
      }
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('.btn-env-select')) {
      button.addEventListener('click', () => {
        currentEnv = button.dataset.env === 'office' ? 'office' : 'living';
        selectOption('.btn-env-select', button);
        if (badgeEnv) badgeEnv.textContent = environmentName();
        updateScene();
      });
    }

    inputArt?.addEventListener('change', async () => {
      const file = inputArt.files?.[0];
      if (!file) return;
      quote?.invalidate();
      quote?.setArtworkPending(true);
      if (artFilename) artFilename.textContent = 'Carregando imagem…';

      try {
        const image = await loadArtwork(file);
        if (inputArt.files?.[0] !== file) return;
        userArtImage = image;
        artScale = 1;
        if (sliderScale) {
          sliderScale.value = '100';
          sliderScale.disabled = false;
        }
        if (sliderX) sliderX.value = '0';
        if (sliderY) sliderY.value = '0';
        if (labelScale) labelScale.textContent = '100%';
        if (artFilename) artFilename.textContent = file.name;
        updateScene();
      } catch {
        if (inputArt.files?.[0] === file && artFilename) {
          artFilename.textContent = 'Não foi possível abrir a imagem. A arte anterior foi mantida.';
        }
      } finally {
        if (inputArt.files?.[0] === file) {
          inputArt.value = '';
          quote?.setArtworkPending(false);
        }
      }
    });

    sliderScale?.addEventListener('input', () => {
      const zoom = Number(sliderScale.value);
      artScale = zoom / 100;
      if (labelScale) labelScale.textContent = zoom + '%';
      updateScene();
    });
    sliderX?.addEventListener('input', updateScene);
    sliderY?.addEventListener('input', updateScene);

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFrameCustomizer);
  } else {
    initFrameCustomizer();
  }
</script>
