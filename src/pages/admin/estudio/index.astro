---
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="Estúdio de Imagens | 678 Estudio">
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/admin" class="text-sm font-medium text-accent hover:underline">← Voltar ao painel</a>
    <h1 class="editorial-heading mt-4 text-4xl">Estúdio de Imagens</h1>
    <p class="mt-3 max-w-2xl text-sm text-ink-secondary">Escolha o tipo de mockup. Ajuste a composição, confira a prévia otimizada e salve-a diretamente em um produto do catálogo.</p>
    <div class="mt-6 grid max-w-2xl gap-4 sm:grid-cols-2">
      <a href="/admin/estudio/caneca" class="rounded-lg border border-line bg-surface p-5 font-semibold text-accent hover:border-accent">Mockup de Caneca →</a>
      <a href="/admin/estudio/quadro" class="rounded-lg border border-line bg-surface p-5 font-semibold text-accent hover:border-accent">Mockup de Quadro →</a>
    </div>
  </section>
</BaseLayout>
