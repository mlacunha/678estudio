---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/BrandMark.astro';
import { getAllCategories, getAllProducts } from '../../db/catalogRepository';
import { listAdminArtes } from '../../db/artLibraryRepository';
import {
  getStudioSettings,
  saveStudioSettings,
  STUDIO_FIELDS,
  validateStudioSettings,
  type StudioSettings,
} from '../../db/studioSettings';

export const prerender = false;

const storedSettings = await getStudioSettings();
Astro.locals.studioSettings = Promise.resolve(storedSettings);
let settings = storedSettings;
if (settings.whatsapp) settings = { ...settings, whatsapp: `+${settings.whatsapp}` };
let settingsErrors: Partial<Record<keyof StudioSettings, string>> = {};
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  if (!form || !STUDIO_FIELDS.every(field => typeof form.get(field) === 'string')) {
    return new Response('Formulário inválido.', { status: 400 });
  }
  for (const field of STUDIO_FIELDS) {
    const value = String(form.get(field)).trim();
    if (value.length > 254) return new Response('Campo muito longo.', { status: 400 });
    settings = { ...settings, [field]: value };
  }
  const result = validateStudioSettings(settings);
  settingsErrors = result.errors;
  if (Object.keys(settingsErrors).length === 0) {
    await saveStudioSettings(result.settings);
    return Astro.redirect('/admin?contatos=salvos#configuracoes-estudio', 303);
  }
  Astro.response.status = 422;
}

const [categories, products, publishedArtes] = await Promise.all([
  getAllCategories(),
  getAllProducts(),
  listAdminArtes({ status: 'published' }),
]);

const activeProductsCount = products.filter(p => p.isActive).length;
const featuredProductsCount = products.filter(p => p.isActive && p.isFeatured).length;
const activeCategoriesCount = categories.filter(c => c.isActive).length;
const homeCategoriesCount = categories.filter(c => c.isActive && c.showOnHome).length;

const fields = {
  whatsapp: { label: 'WhatsApp principal', type: 'tel', placeholder: '+55 (DDD) número' },
  instagram: { label: 'Instagram', type: 'url', placeholder: 'https://www.instagram.com/…' },
  facebook: { label: 'Facebook', type: 'url', placeholder: 'https://www.facebook.com/…' },
  email: { label: 'E-mail de contato', type: 'email', placeholder: '' },
} as const;
---

<BaseLayout title="Painel Administrativo | 678 Estudio" description="Central de administração do catálogo, pedidos, acervo e configurações do 678 Estudio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div class="flex items-center gap-3">
        <BrandMark class="size-9" />
        <div>
          <h1 class="text-2xl font-light text-ink tracking-wide">
            Painel <span class="font-normal text-accent">Administrativo</span>
          </h1>
          <p class="text-xs text-ink-muted mt-0.5">
            Central de gestão comercial, catálogo dinâmico, orçamentos e ferramentas do 678 Estudio
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/admin/produtos"
          class="inline-flex min-h-10 items-center gap-2 px-5 py-2 rounded-full bg-action hover:bg-action-hover text-on-action text-xs font-semibold tracking-wider uppercase motion-safe:transition-all shadow-sm"
        >
          Gerenciar Produtos
        </a>
        <a
          href="/admin/categorias"
          class="inline-flex min-h-10 items-center px-4 py-2 rounded-full border border-accent text-xs font-semibold text-accent hover:bg-accent/10"
        >
          Gerenciar Categorias
        </a>
        <a
          href="/"
          target="_blank"
          class="inline-flex min-h-10 items-center gap-1.5 px-4 py-2 rounded-full border border-control hover:border-ink-muted bg-surface text-ink-secondary text-xs font-medium motion-safe:transition-colors"
        >
          <span>Ver Vitrine Pública</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Summary Metrics -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/admin/produtos" class="p-4 rounded-xl bg-surface border border-line hover:border-accent/50 motion-safe:transition-colors">
        <span class="text-xs text-ink-muted">Produtos no Catálogo</span>
        <p class="text-2xl font-semibold text-ink mt-1">{products.length}</p>
        <span class="text-[11px] text-success font-medium">{activeProductsCount} publicados</span>
      </a>
      <a href="/admin/produtos?featured=featured" class="p-4 rounded-xl bg-surface border border-line hover:border-accent/50 motion-safe:transition-colors">
        <span class="text-xs text-ink-muted">Destaques na Home</span>
        <p class="text-2xl font-semibold text-accent mt-1">{featuredProductsCount}</p>
        <span class="text-[11px] text-ink-muted">Selecionados para vitrine</span>
      </a>
      <a href="/admin/categorias" class="p-4 rounded-xl bg-surface border border-line hover:border-accent/50 motion-safe:transition-colors">
        <span class="text-xs text-ink-muted">Categorias / Linhas</span>
        <p class="text-2xl font-semibold text-ink mt-1">{categories.length}</p>
        <span class="text-[11px] text-ink-muted">{activeCategoriesCount} ativas · {homeCategoriesCount} na Home</span>
      </a>
      <a href="/admin/artes" class="p-4 rounded-xl bg-surface border border-line hover:border-accent/50 motion-safe:transition-colors">
        <span class="text-xs text-ink-muted">Biblioteca de Artes</span>
        <p class="text-2xl font-semibold text-ink mt-1">{publishedArtes.length}</p>
        <span class="text-[11px] text-ink-muted">Estampas publicadas</span>
      </a>
    </div>

    <!-- Navigation Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- 1. Catálogo Comercial & Biblioteca -->
      <section aria-labelledby="sec-catalogo" class="rounded-2xl border border-line bg-surface p-5 sm:p-6 space-y-4">
        <div>
          <h2 id="sec-catalogo" class="text-base font-semibold text-ink">Catálogo Comercial &amp; Acervo</h2>
          <p class="text-xs text-ink-muted mt-0.5">
            Administre produtos, categorias, layouts da página inicial e estampas oficiais.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/admin/produtos" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Produtos</span>
              <p class="mt-1 text-xs text-ink-secondary">Busca, filtros, destaques, imagens e destinos.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Abrir módulo →</span>
          </a>

          <a href="/admin/categorias" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Categorias</span>
              <p class="mt-1 text-xs text-ink-secondary">Slugs, ordem, visibilidade na Home e layouts.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Abrir módulo →</span>
          </a>

          <a href="/admin/artes" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Biblioteca de Artes</span>
              <p class="mt-1 text-xs text-ink-secondary">Estampas para canecas, quadros e coleções.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Abrir módulo →</span>
          </a>
        </div>
      </section>

      <!-- 2. Pedidos e Orçamentos -->
      <section aria-labelledby="sec-pedidos" class="rounded-2xl border border-line bg-surface p-5 sm:p-6 space-y-4">
        <div>
          <h2 id="sec-pedidos" class="text-base font-semibold text-ink">Pedidos &amp; Orçamentos de Papelaria</h2>
          <p class="text-xs text-ink-muted mt-0.5">
            Consulte as solicitações enviadas pelos personalizadores e recupere os arquivos originais.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <a href="/admin/agendas" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-3.5 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold text-ink">Agendas</span>
              <p class="mt-1 text-[11px] text-ink-muted">Capas e miolos solicitados</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-accent">Ver pedidos →</span>
          </a>

          <a href="/admin/planners" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-3.5 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold text-ink">Planners</span>
              <p class="mt-1 text-[11px] text-ink-muted">Planner Essencial e Planner Harmonia</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-accent">Ver pedidos →</span>
          </a>

          <a href="/admin/cadernos" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-3.5 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold text-ink">Cadernos</span>
              <p class="mt-1 text-[11px] text-ink-muted">Receitas, Diário e Memórias</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-accent">Ver pedidos →</span>
          </a>

          <a href="/admin/calendarios" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-3.5 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold text-ink">Calendários</span>
              <p class="mt-1 text-[11px] text-ink-muted">Anual, Parede e Mesa</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-accent">Ver pedidos →</span>
          </a>
        </div>
      </section>

      <!-- 3. Portfólio & Ferramentas de Produção -->
      <section aria-labelledby="sec-producao" class="rounded-2xl border border-line bg-surface p-5 sm:p-6 space-y-4">
        <div>
          <h2 id="sec-producao" class="text-base font-semibold text-ink">Portfólio &amp; Ferramentas de Produção</h2>
          <p class="text-xs text-ink-muted mt-0.5">
            Fotografias reais do estúdio, composições de imagem e gerador local de mockups PSD.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/admin/trabalhos" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Trabalhos Realizados</span>
              <p class="mt-1 text-xs text-ink-secondary">Galeria Feito no Estúdio e destaques.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Gerenciar galeria →</span>
          </a>

          <a href="/admin/estudio" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Estúdio de Imagens</span>
              <p class="mt-1 text-xs text-ink-secondary">Ajuste rápido de mockups para produtos.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Abrir estúdio →</span>
          </a>

          <a href="/admin/mockups-comerciais" class="flex flex-col justify-between rounded-xl border border-line bg-canvas p-4 hover:border-accent motion-safe:transition-colors">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Mockups PSD</span>
              <p class="mt-1 text-xs text-ink-secondary">Ferramenta desktop para lotes comerciais.</p>
            </div>
            <span class="mt-3 text-xs font-semibold text-ink">Ver instruções →</span>
          </a>
        </div>
      </section>

      <!-- 4. Segurança & Backup -->
      <section aria-labelledby="sec-seguranca" class="rounded-2xl border border-line bg-surface p-5 sm:p-6 flex flex-col justify-between gap-4">
        <div>
          <h2 id="sec-seguranca" class="text-base font-semibold text-ink">Segurança, Backup &amp; Restauração</h2>
          <p class="text-xs text-ink-muted mt-0.5">
            Exporte cópias completas verificadas por hash SHA-256 (banco SQLite, pedidos, fotos e artes) ou restaure um pacote validado.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-canvas p-4">
          <div>
            <p class="text-xs font-semibold text-ink">Backup Completo do Estúdio (.zip)</p>
            <p class="text-[11px] text-ink-muted">Inclui catálogo dinâmico, categorias, produtos, orçamentos e mídias.</p>
          </div>
          <a
            href="/admin/backup"
            class="inline-flex min-h-10 items-center rounded-lg bg-action px-4 text-xs font-semibold text-on-action hover:bg-action-hover"
          >
            Gerenciar Backups →
          </a>
        </div>
      </section>
    </div>

    <!-- Studio Contact & Social Settings -->
    <section id="configuracoes-estudio" aria-labelledby="studio-settings-title" class="scroll-mt-24 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2 pb-4 border-b border-line">
        <div>
          <h2 id="studio-settings-title" class="text-sm font-semibold text-ink tracking-wide">Contatos e Redes Sociais</h2>
          <p class="text-xs text-ink-muted mt-0.5">Deixe um campo em branco para ocultar o canal no site.</p>
        </div>
        {Astro.url.searchParams.get('contatos') === 'salvos' && (
          <p role="status" class="text-xs font-semibold text-success">Alterações salvas.</p>
        )}
      </div>

      <form method="post" class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        {STUDIO_FIELDS.map(name => {
          const field = fields[name];
          const errorId = `erro-${name}`;
          return (
            <div>
              <label for={`studio-${name}`} class="block text-ink-muted mb-1 font-medium">{field.label}</label>
              <input
                id={`studio-${name}`}
                name={name}
                type={field.type}
                value={settings[name]}
                placeholder={field.placeholder}
                aria-invalid={settingsErrors[name] ? 'true' : undefined}
                aria-describedby={settingsErrors[name] ? errorId : undefined}
                class="min-h-11 w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink placeholder:text-ink-muted focus:border-accent"
              />
              {settingsErrors[name] && <p id={errorId} class="mt-1 text-xs text-danger">{settingsErrors[name]}</p>}
            </div>
          );
        })}
        <div class="md:col-span-2 flex justify-end pt-2">
          <button type="submit" class="min-h-11 px-5 rounded-md bg-action hover:bg-action-hover text-on-action text-xs font-semibold uppercase tracking-wider">
            Salvar contatos
          </button>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>
