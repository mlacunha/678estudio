---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/BrandMark.astro';
import { getAllCategories, getAllProducts } from '../../db/catalogRepository';
import { getStudioSettings, saveStudioSettings, STUDIO_FIELDS, validateStudioSettings, type StudioSettings } from '../../db/studioSettings';

export const prerender = false;

const storedSettings = await getStudioSettings();
Astro.locals.studioSettings = Promise.resolve(storedSettings);
let settings = storedSettings;
if (settings.whatsapp) settings = { ...settings, whatsapp: `+${settings.whatsapp}` };
let settingsErrors: Partial<Record<keyof StudioSettings, string>> = {};
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  if (!form || !STUDIO_FIELDS.every(field => typeof form.get(field) === 'string')) {
    return new Response('Formulário inválido.', { status: 400 });
  }
  for (const field of STUDIO_FIELDS) {
    const value = String(form.get(field)).trim();
    if (value.length > 254) return new Response('Campo muito longo.', { status: 400 });
    settings = { ...settings, [field]: value };
  }
  const result = validateStudioSettings(settings);
  settingsErrors = result.errors;
  if (Object.keys(settingsErrors).length === 0) {
    await saveStudioSettings(result.settings);
    return Astro.redirect('/admin?contatos=salvos#configuracoes-estudio', 303);
  }
  Astro.response.status = 422;
}

const [categories, products] = await Promise.all([getAllCategories(), getAllProducts()]);
const fields = {
  whatsapp: { label: 'WhatsApp principal', type: 'tel', placeholder: '+55 (DDD) número' },
  instagram: { label: 'Instagram', type: 'url', placeholder: 'https://www.instagram.com/…' },
  facebook: { label: 'Facebook', type: 'url', placeholder: 'https://www.facebook.com/…' },
  email: { label: 'E-mail de contato', type: 'email', placeholder: '' },
} as const;
---

<BaseLayout title="Painel Administrativo | 678 Estudio" description="Gestão de catálogo e produtos do 678 Estudio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-line">
      <div>
        <div class="flex items-center gap-2">
          <BrandMark class="size-9" />
          <h1 class="text-2xl sm:text-3xl font-light text-ink">
            Painel do <span class="font-normal text-accent">Catálogo</span>
          </h1>
        </div>
        <p class="mt-1 text-xs text-ink-muted">
          Gerencie produtos, visibilidade, ordenação e imagens em tempo real sem rebuild do site.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a href="/admin/trabalhos" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Trabalhos Realizados
        </a>
        <a href="/admin/estudio" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Estúdio de Imagens
        </a>
        <a href="/admin/agendas" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Solicitações de agendas
        </a>
        <a href="/admin/planners" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Solicitações de planners
        </a>
        <a href="/admin/backup" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Backup
        </a>
        <button
          id="btn-open-new-product"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-action hover:bg-action-hover text-on-action font-semibold text-xs uppercase tracking-wider motion-safe:transition-all shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Novo Produto</span>
        </button>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full border border-control hover:border-ink-muted bg-surface text-ink-secondary text-xs font-medium motion-safe:transition-colors"
        >
          <span>Ver Site</span>
        </a>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-8">
      <div class="p-4 rounded-xl bg-surface border border-line">
        <p class="text-xs uppercase tracking-wider text-ink-muted">Total de Produtos</p>
        <p class="text-2xl font-bold text-ink mt-1">{products.length}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-line">
        <p class="text-xs uppercase tracking-wider text-ink-muted">Produtos Ativos</p>
        <p class="text-2xl font-bold text-accent mt-1">{products.filter((p) => p.isActive).length}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-line">
        <p class="text-xs uppercase tracking-wider text-ink-muted">Produtos Ocultos</p>
        <p class="text-2xl font-bold text-ink-muted mt-1">{products.filter((p) => !p.isActive).length}</p>
      </div>
      <div class="p-4 rounded-xl bg-surface border border-line">
        <p class="text-xs uppercase tracking-wider text-ink-muted">Linhas / Categorias</p>
        <p class="text-2xl font-bold text-ink mt-1">{categories.length}</p>
      </div>
    </div>

    <section id="configuracoes-estudio" aria-labelledby="studio-settings-title" class="mb-8 scroll-mt-24 rounded-2xl border border-line bg-surface p-4 sm:p-6">
      <h2 id="studio-settings-title" class="text-base font-semibold text-ink">Configurações do Estúdio</h2>
      <p id="studio-settings-help" class="mt-2 text-sm text-ink-muted">
        O WhatsApp principal recebe todos os pedidos de orçamento. Informe o código do país e o DDD. Deixe um campo em branco para desativar o canal.
      </p>
      {Astro.request.method === 'GET' && Astro.url.searchParams.get('contatos') === 'salvos' && (
        <p role="status" class="mt-3 text-sm font-medium text-success">Configurações salvas.</p>
      )}
      <form method="post" action="/admin#configuracoes-estudio" class="mt-4" aria-describedby="studio-settings-help">
        <div class="grid gap-4 sm:grid-cols-2">
          {STUDIO_FIELDS.map(field => (
            <div>
              <label for={`studio-${field}`} class="mb-1.5 block text-sm font-medium text-ink-secondary">{fields[field].label}</label>
              <input
                id={`studio-${field}`} name={field} type={fields[field].type}
                value={settings[field]} placeholder={fields[field].placeholder} maxlength="254"
                aria-invalid={settingsErrors[field] ? 'true' : undefined}
                aria-describedby={settingsErrors[field] ? `studio-${field}-error` : undefined}
                class="min-h-11 w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink placeholder:text-ink-muted focus:border-accent"
              />
              {settingsErrors[field] && <p id={`studio-${field}-error`} class="mt-1 text-xs text-danger">{settingsErrors[field]}</p>}
            </div>
          ))}
        </div>
        <button type="submit" class="mt-4 min-h-11 rounded-md bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover">
          Salvar configurações
        </button>
      </form>
    </section>

    <!-- Products Table -->
    <div class="rounded-2xl border border-line bg-surface overflow-hidden shadow-xl">
      <div class="px-4 sm:px-6 py-4 border-b border-line flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-base font-semibold text-ink">Produtos Cadastrados</h2>
        <span class="text-xs text-ink-muted">Armazenamento: SQLite Local</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-ink-secondary">
          <thead class="bg-canvas/80 text-[11px] uppercase tracking-wider text-ink-muted border-b border-line">
            <tr>
              <th class="px-6 py-3.5">Imagem</th>
              <th class="px-6 py-3.5">Nome & Descrição</th>
              <th class="px-6 py-3.5">Categoria</th>
              <th class="px-6 py-3.5 text-center">Ordem</th>
              <th class="px-6 py-3.5 text-center">Status</th>
              <th class="px-6 py-3.5 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line/60">
            {products.length === 0 && (
              <tr><td colspan="6" class="px-6 py-8 text-center text-ink-muted">Nenhum produto cadastrado.</td></tr>
            )}
            {products.map((prod) => (
              <tr class="hover:bg-surface-muted/40 motion-safe:transition-colors">
                <td class="px-6 py-3.5">
                  <img
                    src={prod.imageUrl}
                    alt={prod.name}
                    class="w-12 h-12 object-cover rounded-lg border border-line bg-canvas"
                  />
                </td>
                <td class="px-6 py-3.5 max-w-xs">
                  <p class="font-semibold text-ink text-sm">{prod.name}</p>
                  <p class="text-[11px] text-ink-muted truncate mt-0.5">{prod.tagline}</p>
                </td>
                <td class="px-6 py-3.5">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-medium uppercase tracking-wider bg-surface-raised text-accent border border-accent/20">
                    {prod.categorySlug}
                  </span>
                </td>
                <td class="px-6 py-3.5 text-center font-semibold text-ink-secondary">
                  {prod.order}
                </td>
                <td class="px-6 py-3.5 text-center">
                  <button
                    type="button"
                    class="btn-toggle-active px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase motion-safe:transition-colors"
                    class:list={[
                      prod.isActive
                        ? "bg-success-surface text-success border border-success/30 hover:bg-success-hover"
                        : "bg-surface-raised text-ink-muted border border-control hover:bg-surface-hover",
                    ]}
                    data-id={prod.id}
                    data-current={prod.isActive ? "true" : "false"}
                  >
                    {prod.isActive ? "Publicado" : "Oculto"}
                  </button>
                </td>
                <td class="px-6 py-3.5 text-right space-x-2">
                  <button
                    type="button"
                    class="btn-edit-product text-ink-muted hover:text-accent font-medium motion-safe:transition-colors"
                    data-product={JSON.stringify(prod)}
                  >
                    Editar
                  </button>
                  <button
                    type="button"
                    class="btn-delete-product text-danger hover:underline font-medium"
                    data-id={prod.id}
                    data-name={prod.name}
                  >
                    Excluir
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Product Modal / Drawer Form -->
    <div id="product-modal" class="fixed inset-0 z-[60] bg-scrim/60 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-surface border border-line rounded-2xl w-full max-w-xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-line">
          <h3 id="modal-title" class="text-lg font-semibold text-ink">Novo Produto</h3>
          <button id="btn-close-modal" class="text-ink-muted hover:text-ink p-1 text-xl leading-none">&times;</button>
        </div>

        <form id="product-form" class="mt-5 space-y-4 text-xs">
          <input type="hidden" id="form-product-id" name="id" />

          <div>
            <label class="block text-ink-muted mb-1 font-medium">Nome do Produto *</label>
            <input
              type="text"
              id="form-name"
              name="name"
              required
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Ex: Caneca Branca Signature"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-ink-muted mb-1 font-medium">Categoria *</label>
              <select
                id="form-category"
                name="categorySlug"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              >
                {categories.map((c) => (
                  <option value={c.slug}>{c.title}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-ink-muted mb-1 font-medium">Ordem de Exibição</label>
              <input
                type="number"
                id="form-order"
                name="order"
                value="1"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              />
            </div>
          </div>

          <div>
            <label class="block text-ink-muted mb-1 font-medium">Subtítulo / Linha de Destaque</label>
            <input
              type="text"
              id="form-tagline"
              name="tagline"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Ex: Cerâmica alva com faixa 20 x 9 cm"
            />
          </div>

          <div>
            <label class="block text-ink-muted mb-1 font-medium">Descrição Completa</label>
            <textarea
              id="form-description"
              name="description"
              rows="3"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Descreva materiais, acabamentos e especificações..."
            ></textarea>
          </div>

          <div>
            <label class="block text-ink-muted mb-1 font-medium">Selo / Badge Especial (opcional)</label>
            <input
              type="text"
              id="form-badge"
              name="featuredBadge"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Ex: Destaque, Mais Vendido, Exclusivo"
            />
          </div>

          <div>
            <label class="block text-ink-muted mb-1 font-medium">Imagem do Produto *</label>
            <div class="flex items-center gap-3">
              <input
                type="text"
                id="form-image-url"
                name="imageUrl"
                required
                class="min-w-0 flex-1 px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="/images/demo/... ou /uploads/..."
              />
              <label class="cursor-pointer px-4 py-2.5 rounded-lg bg-surface-raised hover:bg-surface-hover text-ink-secondary font-semibold motion-safe:transition-colors flex items-center gap-1.5 focus-within:outline focus-within:outline-2 focus-within:outline-accent">
                <span>Upload</span>
                <input type="file" id="form-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" />
              </label>
            </div>
            <p id="upload-status" role="status" class="text-[11px] text-accent mt-1 hidden"></p>
          </div>

          <div class="pt-4 border-t border-line flex items-center justify-end gap-3">
            <button
              type="button"
              id="btn-cancel-modal"
              class="px-4 py-2 rounded-lg border border-control text-ink-secondary hover:bg-surface-raised"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-save-product"
              class="px-6 py-2 rounded-lg bg-action hover:bg-action-hover text-on-action font-bold tracking-wide"
            >
              Salvar Produto
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  function setupAdminDashboard() {
    const modal = document.getElementById('product-modal');
    const openBtn = document.getElementById('btn-open-new-product');
    const closeBtn = document.getElementById('btn-close-modal');
    const cancelBtn = document.getElementById('btn-cancel-modal');
    const form = document.getElementById('product-form') as HTMLFormElement | null;
    const modalTitle = document.getElementById('modal-title');
    const fileInput = document.getElementById('form-file-input') as HTMLInputElement | null;
    const imageUrlInput = document.getElementById('form-image-url') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status');

    function openModal(isEdit = false) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalTitle) modalTitle.textContent = isEdit ? 'Editar Produto' : 'Novo Produto';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (form) form.reset();
      const idInput = document.getElementById('form-product-id') as HTMLInputElement | null;
      if (idInput) idInput.value = '';
      if (uploadStatus) uploadStatus.classList.add('hidden');
    }

    openBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Toggle publicação / visibilidade
    document.querySelectorAll('.btn-toggle-active').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-id');
        const current = button.getAttribute('data-current') === 'true';
        if (!id) return;

        const response = await fetch(`/api/products/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toggleActive: !current }),
        });

        if (response.ok) {
          window.location.reload();
        }
      });
    });

    // Exclusão com confirmação nativa
    document.querySelectorAll('.btn-delete-product').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        if (!id) return;

        const confirmed = window.confirm(`Deseja realmente excluir o produto "${name}"?`);
        if (!confirmed) return;

        const response = await fetch(`/api/products/${id}`, { method: 'DELETE' });
        if (response.ok) {
          window.location.reload();
        }
      });
    });

    // Edição de produto
    document.querySelectorAll('.btn-edit-product').forEach((button) => {
      button.addEventListener('click', () => {
        const dataStr = button.getAttribute('data-product');
        if (!dataStr) return;
        const prod = JSON.parse(dataStr);

        (document.getElementById('form-product-id') as HTMLInputElement).value = prod.id;
        (document.getElementById('form-name') as HTMLInputElement).value = prod.name;
        (document.getElementById('form-category') as HTMLSelectElement).value = prod.categorySlug;
        (document.getElementById('form-order') as HTMLInputElement).value = prod.order;
        (document.getElementById('form-tagline') as HTMLInputElement).value = prod.tagline || '';
        (document.getElementById('form-description') as HTMLTextAreaElement).value = prod.description || '';
        (document.getElementById('form-badge') as HTMLInputElement).value = prod.featuredBadge || '';
        (document.getElementById('form-image-url') as HTMLInputElement).value = prod.imageUrl;

        openModal(true);
      });
    });

    // Upload de Imagem local
    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file || !uploadStatus) return;

      uploadStatus.textContent = 'Enviando imagem...';
      uploadStatus.classList.remove('hidden');

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success && imageUrlInput) {
          imageUrlInput.value = data.url;
          uploadStatus.textContent = 'Imagem enviada com sucesso!';
        } else {
          uploadStatus.textContent = 'Erro ao enviar imagem.';
        }
      } catch {
        uploadStatus.textContent = 'Erro de conexão no upload.';
      }
    });

    // Submissão do Formulário
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('form-product-id') as HTMLInputElement).value;
      const payload = {
        id: id || undefined,
        name: (document.getElementById('form-name') as HTMLInputElement).value,
        categorySlug: (document.getElementById('form-category') as HTMLSelectElement).value,
        order: Number((document.getElementById('form-order') as HTMLInputElement).value),
        tagline: (document.getElementById('form-tagline') as HTMLInputElement).value,
        description: (document.getElementById('form-description') as HTMLTextAreaElement).value,
        featuredBadge: (document.getElementById('form-badge') as HTMLInputElement).value,
        imageUrl: (document.getElementById('form-image-url') as HTMLInputElement).value,
      };

      const url = id ? `/api/products/${id}` : '/api/products';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        closeModal();
        window.location.reload();
      }
    });
  }

  setupAdminDashboard();
</script>
