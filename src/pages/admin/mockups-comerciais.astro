---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mugMockups } from '../../server/mockups/options.mjs';

export const prerender = false;
---

<BaseLayout title="Mockups de Canecas | Administração 678 Estudio">
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="border-b border-line pb-5">
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">← Voltar ao painel</a>
      <h1 class="mt-3 text-3xl font-semibold text-ink">Mockups de Canecas</h1>
      <p class="mt-2 text-sm text-ink-secondary">Envie uma arte e selecione as cenas para gerar imagens em resolução original.</p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <form id="mug-mockup-form" class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5"
        action="/admin/mockups-comerciais/render" method="post" enctype="multipart/form-data">
        <fieldset id="mug-mockup-fields" class="min-w-0 space-y-5">
          <div class="space-y-2">
            <label for="mug-artwork" class="block text-sm font-semibold text-ink">Arte</label>
            <input id="mug-artwork" name="artwork" type="file" required accept="image/png,image/jpeg,image/webp"
              class="w-full min-w-0 text-sm text-ink-secondary file:mr-2 file:rounded-lg file:border-0 file:bg-surface-muted file:px-3 file:py-2"
              aria-describedby="mug-artwork-help" />
            <p id="mug-artwork-help" class="text-xs text-ink-muted">PNG, JPEG ou WebP estático · Até 8 MB e 16 megapixels.</p>
          </div>

          <fieldset class="space-y-2">
            <legend class="mb-2 text-sm font-semibold text-ink">Modelos</legend>
            {mugMockups.map((model) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-control px-3 py-2 text-sm">
                <input name="model" type="checkbox" value={model.id} data-label={model.label} checked class="size-4 shrink-0 accent-accent" />
                <span>{model.label}</span>
              </label>
            ))}
          </fieldset>

          <button class="min-h-11 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:opacity-50" type="submit">
            Gerar mockups
          </button>
        </fieldset>
        <p id="mug-mockup-error" role="alert" class="mt-3 text-sm text-danger" hidden></p>
      </form>

      <section class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5" aria-labelledby="mug-results-title">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="mug-results-title" class="text-lg font-semibold text-ink">Resultados</h2>
          <button id="mug-download-zip" type="button" hidden class="min-h-11 rounded-lg border border-control px-4 text-sm font-semibold hover:border-accent disabled:opacity-50">
            Baixar todos em ZIP
          </button>
        </div>
        <p id="mug-mockup-status" role="status" class="mt-2 text-sm text-ink-secondary">Os mockups gerados aparecerão aqui.</p>
        <div id="mug-mockup-results" class="mt-4 grid gap-4 sm:grid-cols-2"></div>
      </section>
    </div>
  </main>

  <template id="mug-mockup-result">
    <figure class="min-w-0 overflow-hidden rounded-xl border border-line bg-canvas">
      <img class="block aspect-square w-full bg-white object-contain" decoding="async" alt="" />
      <figcaption class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 p-3">
        <span class="text-sm font-semibold text-ink"></span>
        <a class="inline-flex min-h-11 items-center text-sm font-semibold text-accent hover:underline">Baixar PNG</a>
      </figcaption>
    </figure>
  </template>
</BaseLayout>

<script>
  import { initMugMockupAdmin } from '../../scripts/mugMockupAdmin';
  initMugMockupAdmin();
</script>
