---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MugAdjustment from '../../components/admin/MugAdjustment.astro';
import { mugMockups } from '../../server/mockups/options.mjs';
import { getMugInstances } from '../../server/mockups/manifest.mjs';

export const prerender = false;
const models = await Promise.all(mugMockups.map(async model => ({
  ...model, instances: await getMugInstances(model.id),
})));
---

<BaseLayout title="Mockups de Canecas | Administração 678 Estudio">
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="border-b border-line pb-5">
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">← Voltar ao painel</a>
      <h1 class="mt-3 text-3xl font-semibold text-ink">Mockups de Canecas</h1>
      <p class="mt-2 text-sm text-ink-secondary">Escolha um modelo, ajuste as artes nos recortes e gere a foto do mockup.</p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
      <form id="mug-mockup-form" class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5"
        action="/admin/mockups-comerciais/render" method="post" enctype="multipart/form-data">
        <fieldset id="mug-mockup-fields" class="min-w-0 space-y-5">
          <label class="block space-y-1 text-sm font-semibold text-ink">
            <span>Modelo</span>
            <select id="mug-model" name="model" class="block min-h-11 w-full rounded-lg border border-control bg-canvas px-2">
              {models.map(model => (
                <option value={model.id} data-label={model.label} data-instances={JSON.stringify(model.instances)}
                  data-ratio={`${model.width} / ${model.height}`}>{model.label}</option>
              ))}
            </select>
          </label>
          <div class="space-y-2">
            <label for="mug-artwork" class="block text-sm font-semibold text-ink">Arte para todos os espaços</label>
            <input id="mug-artwork" name="artwork" type="file" accept="image/png,image/jpeg,image/webp"
              class="w-full min-w-0 text-sm text-ink-secondary file:mr-2 file:rounded-lg file:border-0 file:bg-surface-muted file:px-3 file:py-2"
              aria-describedby="mug-artwork-help" />
            <div class="flex flex-wrap gap-2">
              <button type="button" data-all-library class="min-h-11 rounded-lg border border-control px-3 text-xs">Biblioteca (todos os espaços)</button>
              <button type="button" data-distribute class="min-h-11 rounded-lg border border-control px-3 text-xs">Distribuir automaticamente (Esq. / Centro / Dir.)</button>
            </div>
            <p id="mug-artwork-help" class="text-xs text-ink-muted">PNG, JPEG ou WebP estático · Até 8 MB e 16 megapixels.</p>
          </div>

          <details>
            <summary class="min-h-10 cursor-pointer text-sm font-semibold text-ink">Ajustes gerais da arte</summary>
          <fieldset id="mug-global-placement" class="space-y-3 border-t border-line pt-4">
            <legend class="pr-2 text-base font-semibold text-ink">Ajustar arte</legend>
            <label class="block space-y-1 text-sm">
              <span>Modo de encaixe</span>
              <select id="mug-fit" class="min-h-11 w-full rounded-lg border border-control bg-canvas px-2">
                <option value="original">Ajuste original</option>
                <option value="contain">Conter</option>
                <option value="cover">Preencher</option>
                <option value="manual">Manual</option>
              </select>
            </label>
            <div id="mug-art-frame" tabindex="0" role="group" aria-label="Área útil de 20 × 9 cm" aria-describedby="mug-frame-help"
              class="relative aspect-[20/9] touch-none cursor-grab select-none overflow-hidden rounded-lg border border-control bg-white focus-visible:outline-accent active:cursor-grabbing">
              <p id="mug-frame-empty" class="pointer-events-none absolute inset-0 grid place-items-center px-2 text-center text-xs text-slate-600">A arte aparecerá aqui.</p>
              <img id="mug-frame-art" hidden alt="" draggable="false" class="pointer-events-none absolute max-w-none" />
              <div aria-hidden="true" class="pointer-events-none absolute inset-1 rounded border border-dashed border-slate-500/60"></div>
            </div>
            <p id="mug-frame-help" class="text-xs text-ink-muted">Área útil de 20 × 9 cm. Arraste, use as setas ou ajuste pelos controles. No ajuste original, vale a prévia de cada modelo. A faixa e os papéis têm controles próprios.</p>
            <MugAdjustment />
            <div class="flex flex-wrap gap-2">
              {[
                ['original', 'Ajuste original'], ['center', 'Centralizar'], ['contain', 'Conter arte'],
                ['cover', 'Preencher área'], ['zoom', 'Zoom 100%'], ['reset', 'Redefinir enquadramento'],
              ].map(([id, label]) => (
                <button type="button" data-preset={id} class="min-h-10 rounded-lg border border-control px-2 text-xs font-medium hover:border-accent">{label}</button>
              ))}
            </div>
          </fieldset>
          </details>

          <div id="mug-mockup-results" class="grid gap-4"></div>
          <button id="mug-generate" class="min-h-11 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:opacity-50" type="submit">
            Gerar foto do mockup
          </button>
        </fieldset>
        <p id="mug-mockup-error" role="alert" class="mt-3 text-sm text-danger" hidden></p>
      </form>

      <section class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5" aria-labelledby="mug-results-title">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="mug-results-title" class="text-lg font-semibold text-ink">Resultado</h2>
          <label class="flex items-center gap-2 text-sm">
            Formato
            <select id="mug-export-format" class="min-h-11 rounded-lg border border-control bg-canvas px-2">
              <option value="png">PNG</option>
              <option value="jpeg">JPEG</option>
              <option value="webp">WebP</option>
            </select>
          </label>
          <button id="mug-download-zip" type="button" hidden class="min-h-11 rounded-lg border border-control px-4 text-sm font-semibold hover:border-accent disabled:opacity-50">
            Baixar ZIP
          </button>
        </div>
        <p id="mug-mockup-status" role="status" class="mt-2 text-sm text-ink-secondary">A foto do modelo selecionado aparecerá aqui.</p>
        <div id="mug-rendered-photo" class="mt-4">
          <img id="mug-result-image" hidden alt="" class="w-full rounded-lg bg-white" decoding="async" />
          <button id="mug-result-download" type="button" hidden class="mt-3 min-h-11 rounded-lg bg-action px-4 text-sm font-semibold text-on-action">Baixar PNG</button>
        </div>
      </section>
    </div>
  </main>

  <dialog id="mug-library" class="w-[min(90vw,32rem)] rounded-xl border border-line bg-surface p-4 text-ink backdrop:bg-black/40">
    <div class="space-y-3">
      <h2 class="text-lg font-semibold">Biblioteca de artes</h2>
      <label class="block text-sm">Arte
        <select data-library-choice class="block min-h-11 w-full rounded-lg border border-control bg-canvas px-2"></select>
      </label>
      <p data-library-status role="status" class="text-sm text-ink-secondary"></p>
      <div class="flex gap-2">
        <button type="button" data-library-apply class="min-h-11 rounded-lg bg-action px-3 text-sm text-on-action">Usar arte</button>
        <form method="dialog"><button class="min-h-11 rounded-lg border border-control px-3 text-sm">Fechar</button></form>
      </div>
    </div>
  </dialog>

  <template id="mug-mockup-result">
    <article class="min-w-0 overflow-hidden rounded-xl border border-line bg-canvas">
      <div class="space-y-2 p-3">
          <fieldset data-instance-controls class="space-y-3">
            <legend class="sr-only">Recortes das canecas</legend>
            <p class="text-xs text-ink-muted">Arraste a arte dentro de cada recorte ou use as setas. O recorte muda na hora.</p>
            <div data-mug-editors class="grid gap-3 sm:grid-cols-2"></div>

          </fieldset>
        <details class="border-t border-line pt-1">
          <summary class="flex min-h-10 cursor-pointer items-center text-sm font-semibold text-accent">Ajustar este modelo</summary>
          <fieldset data-local class="space-y-2">
            <legend class="sr-only">Correções relativas ao enquadramento global</legend>
            <MugAdjustment local />
            <div class="flex flex-wrap gap-2">
              <button type="button" data-local-reset class="min-h-10 rounded-lg border border-control px-2 text-xs">Restaurar este modelo</button>
              <button type="button" data-local-apply class="min-h-10 rounded-lg border border-control px-2 text-xs">Aplicar globais novamente</button>
              <button type="button" data-local-render class="min-h-10 rounded-lg border border-control px-2 text-xs font-semibold">Atualizar prévia</button>
            </div>
          </fieldset>
        </details>
      </div>
    </article>
  </template>

  <template id="mug-instance-editor">
    <section class="min-w-0 space-y-2 rounded-xl border border-line bg-surface p-3">
      <h4 class="text-sm font-semibold text-ink"></h4>
      <div data-slot-surface tabindex="0" role="group"
        class="relative touch-none cursor-grab select-none overflow-hidden rounded-lg border border-control bg-white focus-visible:outline-accent active:cursor-grabbing">
        <div data-slot-clip class="pointer-events-none absolute overflow-hidden">
          <img data-slot-art alt="" draggable="false" class="absolute max-w-none" />
        </div>
      </div>
      <div class="flex flex-wrap items-end gap-2">
        <label class="min-w-28 flex-1 text-xs text-ink-secondary">
          Encaixe
          <select data-slot-fit class="mt-1 min-h-11 w-full rounded-lg border border-control bg-canvas px-2 text-sm">
            <option value="">Do modelo</option><option value="contain">Conter</option><option value="cover">Preencher</option>
          </select>
        </label>
        <button type="button" data-mug-center class="min-h-11 rounded-lg border border-control px-2 text-xs">Centralizar</button>
        <button type="button" data-mug-reset class="min-h-11 rounded-lg border border-control px-2 text-xs">Restaurar</button>
      </div>
      <MugAdjustment />
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" data-slot-library class="min-h-11 rounded-lg border border-control px-2 text-xs">Biblioteca</button>
        <label class="block min-w-0 flex-1 text-xs text-ink-secondary">
          <span class="sr-only">Arte deste espaço</span>
          <input data-slot-upload type="file" accept="image/png,image/jpeg,image/webp" class="w-full text-xs" />
        </label>
      </div>
      <button type="button" data-slot-clear hidden class="min-h-10 text-xs font-semibold text-accent">Usar arte geral novamente</button>
    </section>
  </template>
</BaseLayout>

<style>
  [hidden] { display: none; }
</style>

<script>
  import { initMugMockupAdmin } from '../../scripts/mugMockupAdmin';
  initMugMockupAdmin();
</script>
