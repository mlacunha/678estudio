---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/BrandMark.astro';

export const prerender = false;
const currentOrigin = Astro.url.origin;
const rawInstallerUrl = (process.env.MOCKUP_INSTALLER_URL ?? '').trim();
const installerUrl = /^https:\/\/\S+$/i.test(rawInstallerUrl) ? rawInstallerUrl : '';
const installerVersion = (process.env.MOCKUP_INSTALLER_VERSION ?? '1.0.0').trim() || '1.0.0';
const rawNotesUrl = (process.env.MOCKUP_INSTALLER_NOTES_URL ?? '').trim();
const notesUrl = /^https:\/\/\S+$/i.test(rawNotesUrl) ? rawNotesUrl : '';
---

<BaseLayout title="Mockups Comerciais | Administração 678 Estudio" description="Acesso e instruções do gerador local de mockups comerciais PSD">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-line">
      <div class="flex items-center gap-3">
        <BrandMark class="size-9" />
        <div>
          <h1 class="text-2xl font-light text-ink">
            Mockups <span class="font-normal text-accent">Comerciais</span>
          </h1>
          <p class="text-xs text-ink-muted">
            Gerador local de imagens para catálogo e banners usando templates PSD e a Biblioteca de Artes hospedada.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/admin/artes" class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
          Biblioteca de Artes
        </a>
        <a href="/admin" class="inline-flex min-h-10 items-center rounded-full border border-control px-4 text-xs font-medium text-ink-secondary hover:border-ink-muted">
          Voltar ao Painel
        </a>
      </div>
    </div>

    <section class="rounded-2xl border border-line bg-surface p-6 space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-1">
          <h2 class="text-base font-semibold text-ink">Instalador para Windows (Desktop)</h2>
          <p class="text-xs text-ink-muted">
            Versão {installerVersion} · Compatível com Windows 10 e 11 (64 bits) · Instalação por usuário (não requer Node.js nem terminal).
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          {installerUrl ? (
            <a
              id="btn-download-installer"
              href={installerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-xl bg-action px-5 text-xs font-semibold text-on-action hover:bg-action-hover"
            >
              Baixar Gerador para Windows (v{installerVersion})
            </a>
          ) : (
            <span class="inline-flex min-h-10 items-center rounded-xl border border-line bg-canvas px-4 text-xs font-medium text-ink-muted">
              Download indisponível (URL do instalador não configurada)
            </span>
          )}
          {notesUrl && (
            <a
              href={notesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-10 items-center rounded-xl border border-control px-4 text-xs font-medium text-ink-secondary hover:border-ink-muted"
            >
              Notas da versão ↗
            </a>
          )}
        </div>
      </div>
      <div class="rounded-xl border border-line bg-canvas p-4 space-y-2 text-xs text-ink-secondary">
        <p class="font-semibold text-ink">Instalação rápida:</p>
        <ol class="list-decimal pl-5 space-y-1">
          <li>Baixe e execute o instalador <code>678Estudio-Mockups-Setup-{installerVersion}-x64.exe</code>.</li>
          <li>Conclua o assistente (ele cria o atalho no Menu Iniciar e prepara as dependências automaticamente).</li>
          <li>Nas próximas vezes, abra <strong>678 Estudio Mockups Comerciais</strong> pelo Menu Iniciar ou Área de Trabalho.</li>
        </ol>
        <p class="text-[11px] text-ink-muted pt-1">
          Observação: se o Windows SmartScreen exibir aviso por ausência de certificado comercial, clique em <em>Mais informações</em> somente se o arquivo tiver sido baixado diretamente do canal oficial do 678 Estudio.
        </p>
      </div>
    </section>

    <section class="rounded-2xl border border-line bg-surface p-6 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-semibold text-ink">Status do Gerador Local (Desktop Windows)</h2>
          <p id="local-editor-status" class="text-xs text-ink-muted mt-1">Verificando se o editor local está ativo em http://127.0.0.1:4399…</p>
        </div>
        <a
          id="btn-open-local-editor"
          href="http://127.0.0.1:4399"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center rounded-xl border border-control px-5 text-xs font-semibold text-ink hover:border-ink-muted"
        >
          Abrir Editor Local (127.0.0.1:4399) ↗
        </a>
      </div>
      <p class="text-xs text-ink-secondary">
        Observação: navegadores podem bloquear a verificação automática de <code>http://127.0.0.1</code> a partir de páginas HTTPS. Caso o gerador já esteja aberto pelo atalho, acesse <code>http://127.0.0.1:4399</code> diretamente em uma nova aba.
      </p>
    </section>

    <section class="rounded-2xl border border-line bg-surface p-6 space-y-4 text-xs text-ink-secondary">
      <h2 class="text-base font-semibold text-ink">Como usar no dia a dia</h2>
      <ol class="list-decimal pl-5 space-y-2">
        <li>Abra o aplicativo <strong>678 Estudio Mockups Comerciais</strong> pelo atalho do Windows. O editor abrirá automaticamente em <strong>http://127.0.0.1:4399</strong>.</li>
        <li>Na primeira utilização, importe seus arquivos PSD licenciados (<code>3.psd</code>, <code>9.psd</code>, <code>10.psd</code> ou <code>11.psd</code>) pelo próprio botão do editor.</li>
        <li>Clique em <strong>Biblioteca</strong>, selecione a origem <strong>Remota (678 Estudio hospedado)</strong> e informe a URL <code>{currentOrigin}</code> com seu usuário e senha administrativos (mantidos apenas na sessão em memória).</li>
        <li>Posicione as artes nos slots, clique em <strong>Gerar Mockup no Photopea</strong> e baixe o PNG ou WebP final.</li>
      </ol>
    </section>
  </div>
</BaseLayout>

<script>
  const statusEl = document.getElementById('local-editor-status');
  async function checkLocalEditor() {
    if (!statusEl) return;
    try {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 1500);
      const res = await fetch('http://127.0.0.1:4399/api/templates', { signal: controller.signal });
      window.clearTimeout(timer);
      if (res.ok) {
        statusEl.textContent = 'Editor local ativo e pronto em http://127.0.0.1:4399.';
        statusEl.className = 'text-xs font-semibold text-success mt-1';
        return;
      }
    } catch {}
    statusEl.textContent = 'Editor local não detectado automaticamente. Inicie o comando abaixo no Windows e abra http://127.0.0.1:4399.';
  }
  checkLocalEditor();
</script>
