---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MugAdjustment from '../../components/admin/MugAdjustment.astro';
import { mugMockups } from '../../server/mockups/options.mjs';
import { getMugInstances } from '../../server/mockups/manifest.mjs';

export const prerender = false;
const models = await Promise.all(mugMockups.map(async model => ({
  ...model, instances: await getMugInstances(model.id),
})));
---

<BaseLayout title="Mockups de Canecas | Administração 678 Estudio">
  <main class="mx-auto max-w-6xl space-y-6 px-4 py-8 sm:px-6 lg:px-8">
    <header class="border-b border-line pb-5">
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">← Voltar ao painel</a>
      <h1 class="mt-3 text-3xl font-semibold text-ink">Mockups de Canecas</h1>
      <p class="mt-2 text-sm text-ink-secondary">Envie uma arte e selecione as cenas para gerar imagens em resolução original.</p>
    </header>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)]">
      <form id="mug-mockup-form" class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5"
        action="/admin/mockups-comerciais/render" method="post" enctype="multipart/form-data">
        <fieldset id="mug-mockup-fields" class="min-w-0 space-y-5">
          <div class="space-y-2">
            <label for="mug-artwork" class="block text-sm font-semibold text-ink">Arte</label>
            <input id="mug-artwork" name="artwork" type="file" required accept="image/png,image/jpeg,image/webp"
              class="w-full min-w-0 text-sm text-ink-secondary file:mr-2 file:rounded-lg file:border-0 file:bg-surface-muted file:px-3 file:py-2"
              aria-describedby="mug-artwork-help" />
            <p id="mug-artwork-help" class="text-xs text-ink-muted">PNG, JPEG ou WebP estático · Até 8 MB e 16 megapixels.</p>
          </div>

          <fieldset id="mug-global-placement" class="space-y-3 border-t border-line pt-4">
            <legend class="pr-2 text-base font-semibold text-ink">Ajustar arte</legend>
            <label class="block space-y-1 text-sm">
              <span>Modo de encaixe</span>
              <select id="mug-fit" class="min-h-11 w-full rounded-lg border border-control bg-canvas px-2">
                <option value="original">Ajuste original</option>
                <option value="contain">Conter</option>
                <option value="cover">Preencher</option>
                <option value="manual">Manual</option>
              </select>
            </label>
            <div id="mug-art-frame" tabindex="0" role="group" aria-label="Área útil de 20 × 9 cm" aria-describedby="mug-frame-help"
              class="relative aspect-[20/9] touch-none cursor-grab select-none overflow-hidden rounded-lg border border-control bg-white focus-visible:outline-accent active:cursor-grabbing">
              <p id="mug-frame-empty" class="pointer-events-none absolute inset-0 grid place-items-center px-2 text-center text-xs text-slate-600">A arte aparecerá aqui.</p>
              <img id="mug-frame-art" hidden alt="" draggable="false" class="pointer-events-none absolute max-w-none" />
              <div aria-hidden="true" class="pointer-events-none absolute inset-1 rounded border border-dashed border-slate-500/60"></div>
            </div>
            <p id="mug-frame-help" class="text-xs text-ink-muted">Área útil de 20 × 9 cm. Arraste, use as setas ou ajuste pelos controles. No ajuste original, vale a prévia de cada modelo. A faixa e os papéis mantêm o encaixe original.</p>
            <MugAdjustment />
            <div class="flex flex-wrap gap-2">
              {[
                ['original', 'Ajuste original'], ['center', 'Centralizar'], ['contain', 'Conter arte'],
                ['cover', 'Preencher área'], ['zoom', 'Zoom 100%'], ['reset', 'Redefinir enquadramento'],
              ].map(([id, label]) => (
                <button type="button" data-preset={id} class="min-h-10 rounded-lg border border-control px-2 text-xs font-medium hover:border-accent">{label}</button>
              ))}
            </div>
          </fieldset>

          <fieldset class="space-y-2">
            <legend class="mb-2 text-sm font-semibold text-ink">Modelos</legend>
            {models.map((model) => (
              <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-control px-3 py-2 text-sm">
                <input name="model" type="checkbox" value={model.id} data-label={model.label}
                  data-instances={JSON.stringify(model.instances)} data-ratio={`${model.width} / ${model.height}`}
                  checked class="size-4 shrink-0 accent-accent" />
                <span>{model.label}</span>
              </label>
            ))}
          </fieldset>

          <button id="mug-generate" class="min-h-11 w-full rounded-lg bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover disabled:opacity-50" type="submit">
            Gerar prévias
          </button>
        </fieldset>
        <p id="mug-mockup-error" role="alert" class="mt-3 text-sm text-danger" hidden></p>
      </form>

      <section class="min-w-0 rounded-2xl border border-line bg-surface p-4 sm:p-5" aria-labelledby="mug-results-title">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="mug-results-title" class="text-lg font-semibold text-ink">Resultados</h2>
          <label class="flex items-center gap-2 text-sm">
            Formato
            <select id="mug-export-format" class="min-h-11 rounded-lg border border-control bg-canvas px-2">
              <option value="png">PNG</option>
              <option value="jpeg">JPEG</option>
              <option value="webp">WebP</option>
            </select>
          </label>
          <button id="mug-download-zip" type="button" hidden class="min-h-11 rounded-lg border border-control px-4 text-sm font-semibold hover:border-accent disabled:opacity-50">
            Baixar todos em ZIP
          </button>
        </div>
        <p id="mug-mockup-status" role="status" class="mt-2 text-sm text-ink-secondary">Os mockups gerados aparecerão aqui.</p>
        <div id="mug-mockup-results" class="mt-4 grid gap-4 sm:grid-cols-2"></div>
      </section>
    </div>
  </main>

  <template id="mug-mockup-result">
    <article class="min-w-0 overflow-hidden rounded-xl border border-line bg-canvas">
      <div data-mug-image class="relative bg-white">
        <img hidden class="block h-full w-full object-contain" decoding="async" alt="" draggable="false" />
        <div data-mug-markers hidden aria-label="Canecas na imagem" class="pointer-events-none absolute inset-0"></div>
      </div>
      <div class="space-y-2 p-3">
        <h3 class="text-sm font-semibold text-ink"></h3>
        <p data-state class="text-xs text-ink-secondary" aria-live="polite"></p>
        <button type="button" data-mug-download hidden class="min-h-11 items-center text-sm font-semibold text-accent hover:underline">Baixar PNG</button>
        <details data-mug-panel class="border-t border-line pt-1">
          <summary class="flex min-h-10 cursor-pointer items-center text-sm font-semibold text-accent">Ajustar canecas</summary>
          <fieldset data-instance-controls class="space-y-2">
            <legend class="sr-only">Ajustes da caneca selecionada</legend>
            <label class="block text-sm">
              Caneca
              <select data-mug-picker class="mt-1 min-h-11 w-full rounded-lg border border-control bg-canvas px-2"></select>
            </label>
            <MugAdjustment />
            <div class="flex flex-wrap gap-2">
              <button type="button" data-mug-center class="min-h-11 rounded-lg border border-control px-2 text-xs">Centralizar</button>
              <button type="button" data-mug-reset class="min-h-11 rounded-lg border border-control px-2 text-xs">Restaurar caneca</button>
              <button type="button" data-mug-render class="min-h-11 rounded-lg border border-control px-2 text-xs font-semibold">Atualizar prévia</button>
            </div>
            <p class="text-xs text-ink-muted">Selecione ou arraste um marcador na imagem. Use as setas com o marcador em foco.</p>
          </fieldset>
        </details>
        <details class="border-t border-line pt-1">
          <summary class="flex min-h-10 cursor-pointer items-center text-sm font-semibold text-accent">Ajustar este modelo</summary>
          <fieldset data-local class="space-y-2">
            <legend class="sr-only">Correções relativas ao enquadramento global</legend>
            <MugAdjustment local />
            <div class="flex flex-wrap gap-2">
              <button type="button" data-local-reset class="min-h-10 rounded-lg border border-control px-2 text-xs">Restaurar este modelo</button>
              <button type="button" data-local-apply class="min-h-10 rounded-lg border border-control px-2 text-xs">Aplicar globais novamente</button>
              <button type="button" data-local-render class="min-h-10 rounded-lg border border-control px-2 text-xs font-semibold">Atualizar prévia</button>
            </div>
          </fieldset>
        </details>
      </div>
    </article>
  </template>
</BaseLayout>

<style>
  [hidden] { display: none; }
</style>

<script>
  import { initMugMockupAdmin } from '../../scripts/mugMockupAdmin';
  initMugMockupAdmin();
</script>
