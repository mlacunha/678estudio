---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AdminA4PrintPanel from '../../../../components/admin/AdminA4PrintPanel.astro';
import { getPlannerQuote } from '../../../../db/plannerQuotes';
import {
  formatPlannerQuoteDate,
  plannerQuoteLabels,
  plannerQuotePath,
} from '../../../../server/planner/quoteConfig';
import { plannerSections } from '../../../../server/planner/options.mjs';

export const prerender = false;

const id = Astro.params.id ?? '';
const quote = await getPlannerQuote(id);
if (!quote) return new Response('Solicitação de planner não encontrada.', { status: 404 });

const { config } = quote;
const files = `/admin/planners/${quote.id}/arquivo`;
const labelClass = 'text-xs font-semibold uppercase tracking-wider text-ink-muted';
---

<BaseLayout title={`Produção: ${quote.product} | 678 Estudio`}>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <a href="/admin/planners" class="text-sm font-semibold text-accent hover:underline">← Voltar às solicitações de planners</a>
    <h1 class="editorial-heading mt-4 text-4xl">{quote.product}</h1>
    <p class="mt-2 text-sm text-ink-secondary">Solicitado · {formatPlannerQuoteDate(quote.createdAt)}</p>
    <p class="mt-2 break-all font-mono text-xs text-ink-muted">{quote.id}</p>

    <div class="mt-6 rounded-xl border border-line bg-surface p-4 sm:p-6">
      <h2 class="text-xl font-semibold">Especificações do produto</h2>

      <dl class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">
        {plannerQuoteLabels(config).map((value, index) => (
          <div>
            <dt class={labelClass}>{['Modelo', 'Modalidade / Ano', 'Estilo visual', 'Tipografia', 'Formato'][index]}</dt>
            <dd class="mt-1 text-sm font-medium">{value}</dd>
          </div>
        ))}
        <div>
          <dt class={labelClass}>Identificação</dt>
          <dd class="mt-1 text-sm font-medium">{config.personalizationName || 'Não informada'}</dd>
        </div>
        <div>
          <dt class={labelClass}>Cores {config.customColors ? 'personalizadas' : 'do estilo'}</dt>
          <dd class="mt-1 flex items-center gap-1.5 font-mono text-xs">
            <span class="inline-block size-3.5 rounded border border-line" style={`background:${config.colors.primary}`} />
            <span>{config.colors.primary}</span>
            <span>/</span>
            <span class="inline-block size-3.5 rounded border border-line" style={`background:${config.colors.secondary}`} />
            <span>{config.colors.secondary}</span>
          </dd>
        </div>
        <div class="min-w-0">
          <dt class={labelClass}>Logomarca</dt>
          <dd class="mt-1 break-all text-sm font-medium">{config.logo?.originalName || 'Sem logomarca'}</dd>
        </div>
        <div>
          <dt class={labelClass}>Marca-d’água</dt>
          <dd class="mt-1 text-sm font-medium">{config.watermark ? 'Sim' : 'Não'}</dd>
        </div>
        <div>
          <dt class={labelClass}>Template Typst</dt>
          <dd class="mt-1 text-sm font-medium">{config.template} (v{quote.configVersion})</dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-line pt-5">
        <a
          href={`/admin/planners/${quote.id}/pdf`}
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-action px-5 text-sm font-semibold text-on-action hover:bg-action-hover"
        >
          Baixar PDF de produção (A5 original)
        </a>
        <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/configuracao`}>
          Baixar configuração JSON
        </a>
        {config.logo && (
          <>
            <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/original`}>
              Baixar logo original
            </a>
            <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/logo`}>
              Baixar logo processada
            </a>
          </>
        )}
      </div>

      <div class="mt-6 rounded-lg border border-accent/20 bg-accent/5 p-4">
        <h3 class="text-sm font-semibold text-ink">Produção gráfica de capas personalizadas</h3>
        {config.cover ? (
          <dl class="mt-2 grid grid-cols-2 gap-3 text-xs sm:grid-cols-4">
            <div>
              <dt class={labelClass}>Estilo da capa</dt>
              <dd class="mt-0.5 font-medium">{config.cover.style}</dd>
            </div>
            <div>
              <dt class={labelClass}>Tipografia</dt>
              <dd class="mt-0.5 font-medium">{config.cover.typography}</dd>
            </div>
            <div>
              <dt class={labelClass}>Título / Nome</dt>
              <dd class="mt-0.5 font-medium">{config.cover.title || '—'} / {config.cover.name || '—'}</dd>
            </div>
            <div>
              <dt class={labelClass}>Cores (base / detalhe)</dt>
              <dd class="mt-0.5 font-mono">{config.cover.colors.primary} / {config.cover.colors.accent}</dd>
            </div>
          </dl>
        ) : (
          <p class="mt-1 text-xs text-ink-muted">
            Gere os PDFs de capa frontal e contracapa com corte milimétrico, sangrias configuráveis e furação Wire-O de 15 mm preservada.
          </p>
        )}
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={`/admin/capas/planners/${quote.id}/pdf?format=front-a5&bleed=3mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Capa A5 (sangria 3mm)</a>
          <a href={`/admin/capas/planners/${quote.id}/pdf?format=front-a5&bleed=5mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Capa A5 (sangria 5mm)</a>
          <a href={`/admin/capas/planners/${quote.id}/pdf?format=back-a5&bleed=3mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Contracapa A5 (sangria 3mm)</a>
          <a href={`/admin/capas/planners/${quote.id}/pdf?format=combined-a4`} class="inline-flex items-center rounded border border-accent bg-accent/10 px-3 py-1.5 text-xs font-semibold text-accent hover:bg-accent/20">Folha Combinada A4 (Corte central s/ dobra)</a>
          {config.cover?.hasCustomImage && (
            <a href={`${files}/cover_image_original`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-accent hover:border-accent">Baixar fotografia da capa original</a>
          )}
        </div>
      </div>

      <AdminA4PrintPanel
        pdfEndpoint={`/admin/planners/${quote.id}/pdf`}
        productLabel="Planner Essencial A5"
      />
    </div>

    <div class="mt-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-semibold">Prévias reais salvas no banco</h2>
        <a href={plannerQuotePath(quote.id)} class="text-sm font-semibold text-accent hover:underline">
          Abrir referência do cliente
        </a>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {plannerSections.map((section) => (
          <div class="rounded-xl border border-line bg-surface p-2">
            <img
              src={`${files}/preview-${section.id}`}
              alt={`Prévia da seção ${section.label}`}
              loading="lazy"
              class="block aspect-[148/210] w-full rounded bg-white object-contain shadow-inner"
            />
            <span class="mt-2 block px-1 text-xs font-semibold text-ink">{section.label}</span>
            <span class="block px-1 text-[11px] text-ink-muted">{section.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
