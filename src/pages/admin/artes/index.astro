---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { listAdminArtes, listArtCategories } from '../../../db/artLibraryRepository';
import { ART_PRODUCT_LABELS, ART_PRODUCT_TYPES } from '../../../utils/artLibrary';

export const prerender = false;

const [categories, artes] = await Promise.all([
  listArtCategories(true),
  listAdminArtes({ status: 'active' }),
]);
---

<BaseLayout title="Biblioteca de Artes | 678 Estudio" description="Gerenciamento da biblioteca de artes para personalização">
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-8">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-6">
      <div>
        <a href="/admin" class="text-sm font-semibold text-accent hover:underline">← Voltar ao painel</a>
        <h1 class="mt-2 text-2xl sm:text-3xl font-light text-ink">
          Biblioteca de <span class="font-normal text-accent">Artes</span>
        </h1>
        <p class="mt-1 text-xs text-ink-secondary">
          Cadastre categorias, envie imagens unitárias ou em lote, gerencie versões e baixe originais para impressão.
        </p>
      </div>
      <div class="flex items-center gap-3 text-xs text-ink-secondary">
        <span id="artes-counter" class="rounded-full border border-line bg-surface px-3 py-1.5 font-medium">
          {artes.length} {artes.length === 1 ? 'arte ativa' : 'artes ativas'}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <!-- Painel de Categorias -->
      <aside class="lg:col-span-4 space-y-4 rounded-xl border border-line bg-surface p-5">
        <div>
          <h2 class="text-base font-semibold text-ink">Categorias temáticas</h2>
          <p class="mt-0.5 text-xs text-ink-muted">Organize os temas exibidos para o cliente.</p>
        </div>

        <form id="form-new-category" class="flex gap-2">
          <input
            id="input-category-name"
            type="text"
            required
            maxlength="80"
            placeholder="Ex.: Florais, Minimalista..."
            class="min-w-0 flex-1 rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
          />
          <button
            type="submit"
            class="min-h-10 rounded-md bg-action px-4 text-xs font-semibold text-on-action hover:bg-action-hover"
          >
            Adicionar
          </button>
        </form>
        <p id="category-status" role="status" class="text-xs text-ink-secondary"></p>

        <ul id="categories-list" class="divide-y divide-line rounded-lg border border-line bg-canvas/60 text-sm"></ul>
      </aside>

      <!-- Painel de Upload -->
      <section class="lg:col-span-8 rounded-xl border border-line bg-surface p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-base font-semibold text-ink">Enviar artes (individual ou em lote)</h2>
            <p class="mt-0.5 text-xs text-ink-muted">
              Formatos aceitos: JPEG, PNG ou WebP. O arquivo original é preservado sem recompressão.
            </p>
          </div>
        </div>

        <form id="form-upload-artes" class="space-y-4">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="input-arte-files" class="block text-xs font-semibold text-ink-secondary mb-1.5">
                Imagens * (selecione uma ou várias)
              </label>
              <input
                id="input-arte-files"
                type="file"
                multiple
                required
                accept="image/jpeg,image/png,image/webp"
                class="block w-full rounded-md border border-dashed border-control bg-canvas p-3 text-xs text-ink file:mr-3 file:rounded-md file:border-0 file:bg-accent/15 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-accent hover:border-accent"
              />
              <p id="upload-files-hint" class="mt-1 text-xs text-ink-muted">Nenhum arquivo selecionado.</p>
            </div>

            <div class="sm:col-span-2">
              <label for="input-arte-group-description" class="block text-xs font-semibold text-ink-secondary mb-1">
                Descrição do grupo (opcional)
              </label>
              <textarea
                id="input-arte-group-description"
                rows="2"
                maxlength="500"
                placeholder="Ex.: Artes com frases motivacionais, mensagens positivas e temas de superação."
                class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
              ></textarea>
            </div>

            <div id="single-arte-fields" class="sm:col-span-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="input-arte-title" class="block text-xs font-semibold text-ink-secondary mb-1">
                  Título da arte (somente envio individual)
                </label>
                <input
                  id="input-arte-title"
                  type="text"
                  maxlength="120"
                  placeholder="Usa o nome do arquivo se vazio"
                  class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none disabled:opacity-50"
                />
              </div>
              <div>
                <label for="input-arte-code" class="block text-xs font-semibold text-ink-secondary mb-1">
                  Código único (somente envio individual)
                </label>
                <input
                  id="input-arte-code"
                  type="text"
                  maxlength="32"
                  placeholder="Automático se vazio (ex.: ART-0001)"
                  class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm uppercase text-ink focus:border-accent focus:outline-none disabled:opacity-50"
                />
              </div>
            </div>

            <div>
              <span class="block text-xs font-semibold text-ink-secondary mb-1.5">Produtos compatíveis *</span>
              <div class="flex flex-wrap gap-3">
                {ART_PRODUCT_TYPES.map(type => (
                  <label class="inline-flex items-center gap-2 rounded-md border border-line bg-canvas px-3 py-1.5 text-xs font-medium text-ink cursor-pointer">
                    <input type="checkbox" name="upload-products" value={type} checked class="accent-accent" />
                    <span>{ART_PRODUCT_LABELS[type]}</span>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <span class="block text-xs font-semibold text-ink-secondary mb-1.5">Categorias temáticas</span>
              <div id="upload-categories-container" class="flex flex-wrap gap-2"></div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-4">
            <label class="inline-flex items-center gap-2 text-xs font-medium text-ink cursor-pointer">
              <input id="input-upload-published" type="checkbox" checked class="accent-accent" />
              <span>Publicar imediatamente</span>
            </label>
            <button
              id="btn-submit-upload"
              type="submit"
              class="min-h-10 rounded-md bg-action px-5 text-xs font-semibold uppercase tracking-wider text-on-action hover:bg-action-hover disabled:opacity-50"
            >
              Enviar para biblioteca
            </button>
          </div>
          <p id="upload-status" role="status" class="text-xs text-ink-secondary"></p>
        </form>
      </section>
    </div>

    <!-- Filtros e Listagem -->
    <section class="space-y-4">
      <div class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-4 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label for="filter-q" class="block text-xs font-semibold text-ink-secondary mb-1">Buscar por código ou título</label>
          <input
            id="filter-q"
            type="search"
            placeholder="Ex.: ART-0001 ou Floral..."
            class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none"
          />
        </div>
        <div class="w-full sm:w-48">
          <label for="filter-category" class="block text-xs font-semibold text-ink-secondary mb-1">Categoria</label>
          <select id="filter-category" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none">
            <option value="">Todas</option>
          </select>
        </div>
        <div class="w-full sm:w-40">
          <label for="filter-product" class="block text-xs font-semibold text-ink-secondary mb-1">Produto</label>
          <select id="filter-product" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none">
            <option value="">Todos</option>
            {ART_PRODUCT_TYPES.map(type => (
              <option value={type}>{ART_PRODUCT_LABELS[type]}</option>
            ))}
          </select>
        </div>
        <div class="w-full sm:w-40">
          <label for="filter-status" class="block text-xs font-semibold text-ink-secondary mb-1">Situação</label>
          <select id="filter-status" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none">
            <option value="active" selected>Ativas</option>
            <option value="published">Publicadas</option>
            <option value="draft">Rascunhos</option>
            <option value="inactive">Desativadas</option>
            <option value="all">Todas</option>
          </select>
        </div>
      </div>

      <p id="artes-list-status" role="status" class="text-xs text-ink-secondary"></p>
      <div id="artes-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>
    </section>
  </section>

  <!-- Modal de Prévia & Histórico -->
  <dialog id="modal-preview" class="w-full max-w-3xl rounded-xl border border-line bg-surface p-0 text-ink backdrop:bg-black/60">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <div>
        <h3 id="preview-title" class="text-base font-semibold">Prévia da arte</h3>
        <p id="preview-meta" class="text-xs text-ink-muted"></p>
      </div>
      <button id="btn-close-preview" type="button" class="rounded-md border border-line px-3 py-1.5 text-xs font-medium hover:border-accent">
        Fechar
      </button>
    </div>
    <div class="p-5 space-y-4">
      <div class="flex max-h-[60vh] items-center justify-center overflow-hidden rounded-lg border border-line bg-canvas p-2">
        <img id="preview-image" alt="Prévia otimizada da arte" class="max-h-[55vh] w-auto object-contain" />
      </div>
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-secondary mb-2">Versões armazenadas</h4>
        <ul id="preview-versions" class="divide-y divide-line rounded-lg border border-line bg-canvas text-xs"></ul>
      </div>
    </div>
  </dialog>

  <!-- Modal de Edição & Nova Versão -->
  <dialog id="modal-edit" class="w-full max-w-2xl rounded-xl border border-line bg-surface p-0 text-ink backdrop:bg-black/60">
    <div class="flex items-center justify-between border-b border-line px-5 py-4">
      <h3 class="text-base font-semibold">Editar arte e versionamento</h3>
      <button id="btn-close-edit" type="button" class="rounded-md border border-line px-3 py-1.5 text-xs font-medium hover:border-accent">
        Fechar
      </button>
    </div>
    <div class="p-5 space-y-6">
      <form id="form-edit-arte" class="space-y-4">
        <input type="hidden" id="edit-arte-id" />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="edit-arte-code" class="block text-xs font-semibold text-ink-secondary mb-1">Código *</label>
            <input id="edit-arte-code" type="text" required maxlength="32" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm uppercase text-ink" />
          </div>
          <div>
            <label for="edit-arte-title" class="block text-xs font-semibold text-ink-secondary mb-1">Título da arte *</label>
            <input id="edit-arte-title" type="text" required maxlength="120" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink" />
          </div>
        </div>
        <div>
          <label for="edit-arte-description" class="block text-xs font-semibold text-ink-secondary mb-1">Descrição</label>
          <textarea id="edit-arte-description" rows="2" maxlength="500" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink"></textarea>
        </div>
        <div>
          <label for="edit-arte-group-description" class="block text-xs font-semibold text-ink-secondary mb-1">Descrição do grupo</label>
          <textarea id="edit-arte-group-description" rows="2" maxlength="500" placeholder="Opcional — compartilhada inicialmente pelo lote e editável individualmente" class="w-full rounded-md border border-control bg-canvas px-3 py-2 text-sm text-ink"></textarea>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <span class="block text-xs font-semibold text-ink-secondary mb-1.5">Produtos compatíveis *</span>
            <div class="flex flex-wrap gap-3">
              {ART_PRODUCT_TYPES.map(type => (
                <label class="inline-flex items-center gap-2 rounded-md border border-line bg-canvas px-3 py-1.5 text-xs cursor-pointer">
                  <input type="checkbox" name="edit-products" value={type} class="accent-accent" />
                  <span>{ART_PRODUCT_LABELS[type]}</span>
                </label>
              ))}
            </div>
          </div>
          <div>
            <span class="block text-xs font-semibold text-ink-secondary mb-1.5">Categorias</span>
            <div id="edit-categories-container" class="flex flex-wrap gap-2"></div>
          </div>
        </div>
        <div class="flex flex-wrap gap-4">
          <label class="inline-flex items-center gap-2 text-xs font-medium cursor-pointer">
            <input id="edit-arte-published" type="checkbox" class="accent-accent" />
            <span>Publicada</span>
          </label>
          <label class="inline-flex items-center gap-2 text-xs font-medium cursor-pointer">
            <input id="edit-arte-active" type="checkbox" class="accent-accent" />
            <span>Ativa</span>
          </label>
        </div>
        <div class="flex items-center justify-between gap-3">
          <p id="edit-status" role="status" class="text-xs text-ink-secondary"></p>
          <button type="submit" class="min-h-10 rounded-md bg-action px-5 text-xs font-semibold text-on-action hover:bg-action-hover">
            Salvar alterações
          </button>
        </div>
      </form>

      <form id="form-new-version" class="border-t border-line pt-4 space-y-3">
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-secondary">Substituir imagem (nova versão)</h4>
          <p class="mt-0.5 text-xs text-ink-muted">A versão anterior permanece preservada sem sobrescrita.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <input id="input-new-version-file" type="file" accept="image/jpeg,image/png,image/webp" required class="flex-1 text-xs text-ink" />
          <button id="btn-submit-version" type="submit" class="min-h-10 rounded-md border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10">
            Enviar nova versão
          </button>
        </div>
        <p id="version-status" role="status" class="text-xs text-ink-secondary"></p>
      </form>
    </div>
  </dialog>

  <script type="application/json" id="initial-art-library-data" set:html={JSON.stringify({ categories, artes })}></script>
  <script src="../../../scripts/adminArtes.ts"></script>
</BaseLayout>

