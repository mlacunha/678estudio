---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AgendaQuotePreviews from '../../../../components/AgendaQuotePreviews.astro';
import AdminA4PrintPanel from '../../../../components/admin/AdminA4PrintPanel.astro';
import { getAgendaQuote } from '../../../../db/agendaQuotes';
import { agendaQuoteLabels, agendaQuotePath, formatAgendaQuoteDate } from '../../../../server/agenda/quoteConfig';
export const prerender = false;
const quote = await getAgendaQuote(Astro.params.id ?? '');
if (!quote) return new Response('Solicitação de agenda não encontrada.', { status: 404 });
const { config } = quote;
const files = `/admin/agendas/${quote.id}/arquivo`;
const labelClass = 'text-xs font-semibold uppercase tracking-wider text-ink-muted';
---

<BaseLayout title="Produção da Agenda Clássica | 678 Estudio">
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <a href="/admin/agendas" class="text-sm font-semibold text-accent hover:underline">← Voltar às solicitações</a>
    <h1 class="editorial-heading mt-4 text-4xl">{quote.product}</h1>
    <p class="mt-2 text-sm text-ink-secondary">Solicitado · {formatAgendaQuoteDate(quote.createdAt)}</p>
    <p class="mt-2 break-all font-mono text-xs text-ink-muted">{quote.id}</p>
    <div class="mt-6 rounded-xl border border-line bg-surface p-4 sm:p-6">
      <h2 class="text-xl font-semibold">Especificações e produção</h2>
      <dl class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4">
        {agendaQuoteLabels(config).map((value, index) => (
          <div><dt class={labelClass}>{['Ano', 'Formato', 'Layout', 'Estilo'][index]}</dt><dd class="mt-1 text-sm">{value}</dd></div>
        ))}
        <div><dt class={labelClass}>Cores {config.customColors ? 'personalizadas' : 'do estilo'}</dt><dd class="mt-1 font-mono text-sm">{config.colors.primary} / {config.colors.secondary}</dd></div>
        <div><dt class={labelClass}>Marca-d’água</dt><dd class="mt-1 text-sm">{config.watermark ? 'Sim' : 'Não'}</dd></div>
        <div class="min-w-0"><dt class={labelClass}>Logomarca</dt><dd class="mt-1 break-all text-sm">{config.logo?.originalName || 'Sem logomarca'}</dd></div>
        <div><dt class={labelClass}>Esquema</dt><dd class="mt-1 text-sm">Versão {quote.configVersion}</dd></div>
      </dl>
      <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-line pt-5">
        <form method="post" action={`/admin/agenda-classica.pdf?pedido=${quote.id}`}>
          <button class="min-h-11 rounded-md bg-action px-4 text-sm font-semibold text-on-action hover:bg-action-hover">
            Baixar PDF de produção (A5 original)
          </button>
        </form>
        <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/configuracao`}>Baixar configuração JSON</a>
        {config.logo && <>
          <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/original`}>Baixar original</a>
          <a class="p-2 text-sm font-semibold text-accent hover:underline" href={`${files}/logo`}>Baixar PNG de produção</a>
        </>}
      </div>

      <div class="mt-6 rounded-lg border border-accent/20 bg-accent/5 p-4">
        <h3 class="text-sm font-semibold text-ink">Produção gráfica de capas personalizadas</h3>
        {config.cover ? (
          <dl class="mt-2 grid grid-cols-2 gap-3 text-xs sm:grid-cols-4">
            <div>
              <dt class={labelClass}>Estilo da capa</dt>
              <dd class="mt-0.5 font-medium">{config.cover.style}</dd>
            </div>
            <div>
              <dt class={labelClass}>Tipografia</dt>
              <dd class="mt-0.5 font-medium">{config.cover.typography}</dd>
            </div>
            <div>
              <dt class={labelClass}>Título / Nome</dt>
              <dd class="mt-0.5 font-medium">{config.cover.title || '—'} / {config.cover.name || '—'}</dd>
            </div>
            <div>
              <dt class={labelClass}>Cores (base / detalhe)</dt>
              <dd class="mt-0.5 font-mono">{config.cover.colors.primary} / {config.cover.colors.accent}</dd>
            </div>
          </dl>
        ) : (
          <p class="mt-1 text-xs text-ink-muted">
            Gere os PDFs de capa frontal e contracapa com corte milimétrico, sangrias configuráveis e furação Wire-O de 15 mm preservada.
          </p>
        )}
        <div class="mt-3 flex flex-wrap gap-2">
          <a href={`/admin/capas/agendas/${quote.id}/pdf?format=front-a5&bleed=3mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Capa A5 (sangria 3mm)</a>
          <a href={`/admin/capas/agendas/${quote.id}/pdf?format=front-a5&bleed=5mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Capa A5 (sangria 5mm)</a>
          <a href={`/admin/capas/agendas/${quote.id}/pdf?format=back-a5&bleed=3mm`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-ink hover:border-accent">Contracapa A5 (sangria 3mm)</a>
          <a href={`/admin/capas/agendas/${quote.id}/pdf?format=combined-a4`} class="inline-flex items-center rounded border border-accent bg-accent/10 px-3 py-1.5 text-xs font-semibold text-accent hover:bg-accent/20">Folha Combinada A4 (Corte central s/ dobra)</a>
          {config.cover?.hasCustomImage && (
            <a href={`${files}/cover_image_original`} class="inline-flex items-center rounded border border-control bg-surface px-3 py-1.5 text-xs font-medium text-accent hover:border-accent">Baixar fotografia da capa original</a>
          )}
        </div>
      </div>

      <AdminA4PrintPanel
        pdfEndpoint="/admin/agenda-classica.pdf"
        baseParams={{ pedido: quote.id }}
        productLabel={`Agenda ${config.year}`}
      />
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-semibold">Prévias salvas</h2>
      <a href={agendaQuotePath(quote.id)} class="text-sm font-semibold text-accent hover:underline">Abrir referência do cliente</a>
    </div>
    <AgendaQuotePreviews id={quote.id} config={quote.config} />
  </section>
</BaseLayout>
