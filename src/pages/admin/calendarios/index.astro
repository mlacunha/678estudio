---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandMark from '../../../components/BrandMark.astro';
import { listCalendarQuotes } from '../../../db/calendarQuotes';

export const prerender = false;
const page = Math.max(1, Number(Astro.url.searchParams.get('pagina') || 1));
const { quotes, total } = await listCalendarQuotes(page);
---

<BaseLayout title="Calendários Solicitados | Administração 678 Estudio" description="Listagem de solicitações de orçamento de calendários personalizados">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <header class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-line">
      <div class="flex items-center gap-3">
        <BrandMark class="size-9" />
        <div>
          <h1 class="text-2xl font-light text-ink">Calendários <span class="font-normal text-accent">Solicitados</span></h1>
          <p class="text-xs text-ink-muted">{total} solicitação(ões) registrada(s) para produção gráfica.</p>
        </div>
      </div>
      <a href="/admin" class="inline-flex min-h-10 items-center rounded-full border border-control px-4 text-xs font-medium text-ink-secondary hover:border-ink-muted">
        Voltar ao Painel
      </a>
    </header>

    {quotes.length === 0 ? (
      <div class="rounded-2xl border border-line bg-surface p-8 text-center text-sm text-ink-muted">
        Nenhuma solicitação de calendário registrada até o momento.
      </div>
    ) : (
      <div class="space-y-3">
        {quotes.map(q => (
          <a href={`/admin/calendarios/${q.id}`} class="block rounded-2xl border border-line bg-surface p-4 hover:border-accent transition-colors">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm font-semibold text-ink">{q.product} · {q.config.year}</p>
                <p class="text-xs text-ink-secondary mt-0.5">
                  {q.config.format} {q.config.orientation === 'landscape' ? 'Paisagem' : 'Retrato'} · Modelo: {q.config.templateId}
                  {q.config.advertiser?.name ? ` · ${q.config.advertiser.name}` : ''}
                </p>
              </div>
              <span class="text-xs text-ink-muted">{new Date(q.createdAt).toLocaleString('pt-BR')}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
