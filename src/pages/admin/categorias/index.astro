---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandMark from '../../../components/BrandMark.astro';
import { listAdminCategoriesWithCounts } from '../../../db/catalogRepository';
import { INTERNAL_DESTINATIONS } from '../../../data/internalDestinations';

export const prerender = false;

const categories = await listAdminCategoriesWithCounts();

const layoutLabels: Record<string, string> = {
  carousel: 'Carrossel horizontal',
  grid: 'Grade de cards',
  banner: 'Banner em destaque',
};

const actionLabels: Record<string, string> = {
  customizer: 'Personalizador',
  details: 'Página interna',
  quote: 'Orçamento WhatsApp',
};
---

<BaseLayout title="Categorias do Catálogo | Administração 678 Estudio" description="Gestão de linhas de produtos, layouts da Home e destinos do catálogo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div class="flex items-center gap-3">
        <BrandMark class="size-9" />
        <div>
          <a href="/admin" class="text-xs font-semibold text-accent hover:underline">← Painel Administrativo</a>
          <h1 class="text-2xl font-light text-ink tracking-wide mt-0.5">
            Gestão de <span class="font-normal text-accent">Categorias</span>
          </h1>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/admin/produtos"
          class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10"
        >
          Produtos
        </a>
        <button
          id="btn-new-category"
          type="button"
          class="inline-flex min-h-10 items-center gap-2 px-5 py-2.5 rounded-full bg-action hover:bg-action-hover text-on-action text-xs font-semibold tracking-wider uppercase motion-safe:transition-all shadow-lg"
        >
          <span>+ Nova Categoria</span>
        </button>
      </div>
    </div>

    <!-- Categories Table -->
    <div class="rounded-2xl border border-line bg-surface overflow-hidden shadow-xl">
      <div class="px-5 py-4 border-b border-line flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-semibold text-ink tracking-wide">
          Linhas do Catálogo ({categories.length})
        </h2>
        <span class="text-xs text-ink-muted">
          O vínculo com produtos e trabalhos usa ID interno estável (<code>category_id</code>)
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-canvas/80 text-[11px] uppercase tracking-wider text-ink-muted border-b border-line">
              <th class="px-5 py-3.5 font-medium">Categoria &amp; Slug</th>
              <th class="px-5 py-3.5 font-medium">Apresentação &amp; Destinos</th>
              <th class="px-5 py-3.5 font-medium text-center">Vínculos</th>
              <th class="px-5 py-3.5 font-medium text-center">Ordem</th>
              <th class="px-5 py-3.5 font-medium text-center">Home e menu</th>
              <th class="px-5 py-3.5 font-medium text-center">Publicação</th>
              <th class="px-5 py-3.5 font-medium text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line/60">
            {categories.map(cat => {
              const hasRefs = cat.productCount > 0 || cat.workCount > 0;
              return (
                <tr class="hover:bg-surface-muted/40 motion-safe:transition-colors">
                  <td class="px-5 py-4 max-w-xs">
                    <div class="flex items-start gap-3">
                      {cat.coverImageUrl ? (
                        <img
                          src={cat.coverImageUrl}
                          alt={cat.title}
                          class="w-11 h-11 rounded-lg object-cover border border-line bg-canvas shrink-0"
                        />
                      ) : (
                        <div class="w-11 h-11 rounded-lg border border-line bg-canvas flex items-center justify-center text-[10px] font-semibold text-ink-muted shrink-0 uppercase">
                          {cat.slug.slice(0, 3)}
                        </div>
                      )}
                      <div class="min-w-0">
                        <p class="font-semibold text-ink text-sm">{cat.title}</p>
                        <p class="text-[11px] text-ink-muted truncate">{cat.subtitle}</p>
                        <div class="flex flex-wrap items-center gap-1.5 mt-1">
                          <code class="px-1.5 py-0.5 rounded bg-canvas border border-line text-[10px] text-accent">
                            /{cat.slug}
                          </code>
                          {cat.aliases.length > 0 && (
                            <span class="text-[10px] text-ink-muted" title={`Slugs anteriores: ${cat.aliases.join(', ')}`}>
                              (histórico: {cat.aliases.join(', ')})
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                  </td>

                  <td class="px-5 py-4 space-y-1">
                    <p class="text-ink">
                      <span class="text-ink-muted">Layout:</span>{' '}
                      <strong class="font-medium">{layoutLabels[cat.layoutType ?? 'carousel']}</strong>
                    </p>
                    <p class="text-ink-secondary">
                      <span class="text-ink-muted">Página da linha:</span>{' '}
                      <code class="text-[11px] text-accent">{cat.destinationHref ?? `/colecoes/${cat.slug}`}</code>
                    </p>
                    <p class="text-ink-secondary">
                      <span class="text-ink-muted">Ação padrão:</span>{' '}
                      <span>
                        {actionLabels[cat.defaultProductAction ?? 'quote']}
                        {cat.defaultProductHref ? ` (${cat.defaultProductHref})` : ''}
                      </span>
                    </p>
                  </td>

                  <td class="px-5 py-4 text-center">
                    <div class="inline-flex flex-col items-center gap-0.5 text-[11px]">
                      <a href={`/admin/produtos?category=${cat.id}`} class="font-semibold text-accent hover:underline">
                        {cat.productCount} produto(s)
                      </a>
                      <span class="text-ink-muted">{cat.workCount} trabalho(s)</span>
                    </div>
                  </td>

                  <td class="px-5 py-4 text-center font-semibold text-ink-secondary">
                    {cat.displayOrder}
                  </td>

                  <td class="px-5 py-4 text-center">
                    <button
                      type="button"
                      class="btn-toggle-home px-2.5 py-1 rounded-full text-[10px] font-semibold tracking-wider uppercase motion-safe:transition-colors"
                      class:list={[
                        cat.showOnHome
                          ? 'bg-accent/15 text-accent border border-accent/40 hover:bg-accent/25'
                          : 'bg-surface-raised text-ink-muted border border-control hover:bg-surface-hover',
                      ]}
                      data-id={cat.id}
                      data-current={cat.showOnHome ? 'true' : 'false'}
                    >
                      {cat.showOnHome ? 'Na Home' : 'Fora da Home'}
                    </button>
                    <p class="mt-1 text-[11px] text-ink-muted">
                      {cat.showOnMenu ? 'No menu superior' : 'Fora do menu superior'}
                    </p>
                  </td>

                  <td class="px-5 py-4 text-center">
                    <button
                      type="button"
                      class="btn-toggle-active px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase motion-safe:transition-colors"
                      class:list={[
                        cat.isActive
                          ? 'bg-success-surface text-success border border-success/30 hover:bg-success-hover'
                          : 'bg-surface-raised text-ink-muted border border-control hover:bg-surface-hover',
                      ]}
                      data-id={cat.id}
                      data-current={cat.isActive ? 'true' : 'false'}
                    >
                      {cat.isActive ? 'Publicada' : 'Oculta'}
                    </button>
                  </td>

                  <td class="px-5 py-4 text-right space-x-2 whitespace-nowrap">
                    <button
                      type="button"
                      class="btn-edit-category text-ink-muted hover:text-accent font-medium motion-safe:transition-colors"
                      data-category={JSON.stringify(cat)}
                    >
                      Editar
                    </button>
                    <button
                      type="button"
                      class="btn-delete-category font-medium"
                      class:list={[
                        hasRefs ? 'text-ink-muted/40 cursor-not-allowed' : 'text-danger hover:underline',
                      ]}
                      disabled={hasRefs}
                      title={
                        hasRefs
                          ? `Possui ${cat.productCount} produto(s) e ${cat.workCount} trabalho(s) vinculados`
                          : 'Excluir categoria vazia'
                      }
                      data-id={cat.id}
                      data-title={cat.title}
                    >
                      Excluir
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Category Modal Form -->
    <div id="category-modal" class="fixed inset-0 z-[60] bg-scrim/60 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-surface border border-line rounded-2xl w-full max-w-2xl p-6 shadow-2xl relative max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-line">
          <h2 id="modal-title" class="text-lg font-semibold text-ink">Nova Categoria</h2>
          <button id="btn-close-modal" type="button" class="text-ink-muted hover:text-ink p-1 text-xl leading-none">&times;</button>
        </div>

        <form id="category-form" class="mt-5 space-y-4 text-xs">
          <input type="hidden" id="form-category-id" name="id" />
          <p id="form-error-msg" role="alert" class="hidden rounded-lg border border-danger/40 bg-danger/10 px-3.5 py-2.5 text-danger font-medium"></p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label for="form-title" class="block text-ink-muted mb-1 font-medium">Nome / Título da Categoria *</label>
              <input
                type="text"
                id="form-title"
                name="title"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="Ex: Brindes Corporativos"
              />
            </div>

            <div>
              <label for="form-order" class="block text-ink-muted mb-1 font-medium">Ordem de Apresentação</label>
              <input
                type="number"
                id="form-order"
                name="displayOrder"
                value="1"
                min="0"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink focus:border-accent"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-slug" class="block text-ink-muted mb-1 font-medium">Slug Público (URL) *</label>
              <input
                type="text"
                id="form-slug"
                name="slug"
                required
                pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent font-mono"
                placeholder="ex: brindes-corporativos"
              />
              <p class="mt-1 text-[10px] text-ink-muted">
                Ao alterar um slug existente, o endereço antigo fica salvo no histórico e os produtos permanecem vinculados.
              </p>
            </div>

            <div>
              <label for="form-subtitle" class="block text-ink-muted mb-1 font-medium">Subtítulo Editorial (Kicker)</label>
              <input
                type="text"
                id="form-subtitle"
                name="subtitle"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="Ex: Presentes Executivos & Eventos"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-badge" class="block text-ink-muted mb-1 font-medium">Selo / Badge da Linha</label>
              <input
                type="text"
                id="form-badge"
                name="badge"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="Ex: Edição Sob Medida"
              />
            </div>

            <div>
              <label for="form-cover-url" class="block text-ink-muted mb-1 font-medium">Imagem de Capa (opcional)</label>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  id="form-cover-url"
                  name="coverImageUrl"
                  class="min-w-0 flex-1 px-3 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                  placeholder="/uploads/... ou /images/..."
                />
                <label class="cursor-pointer px-3 py-2.5 rounded-lg bg-surface-raised hover:bg-surface-hover text-ink-secondary font-semibold">
                  <span>Upload</span>
                  <input type="file" id="form-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" />
                </label>
              </div>
              <p id="upload-status" role="status" class="text-[11px] text-accent mt-1 hidden"></p>
            </div>
          </div>

          <div>
            <label for="form-description" class="block text-ink-muted mb-1 font-medium">Descrição da Categoria</label>
            <textarea
              id="form-description"
              name="description"
              rows="2"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Texto de apresentação exibido no cabeçalho da seção e na página da coleção..."
            ></textarea>
          </div>

          <!-- Publicação e visibilidade -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="flex items-start gap-2.5 rounded-lg border border-control bg-canvas p-3 cursor-pointer">
              <input
                type="checkbox"
                id="form-active"
                name="isActive"
                checked
                class="mt-0.5 h-4 w-4 rounded border-control text-accent focus:ring-accent"
              />
              <div>
                <span class="block text-ink font-semibold">Categoria ativa / publicada</span>
                <span class="block text-[11px] text-ink-muted">Habilita a coleção pública e seus produtos no catálogo.</span>
              </div>
            </label>

            <label class="flex items-start gap-2.5 rounded-lg border border-control bg-canvas p-3 cursor-pointer">
              <input
                type="checkbox"
                id="form-show-home"
                name="showOnHome"
                checked
                class="mt-0.5 h-4 w-4 rounded border-control text-accent focus:ring-accent"
              />
              <div>
                <span class="block text-ink font-semibold">Exibir seção na Home</span>
                <span class="block text-[11px] text-ink-muted">Mostra esta categoria como vitrine na página inicial.</span>
              </div>
            </label>
            <label class="flex items-start gap-2.5 rounded-lg border border-control bg-canvas p-3 cursor-pointer">
              <input
                type="checkbox"
                id="form-show-menu"
                name="showOnMenu"
                checked
                class="mt-0.5 h-4 w-4 rounded border-control text-accent focus:ring-accent"
              />
              <div>
                <span class="block text-ink font-semibold">Exibir no menu superior</span>
                <span class="block text-[11px] text-ink-muted">Inclui a categoria publicada no menu Produtos.</span>
              </div>
            </label>
          </div>

          <!-- Apresentação e Destinos -->
          <fieldset class="rounded-xl border border-line bg-canvas/60 p-4 space-y-4">
            <legend class="px-1.5 font-semibold text-ink">Apresentação na Home &amp; Comportamento de Destino</legend>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label for="form-layout-type" class="block text-ink-muted mb-1 font-medium">Layout na Home</label>
                <select
                  id="form-layout-type"
                  name="layoutType"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="carousel">Carrossel horizontal</option>
                  <option value="grid">Grade (4 colunas)</option>
                  <option value="banner">Banner em destaque</option>
                </select>
              </div>

              <div>
                <label for="form-dest-type" class="block text-ink-muted mb-1 font-medium">Destino da Categoria</label>
                <select
                  id="form-dest-type"
                  name="destinationType"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="collection">Coleção automática (/colecoes/[slug])</option>
                  <option value="internal_page">Página interna existente</option>
                </select>
              </div>

              <div id="wrap-dest-href">
                <label for="form-dest-href" class="block text-ink-muted mb-1 font-medium">Página interna da categoria</label>
                <select
                  id="form-dest-href"
                  name="destinationHref"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="">Automático pela coleção</option>
                  {INTERNAL_DESTINATIONS.map(dest => (
                    <option value={dest.href}>{dest.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-line/50">
              <div>
                <label for="form-default-action" class="block text-ink-muted mb-1 font-medium">Comportamento padrão dos produtos</label>
                <select
                  id="form-default-action"
                  name="defaultProductAction"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="quote">Solicitar orçamento (WhatsApp)</option>
                  <option value="customizer">Abrir personalizador</option>
                  <option value="details">Abrir página interna / detalhes</option>
                </select>
              </div>

              <div id="wrap-default-href">
                <label for="form-default-href" class="block text-ink-muted mb-1 font-medium">Personalizador / Rota padrão (opcional)</label>
                <select
                  id="form-default-href"
                  name="defaultProductHref"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="">Definido por produto / Nenhum</option>
                  {INTERNAL_DESTINATIONS.map(dest => (
                    <option value={dest.href} data-kind={dest.kind}>{dest.label}</option>
                  ))}
                </select>
              </div>
            </div>
          </fieldset>

          <div class="pt-4 border-t border-line flex items-center justify-end gap-3">
            <button
              type="button"
              id="btn-cancel-modal"
              class="px-4 py-2 rounded-lg border border-control text-ink-secondary hover:bg-surface-raised"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-save-category"
              class="px-6 py-2 rounded-lg bg-action hover:bg-action-hover text-on-action font-bold tracking-wide"
            >
              Salvar Categoria
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function slugify(value: string): string {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 64);
  }

  function initAdminCategories() {
    const modal = document.getElementById('category-modal');
    const openBtn = document.getElementById('btn-new-category');
    const closeBtn = document.getElementById('btn-close-modal');
    const cancelBtn = document.getElementById('btn-cancel-modal');
    const form = document.getElementById('category-form') as HTMLFormElement | null;
    const modalTitle = document.getElementById('modal-title');
    const errorMsg = document.getElementById('form-error-msg');
    const titleInput = document.getElementById('form-title') as HTMLInputElement | null;
    const slugInput = document.getElementById('form-slug') as HTMLInputElement | null;
    const idInput = document.getElementById('form-category-id') as HTMLInputElement | null;
    const destTypeSelect = document.getElementById('form-dest-type') as HTMLSelectElement | null;
    const destHrefSelect = document.getElementById('form-dest-href') as HTMLSelectElement | null;
    const wrapDestHref = document.getElementById('wrap-dest-href');
    const defaultActionSelect = document.getElementById('form-default-action') as HTMLSelectElement | null;
    const defaultHrefSelect = document.getElementById('form-default-href') as HTMLSelectElement | null;
    const wrapDefaultHref = document.getElementById('wrap-default-href');
    const fileInput = document.getElementById('form-file-input') as HTMLInputElement | null;
    const coverUrlInput = document.getElementById('form-cover-url') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status');

    let slugTouchedManually = false;

    titleInput?.addEventListener('input', () => {
      if (!slugTouchedManually && !idInput?.value && slugInput) {
        slugInput.value = slugify(titleInput.value);
      }
    });
    slugInput?.addEventListener('input', () => {
      slugTouchedManually = true;
    });

    function syncDestinationControls() {
      if (destTypeSelect && destHrefSelect && wrapDestHref) {
        const isInternal = destTypeSelect.value === 'internal_page';
        destHrefSelect.disabled = !isInternal;
        wrapDestHref.classList.toggle('opacity-50', !isInternal);
        if (!isInternal) destHrefSelect.value = '';
      }
      if (defaultActionSelect && defaultHrefSelect && wrapDefaultHref) {
        const act = defaultActionSelect.value;
        const needsHref = act === 'customizer' || act === 'details';
        defaultHrefSelect.disabled = !needsHref;
        wrapDefaultHref.classList.toggle('opacity-50', !needsHref);
        if (!needsHref) {
          defaultHrefSelect.value = '';
        } else {
          for (const opt of defaultHrefSelect.querySelectorAll('option')) {
            const kind = opt.getAttribute('data-kind');
            if (!kind) continue;
            opt.hidden = act === 'customizer' && kind !== 'customizer';
          }
        }
      }
    }

    destTypeSelect?.addEventListener('change', syncDestinationControls);
    defaultActionSelect?.addEventListener('change', syncDestinationControls);

    function openModal(isEdit = false) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalTitle) modalTitle.textContent = isEdit ? 'Editar Categoria' : 'Nova Categoria';
      if (errorMsg) {
        errorMsg.textContent = '';
        errorMsg.classList.add('hidden');
      }
      syncDestinationControls();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (form) form.reset();
      if (idInput) idInput.value = '';
      slugTouchedManually = false;
      if (uploadStatus) uploadStatus.classList.add('hidden');
      syncDestinationControls();
    }

    openBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    document.querySelectorAll('.btn-toggle-active').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const current = btn.getAttribute('data-current') === 'true';
        if (!id) return;
        const res = await fetch(`/admin/categorias/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toggleActive: !current }),
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.btn-toggle-home').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const current = btn.getAttribute('data-current') === 'true';
        if (!id) return;
        const res = await fetch(`/admin/categorias/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toggleShowOnHome: !current }),
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.btn-delete-category').forEach(btn => {
      btn.addEventListener('click', async () => {
        if ((btn as HTMLButtonElement).disabled) return;
        const id = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');
        if (!id || !confirm(`Confirma a exclusão permanente da categoria "${title}"?`)) return;
        const res = await fetch(`/admin/categorias/${id}`, { method: 'DELETE' });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          window.location.reload();
        } else {
          alert(data.error || 'Não foi possível excluir a categoria.');
        }
      });
    });

    document.querySelectorAll('.btn-edit-category').forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-category');
        if (!raw) return;
        const cat = JSON.parse(raw);

        slugTouchedManually = true;
        (document.getElementById('form-category-id') as HTMLInputElement).value = cat.id;
        (document.getElementById('form-title') as HTMLInputElement).value = cat.title;
        (document.getElementById('form-slug') as HTMLInputElement).value = cat.slug;
        (document.getElementById('form-subtitle') as HTMLInputElement).value = cat.subtitle || '';
        (document.getElementById('form-badge') as HTMLInputElement).value = cat.badge || '';
        (document.getElementById('form-description') as HTMLTextAreaElement).value = cat.description || '';
        (document.getElementById('form-cover-url') as HTMLInputElement).value = cat.coverImageUrl || '';
        (document.getElementById('form-order') as HTMLInputElement).value = String(cat.displayOrder ?? 1);
        (document.getElementById('form-active') as HTMLInputElement).checked = cat.isActive !== false;
        (document.getElementById('form-show-home') as HTMLInputElement).checked = cat.showOnHome !== false;
        (document.getElementById('form-show-menu') as HTMLInputElement).checked = cat.showOnMenu !== false;
        (document.getElementById('form-layout-type') as HTMLSelectElement).value = cat.layoutType || 'carousel';
        (document.getElementById('form-dest-type') as HTMLSelectElement).value = cat.destinationType || 'collection';
        (document.getElementById('form-default-action') as HTMLSelectElement).value = cat.defaultProductAction || 'quote';
        syncDestinationControls();
        if (cat.destinationType === 'internal_page') {
          (document.getElementById('form-dest-href') as HTMLSelectElement).value = cat.destinationHref || '';
        }
        (document.getElementById('form-default-href') as HTMLSelectElement).value = cat.defaultProductHref || '';

        openModal(true);
      });
    });

    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file || !uploadStatus) return;

      uploadStatus.textContent = 'Enviando imagem...';
      uploadStatus.classList.remove('hidden');

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success && coverUrlInput) {
          coverUrlInput.value = data.url;
          uploadStatus.textContent = 'Imagem enviada com sucesso!';
        } else {
          uploadStatus.textContent = data.error || 'Erro ao enviar imagem.';
        }
      } catch {
        uploadStatus.textContent = 'Erro de conexão no upload.';
      }
    });

    form?.addEventListener('submit', async e => {
      e.preventDefault();
      if (errorMsg) errorMsg.classList.add('hidden');

      const id = (document.getElementById('form-category-id') as HTMLInputElement).value;
      const payload = {
        title: (document.getElementById('form-title') as HTMLInputElement).value,
        slug: (document.getElementById('form-slug') as HTMLInputElement).value,
        subtitle: (document.getElementById('form-subtitle') as HTMLInputElement).value,
        badge: (document.getElementById('form-badge') as HTMLInputElement).value,
        description: (document.getElementById('form-description') as HTMLTextAreaElement).value,
        coverImageUrl: (document.getElementById('form-cover-url') as HTMLInputElement).value,
        displayOrder: Number((document.getElementById('form-order') as HTMLInputElement).value),
        isActive: (document.getElementById('form-active') as HTMLInputElement).checked,
        showOnHome: (document.getElementById('form-show-home') as HTMLInputElement).checked,
        showOnMenu: (document.getElementById('form-show-menu') as HTMLInputElement).checked,
        layoutType: (document.getElementById('form-layout-type') as HTMLSelectElement).value,
        destinationType: (document.getElementById('form-dest-type') as HTMLSelectElement).value,
        destinationHref: (document.getElementById('form-dest-href') as HTMLSelectElement).value,
        defaultProductAction: (document.getElementById('form-default-action') as HTMLSelectElement).value,
        defaultProductHref: (document.getElementById('form-default-href') as HTMLSelectElement).value,
      };

      const url = id ? `/admin/categorias/${id}` : '/admin/categorias/novo';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        closeModal();
        window.location.reload();
      } else if (errorMsg) {
        errorMsg.textContent = data.error || 'Erro ao salvar categoria.';
        errorMsg.classList.remove('hidden');
      }
    });
  }

  initAdminCategories();
</script>
