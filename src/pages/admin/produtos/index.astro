---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BrandMark from '../../../components/BrandMark.astro';
import { getAllCategories, listAdminProductsPaginated } from '../../../db/catalogRepository';
import { listAdminArtes } from '../../../db/artLibraryRepository';
import { INTERNAL_DESTINATIONS } from '../../../data/internalDestinations';

export const prerender = false;

const url = Astro.url;
const q = (url.searchParams.get('q') ?? '').trim();
const categoryFilter = (url.searchParams.get('category') ?? '').trim();
const rawStatus = url.searchParams.get('status') ?? 'all';
const statusFilter = rawStatus === 'active' || rawStatus === 'inactive' ? rawStatus : 'all';
const rawFeatured = url.searchParams.get('featured') ?? 'all';
const featuredFilter = rawFeatured === 'featured' || rawFeatured === 'regular' ? rawFeatured : 'all';
const rawPageSize = Number(url.searchParams.get('pageSize') || 10);
const pageSize = rawPageSize === 20 || rawPageSize === 50 ? rawPageSize : 10;
const requestedPage = Math.max(Number(url.searchParams.get('page') || 1), 1);

const [categories, paginated, availableArtes] = await Promise.all([
  getAllCategories(),
  listAdminProductsPaginated({
    q: q || undefined,
    categoryId: categoryFilter || undefined,
    status: statusFilter,
    featured: featuredFilter,
    page: requestedPage,
    pageSize,
  }),
  listAdminArtes({ status: 'published' }),
]);

const { items: products, total, page, totalPages } = paginated;
const startIdx = total === 0 ? 0 : (page - 1) * pageSize + 1;
const endIdx = Math.min(page * pageSize, total);
const arteById = new Map(availableArtes.map(art => [art.id, art]));

function buildPageUrl(targetPage: number): string {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (categoryFilter) params.set('category', categoryFilter);
  if (statusFilter !== 'all') params.set('status', statusFilter);
  if (featuredFilter !== 'all') params.set('featured', featuredFilter);
  if (pageSize !== 10) params.set('pageSize', String(pageSize));
  if (targetPage > 1) params.set('page', String(targetPage));
  const qs = params.toString();
  return qs ? `/admin/produtos?${qs}` : '/admin/produtos';
}

const actionLabels: Record<string, string> = {
  customizer: 'Personalizador',
  details: 'Página interna',
  quote: 'Orçamento WhatsApp',
};
---

<BaseLayout title="Produtos do Catálogo | Administração 678 Estudio" description="Administração paginada de produtos do catálogo 678 Estudio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-line">
      <div class="flex items-center gap-3">
        <BrandMark class="size-9" />
        <div>
          <a href="/admin" class="text-xs font-semibold text-accent hover:underline">← Painel Administrativo</a>
          <h1 class="text-2xl font-light text-ink tracking-wide mt-0.5">
            Gestão de <span class="font-normal text-accent">Produtos</span>
          </h1>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/admin/categorias"
          class="inline-flex min-h-10 items-center rounded-full border border-accent px-4 text-xs font-semibold text-accent hover:bg-accent/10"
        >
          Categorias
        </a>
        <a
          href="/admin/artes"
          class="inline-flex min-h-10 items-center rounded-full border border-control px-4 text-xs font-medium text-ink-secondary hover:border-ink-muted"
        >
          Biblioteca de Artes
        </a>
        <button
          id="btn-new-product"
          type="button"
          class="inline-flex min-h-10 items-center gap-2 px-5 py-2.5 rounded-full bg-action hover:bg-action-hover text-on-action text-xs font-semibold tracking-wider uppercase motion-safe:transition-all shadow-lg"
        >
          <span>+ Novo Produto</span>
        </button>
      </div>
    </div>

    <!-- Filter & Search Bar -->
    <form method="get" action="/admin/produtos" class="rounded-2xl border border-line bg-surface p-4 sm:p-5 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
        <div class="lg:col-span-2">
          <label for="filter-q" class="block text-xs font-medium text-ink-muted mb-1">Buscar no catálogo</label>
          <input
            id="filter-q"
            type="search"
            name="q"
            value={q}
            placeholder="Nome, subtítulo, descrição ou selo..."
            class="w-full min-h-10 px-3.5 py-2 rounded-lg bg-canvas border border-control text-xs text-ink placeholder:text-ink-muted focus:border-accent"
          />
        </div>

        <div>
          <label for="filter-category" class="block text-xs font-medium text-ink-muted mb-1">Categoria</label>
          <select
            id="filter-category"
            name="category"
            class="w-full min-h-10 px-3 py-2 rounded-lg bg-canvas border border-control text-xs text-ink focus:border-accent"
          >
            <option value="">Todas as categorias</option>
            {categories.map(cat => (
              <option value={cat.id} selected={categoryFilter === cat.id || categoryFilter === cat.slug}>
                {cat.title}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="filter-status" class="block text-xs font-medium text-ink-muted mb-1">Publicação</label>
          <select
            id="filter-status"
            name="status"
            class="w-full min-h-10 px-3 py-2 rounded-lg bg-canvas border border-control text-xs text-ink focus:border-accent"
          >
            <option value="all" selected={statusFilter === 'all'}>Todos</option>
            <option value="active" selected={statusFilter === 'active'}>Publicados</option>
            <option value="inactive" selected={statusFilter === 'inactive'}>Ocultos</option>
          </select>
        </div>

        <div>
          <label for="filter-featured" class="block text-xs font-medium text-ink-muted mb-1">Destaque Home</label>
          <select
            id="filter-featured"
            name="featured"
            class="w-full min-h-10 px-3 py-2 rounded-lg bg-canvas border border-control text-xs text-ink focus:border-accent"
          >
            <option value="all" selected={featuredFilter === 'all'}>Todos</option>
            <option value="featured" selected={featuredFilter === 'featured'}>Destaque na Home</option>
            <option value="regular" selected={featuredFilter === 'regular'}>Sem destaque</option>
          </select>
        </div>

        <div>
          <label for="filter-page-size" class="block text-xs font-medium text-ink-muted mb-1">Itens por página</label>
          <select
            id="filter-page-size"
            name="pageSize"
            class="w-full min-h-10 px-3 py-2 rounded-lg bg-canvas border border-control text-xs text-ink focus:border-accent"
          >
            <option value="10" selected={pageSize === 10}>10 por página</option>
            <option value="20" selected={pageSize === 20}>20 por página</option>
            <option value="50" selected={pageSize === 50}>50 por página</option>
          </select>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-line/60">
        <p class="text-xs text-ink-muted">
          {total === 0
            ? 'Nenhum produto encontrado com os filtros atuais.'
            : `Exibindo ${startIdx}–${endIdx} de ${total} produto(s)`}
        </p>
        <div class="flex items-center gap-2">
          {(q || categoryFilter || statusFilter !== 'all' || featuredFilter !== 'all') && (
            <a
              href="/admin/produtos"
              class="inline-flex min-h-9 items-center px-3 rounded-lg border border-control text-xs text-ink-secondary hover:bg-surface-raised"
            >
              Limpar filtros
            </a>
          )}
          <button
            type="submit"
            class="inline-flex min-h-9 items-center px-4 rounded-lg bg-action hover:bg-action-hover text-on-action text-xs font-semibold"
          >
            Filtrar
          </button>
        </div>
      </div>
    </form>

    <!-- Product Table -->
    <div class="rounded-2xl border border-line bg-surface overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-canvas/80 text-[11px] uppercase tracking-wider text-ink-muted border-b border-line">
              <th class="px-5 py-3.5 font-medium">Imagem</th>
              <th class="px-5 py-3.5 font-medium">Produto &amp; Destino</th>
              <th class="px-5 py-3.5 font-medium">Categoria</th>
              <th class="px-5 py-3.5 font-medium text-center">Ordem</th>
              <th class="px-5 py-3.5 font-medium text-center">Home</th>
              <th class="px-5 py-3.5 font-medium text-center">Status</th>
              <th class="px-5 py-3.5 font-medium text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line/60">
            {products.length === 0 && (
              <tr>
                <td colspan="7" class="px-6 py-10 text-center text-ink-muted">
                  Nenhum produto encontrado para os critérios selecionados.
                </td>
              </tr>
            )}
            {products.map(prod => (
              <tr class="hover:bg-surface-muted/40 motion-safe:transition-colors">
                <td class="px-5 py-3.5">
                  <img
                    src={prod.imageUrl}
                    alt={prod.name}
                    class="w-12 h-12 object-cover rounded-lg border border-line bg-canvas"
                  />
                </td>
                <td class="px-5 py-3.5 max-w-sm">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <p class="font-semibold text-ink text-sm">{prod.name}</p>
                    {prod.featuredBadge && (
                      <span class="px-2 py-0.5 rounded text-[10px] bg-surface-raised text-ink-secondary border border-line">
                        {prod.featuredBadge}
                      </span>
                    )}
                  </div>
                  <p class="text-[11px] text-ink-muted truncate mt-0.5">{prod.tagline}</p>
                  <div class="flex flex-wrap items-center gap-2 mt-1">
                    {prod.linkedArteId && arteById.get(prod.linkedArteId) && (
                      <span class="text-[10px] text-accent font-medium">
                        Arte: [{arteById.get(prod.linkedArteId)!.code}] {arteById.get(prod.linkedArteId)!.title}
                      </span>
                    )}
                    {prod.actionType && (
                      <span class="text-[10px] text-ink-secondary bg-canvas px-2 py-0.5 rounded border border-line">
                        Destino: {actionLabels[prod.actionType] ?? prod.actionType}
                        {prod.actionHref ? ` (${prod.actionHref})` : ''}
                      </span>
                    )}
                  </div>
                </td>
                <td class="px-5 py-3.5">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-medium uppercase tracking-wider bg-surface-raised text-accent border border-accent/20">
                    {prod.categoryTitle ?? prod.categorySlug}
                  </span>
                </td>
                <td class="px-5 py-3.5 text-center font-semibold text-ink-secondary">
                  {prod.order}
                </td>
                <td class="px-5 py-3.5 text-center">
                  <button
                    type="button"
                    class="btn-toggle-featured px-2.5 py-1 rounded-full text-[10px] font-semibold tracking-wider uppercase motion-safe:transition-colors"
                    class:list={[
                      prod.isFeatured
                        ? 'bg-accent/15 text-accent border border-accent/40 hover:bg-accent/25'
                        : 'bg-surface-raised text-ink-muted border border-control hover:bg-surface-hover',
                    ]}
                    data-id={prod.id}
                    data-current={prod.isFeatured ? 'true' : 'false'}
                  >
                    {prod.isFeatured ? 'Destaque' : 'Normal'}
                  </button>
                </td>
                <td class="px-5 py-3.5 text-center">
                  <button
                    type="button"
                    class="btn-toggle-active px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase motion-safe:transition-colors"
                    class:list={[
                      prod.isActive
                        ? 'bg-success-surface text-success border border-success/30 hover:bg-success-hover'
                        : 'bg-surface-raised text-ink-muted border border-control hover:bg-surface-hover',
                    ]}
                    data-id={prod.id}
                    data-current={prod.isActive ? 'true' : 'false'}
                  >
                    {prod.isActive ? 'Publicado' : 'Oculto'}
                  </button>
                </td>
                <td class="px-5 py-3.5 text-right space-x-2 whitespace-nowrap">
                  <button
                    type="button"
                    class="btn-edit-product text-ink-muted hover:text-accent font-medium motion-safe:transition-colors"
                    data-product={JSON.stringify(prod)}
                  >
                    Editar
                  </button>
                  <button
                    type="button"
                    class="btn-delete-product text-danger hover:underline font-medium"
                    data-id={prod.id}
                    data-name={prod.name}
                  >
                    Excluir
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      {totalPages > 1 && (
        <nav
          aria-label="Paginação de produtos"
          class="px-5 py-4 border-t border-line bg-canvas/50 flex flex-wrap items-center justify-between gap-3 text-xs"
        >
          <span class="text-ink-muted">
            Página <strong class="text-ink">{page}</strong> de <strong class="text-ink">{totalPages}</strong>
          </span>
          <div class="flex items-center gap-2">
            {page > 1 ? (
              <a
                href={buildPageUrl(page - 1)}
                class="inline-flex min-h-9 items-center px-3.5 rounded-lg border border-control text-ink hover:border-accent"
              >
                ← Anterior
              </a>
            ) : (
              <span class="inline-flex min-h-9 items-center px-3.5 rounded-lg border border-line text-ink-muted opacity-50">
                ← Anterior
              </span>
            )}
            {page < totalPages ? (
              <a
                href={buildPageUrl(page + 1)}
                class="inline-flex min-h-9 items-center px-3.5 rounded-lg border border-control text-ink hover:border-accent"
              >
                Próxima →
              </a>
            ) : (
              <span class="inline-flex min-h-9 items-center px-3.5 rounded-lg border border-line text-ink-muted opacity-50">
                Próxima →
              </span>
            )}
          </div>
        </nav>
      )}
    </div>

    <!-- Product Modal Form -->
    <div id="product-modal" class="fixed inset-0 z-[60] bg-scrim/60 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-surface border border-line rounded-2xl w-full max-w-2xl p-6 shadow-2xl relative max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-4 border-b border-line">
          <h2 id="modal-title" class="text-lg font-semibold text-ink">Novo Produto</h2>
          <button id="btn-close-modal" type="button" class="text-ink-muted hover:text-ink p-1 text-xl leading-none">&times;</button>
        </div>

        <form id="product-form" class="mt-5 space-y-4 text-xs">
          <input type="hidden" id="form-product-id" name="id" />
          <p id="form-error-msg" role="alert" class="hidden rounded-lg border border-danger/40 bg-danger/10 px-3.5 py-2.5 text-danger font-medium"></p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label for="form-name" class="block text-ink-muted mb-1 font-medium">Nome do Produto *</label>
              <input
                type="text"
                id="form-name"
                name="name"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="Ex: Quadro Minimalista Ouro"
              />
            </div>

            <div>
              <label for="form-order" class="block text-ink-muted mb-1 font-medium">Ordem de Exibição</label>
              <input
                type="number"
                id="form-order"
                name="order"
                value="1"
                min="1"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink focus:border-accent"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="form-category" class="block text-ink-muted mb-1 font-medium">Categoria *</label>
              <select
                id="form-category"
                name="categoryId"
                required
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink focus:border-accent"
              >
                {categories.map(cat => (
                  <option value={cat.id} data-slug={cat.slug}>{cat.title}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="form-badge" class="block text-ink-muted mb-1 font-medium">Selo / Badge Especial (opcional)</label>
              <input
                type="text"
                id="form-badge"
                name="featuredBadge"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="Ex: Destaque, Mais Vendido, Exclusivo"
              />
            </div>
          </div>

          <div>
            <label for="form-tagline" class="block text-ink-muted mb-1 font-medium">Subtítulo Comercial (Tagline)</label>
            <input
              type="text"
              id="form-tagline"
              name="tagline"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Ex: Acabamento fosco aveludado e gravação HD"
            />
          </div>

          <div>
            <label for="form-description" class="block text-ink-muted mb-1 font-medium">Descrição Detalhada</label>
            <textarea
              id="form-description"
              name="description"
              rows="2"
              class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
              placeholder="Descreva materiais, acabamentos e especificações..."
            ></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
            <div class="flex flex-col gap-2">
              <label class="flex items-center gap-2.5 rounded-lg border border-control bg-canvas px-3.5 py-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  id="form-featured"
                  name="isFeatured"
                  class="h-4 w-4 rounded border-control text-accent focus:ring-accent"
                />
                <span class="text-ink font-medium">Destacar na Home (vitrine)</span>
              </label>
              <label class="flex items-center gap-2.5 rounded-lg border border-control bg-canvas px-3.5 py-2.5 cursor-pointer">
                <input
                  type="checkbox"
                  id="form-active"
                  name="isActive"
                  checked
                  class="h-4 w-4 rounded border-control text-accent focus:ring-accent"
                />
                <span class="text-ink font-medium">Produto publicado (visível)</span>
              </label>
            </div>

            <div>
              <label for="form-linked-arte" class="block text-ink-muted mb-1 font-medium">Arte vinculada (Biblioteca)</label>
              <select
                id="form-linked-arte"
                name="linkedArteId"
                class="w-full px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink focus:border-accent"
              >
                <option value="">Nenhuma (personalização livre)</option>
                {availableArtes.map(art => (
                  <option value={art.id} data-products={art.products.join(',')}>
                    [{art.code}] {art.title} ({art.products.join('/')})
                  </option>
                ))}
              </select>
            </div>
          </div>

          <!-- Destino Individual do Produto -->
          <fieldset class="rounded-xl border border-line bg-canvas/60 p-4 space-y-3">
            <legend class="px-1.5 font-semibold text-ink">Destino Individual do Produto (opcional)</legend>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div>
                <label for="form-action-type" class="block text-ink-muted mb-1 font-medium">Comportamento</label>
                <select
                  id="form-action-type"
                  name="actionType"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="">Herdar padrão da categoria</option>
                  <option value="customizer">Abrir personalizador</option>
                  <option value="details">Abrir página interna</option>
                  <option value="quote">Solicitar orçamento (WhatsApp)</option>
                </select>
              </div>

              <div id="wrap-action-href">
                <label for="form-action-href" class="block text-ink-muted mb-1 font-medium">Rota interna de destino</label>
                <select
                  id="form-action-href"
                  name="actionHref"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink focus:border-accent"
                >
                  <option value="">Selecione um destino...</option>
                  {INTERNAL_DESTINATIONS.map(dest => (
                    <option value={dest.href} data-kind={dest.kind}>{dest.label}</option>
                  ))}
                </select>
              </div>

              <div>
                <label for="form-cta-label" class="block text-ink-muted mb-1 font-medium">Texto do botão (opcional)</label>
                <input
                  type="text"
                  id="form-cta-label"
                  name="ctaLabel"
                  maxlength="60"
                  placeholder="Ex: Personalizar agenda"
                  class="w-full px-3 py-2 rounded-lg bg-surface border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                />
              </div>
            </div>
          </fieldset>

          <div>
            <label for="form-image-url" class="block text-ink-muted mb-1 font-medium">Imagem Comercial do Produto *</label>
            <div class="flex items-center gap-3">
              <input
                type="text"
                id="form-image-url"
                name="imageUrl"
                required
                class="min-w-0 flex-1 px-3.5 py-2.5 rounded-lg bg-canvas border border-control text-ink placeholder:text-ink-muted focus:border-accent"
                placeholder="/images/demo/... ou /uploads/..."
              />
              <label class="cursor-pointer px-4 py-2.5 rounded-lg bg-surface-raised hover:bg-surface-hover text-ink-secondary font-semibold motion-safe:transition-colors flex items-center gap-1.5">
                <span>Upload</span>
                <input type="file" id="form-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="sr-only" />
              </label>
            </div>
            <p id="upload-status" role="status" class="text-[11px] text-accent mt-1 hidden"></p>
          </div>

          <div class="pt-4 border-t border-line flex items-center justify-end gap-3">
            <button
              type="button"
              id="btn-cancel-modal"
              class="px-4 py-2 rounded-lg border border-control text-ink-secondary hover:bg-surface-raised"
            >
              Cancelar
            </button>
            <button
              type="submit"
              id="btn-save-product"
              class="px-6 py-2 rounded-lg bg-action hover:bg-action-hover text-on-action font-bold tracking-wide"
            >
              Salvar Produto
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initAdminProducts() {
    const modal = document.getElementById('product-modal');
    const openBtn = document.getElementById('btn-new-product');
    const closeBtn = document.getElementById('btn-close-modal');
    const cancelBtn = document.getElementById('btn-cancel-modal');
    const form = document.getElementById('product-form') as HTMLFormElement | null;
    const modalTitle = document.getElementById('modal-title');
    const errorMsg = document.getElementById('form-error-msg');
    const fileInput = document.getElementById('form-file-input') as HTMLInputElement | null;
    const imageUrlInput = document.getElementById('form-image-url') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status');
    const actionTypeSelect = document.getElementById('form-action-type') as HTMLSelectElement | null;
    const actionHrefSelect = document.getElementById('form-action-href') as HTMLSelectElement | null;
    const wrapActionHref = document.getElementById('wrap-action-href');

    function syncActionFields() {
      if (!actionTypeSelect || !actionHrefSelect || !wrapActionHref) return;
      const type = actionTypeSelect.value;
      const needsHref = type === 'customizer' || type === 'details';
      wrapActionHref.classList.toggle('opacity-50', !needsHref);
      actionHrefSelect.disabled = !needsHref;
      if (!needsHref) {
        actionHrefSelect.value = '';
      } else {
        for (const opt of actionHrefSelect.querySelectorAll('option')) {
          const kind = opt.getAttribute('data-kind');
          if (!kind) continue;
          opt.hidden = type === 'customizer' && kind !== 'customizer';
        }
      }
    }

    actionTypeSelect?.addEventListener('change', syncActionFields);

    function openModal(isEdit = false) {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (modalTitle) modalTitle.textContent = isEdit ? 'Editar Produto' : 'Novo Produto';
      if (errorMsg) {
        errorMsg.textContent = '';
        errorMsg.classList.add('hidden');
      }
      syncActionFields();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (form) form.reset();
      const idInput = document.getElementById('form-product-id') as HTMLInputElement | null;
      if (idInput) idInput.value = '';
      if (uploadStatus) uploadStatus.classList.add('hidden');
      syncActionFields();
    }

    openBtn?.addEventListener('click', () => openModal(false));
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    document.querySelectorAll('.btn-toggle-active').forEach(button => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-id');
        const current = button.getAttribute('data-current') === 'true';
        if (!id) return;
        const res = await fetch(`/api/products/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toggleActive: !current }),
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.btn-toggle-featured').forEach(button => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-id');
        const current = button.getAttribute('data-current') === 'true';
        if (!id) return;
        const res = await fetch(`/api/products/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toggleFeatured: !current }),
        });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.btn-delete-product').forEach(button => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        if (!id || !confirm(`Tem certeza que deseja excluir "${name}" permanentemente?`)) return;
        const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      });
    });

    document.querySelectorAll('.btn-edit-product').forEach(button => {
      button.addEventListener('click', () => {
        const dataStr = button.getAttribute('data-product');
        if (!dataStr) return;
        const prod = JSON.parse(dataStr);

        (document.getElementById('form-product-id') as HTMLInputElement).value = prod.id;
        (document.getElementById('form-name') as HTMLInputElement).value = prod.name;
        (document.getElementById('form-category') as HTMLSelectElement).value = prod.categoryId || prod.categorySlug;
        (document.getElementById('form-order') as HTMLInputElement).value = String(prod.order ?? 1);
        (document.getElementById('form-tagline') as HTMLInputElement).value = prod.tagline || '';
        (document.getElementById('form-description') as HTMLTextAreaElement).value = prod.description || '';
        (document.getElementById('form-badge') as HTMLInputElement).value = prod.featuredBadge || '';
        (document.getElementById('form-featured') as HTMLInputElement).checked = Boolean(prod.isFeatured);
        (document.getElementById('form-active') as HTMLInputElement).checked = prod.isActive !== false;
        (document.getElementById('form-linked-arte') as HTMLSelectElement).value = prod.linkedArteId || '';
        (document.getElementById('form-action-type') as HTMLSelectElement).value = prod.actionType || '';
        syncActionFields();
        (document.getElementById('form-action-href') as HTMLSelectElement).value = prod.actionHref || '';
        (document.getElementById('form-cta-label') as HTMLInputElement).value = prod.ctaLabel || '';
        (document.getElementById('form-image-url') as HTMLInputElement).value = prod.imageUrl;

        openModal(true);
      });
    });

    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file || !uploadStatus) return;

      uploadStatus.textContent = 'Enviando imagem...';
      uploadStatus.classList.remove('hidden');

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success && imageUrlInput) {
          imageUrlInput.value = data.url;
          uploadStatus.textContent = 'Imagem enviada com sucesso!';
        } else {
          uploadStatus.textContent = data.error || 'Erro ao enviar imagem.';
        }
      } catch {
        uploadStatus.textContent = 'Erro de conexão no upload.';
      }
    });

    form?.addEventListener('submit', async e => {
      e.preventDefault();
      if (errorMsg) errorMsg.classList.add('hidden');

      const id = (document.getElementById('form-product-id') as HTMLInputElement).value;
      const payload = {
        id: id || undefined,
        name: (document.getElementById('form-name') as HTMLInputElement).value,
        categoryId: (document.getElementById('form-category') as HTMLSelectElement).value,
        order: Number((document.getElementById('form-order') as HTMLInputElement).value),
        tagline: (document.getElementById('form-tagline') as HTMLInputElement).value,
        description: (document.getElementById('form-description') as HTMLTextAreaElement).value,
        featuredBadge: (document.getElementById('form-badge') as HTMLInputElement).value,
        isFeatured: (document.getElementById('form-featured') as HTMLInputElement).checked,
        isActive: (document.getElementById('form-active') as HTMLInputElement).checked,
        linkedArteId: (document.getElementById('form-linked-arte') as HTMLSelectElement).value || '',
        actionType: (document.getElementById('form-action-type') as HTMLSelectElement).value || '',
        actionHref: (document.getElementById('form-action-href') as HTMLSelectElement).value || '',
        ctaLabel: (document.getElementById('form-cta-label') as HTMLInputElement).value || '',
        imageUrl: (document.getElementById('form-image-url') as HTMLInputElement).value,
      };

      const url = id ? `/api/products/${id}` : '/api/products';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        closeModal();
        window.location.reload();
      } else if (errorMsg) {
        errorMsg.textContent = data.error || 'Erro ao salvar produto.';
        errorMsg.classList.remove('hidden');
      }
    });
  }

  initAdminProducts();
</script>
