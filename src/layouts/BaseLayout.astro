---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import themeBootstrap from '../scripts/theme.js?raw';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '678 Estudio | Quadros, canecas e presentes personalizados',
  description = 'Explore quadros decorativos, canecas, papelaria e peças em madeira personalizadas pelo 678 Estudio. Solicite seu orçamento pelo WhatsApp.'
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeBootstrap}></script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/brand/favicon-678-estudio.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-ink antialiased selection:bg-action selection:text-on-action">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:z-[60] focus:top-3 focus:left-3 focus:bg-action-hover focus:px-4 focus:py-2 focus:text-on-action">
      Ir para o conteúdo
    </a>
    <Header />
    <main id="conteudo" tabindex="-1" class="flex-1 min-w-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>

